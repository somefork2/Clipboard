        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere irgendetwas und es erscheint hier. ⌥⌘V holt es überall wieder hervor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia lo que sea y aparecerá aquí. Pulsa ⌥⌘V en cualquier sitio para recuperarlo."
