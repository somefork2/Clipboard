    "Cool blue-grey dark.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمادي مزرق بارد وداكن."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gris blavós fred i fosc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chladná modrošedá, tmavá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kølig blågrå og mørk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kühles Blaugrau, dunkel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ψυχρό γκρι-μπλε, σκούρο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cool blue-grey dark."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gris azulado frío y oscuro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viileä siniharmaa ja tumma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gris-bleu froid et sombre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפור-כחלחל קריר וכהה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ठंडा नीला-स्लेटी, गहरा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hladna plavosiva, tamna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hideg kékesszürke, sötét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Abu kebiruan yang sejuk dan gelap."
          }
        },
