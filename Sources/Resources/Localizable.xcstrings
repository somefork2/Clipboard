    "Favourites and clips on a pinboard are never removed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favourites and clips on a pinboard are never removed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten und Einträge auf einer Pinnwand werden nie entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los favoritos y los elementos de un tablero nunca se eliminan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris et les éléments épinglés ne sont jamais supprimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I preferiti e gli elementi su una bacheca non vengono mai rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りとボード上の項目が削除されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기와 보드에 있는 항목은 삭제되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorieten en items op een prikbord worden nooit verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulubione i wpisy na tablicy nigdy nie są usuwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoritos e itens em um quadro nunca são removidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избранное и записи на досках не удаляются никогда."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriter och objekt på en anslagstavla tas aldrig bort."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriler ve bir panodaki öğeler asla silinmez."
          }
        },
