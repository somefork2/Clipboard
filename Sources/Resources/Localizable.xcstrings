            "value": "Usa almeno uno fra ⌘, ⌥ e ⌃."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘、⌥、⌃のいずれかを必ず含めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘, ⌥, ⌃ 중 하나 이상을 사용하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik ten minste een van de toetsen ⌘, ⌥ of ⌃."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj przynajmniej jednego z klawiszy ⌘, ⌥ lub ⌃."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use pelo menos uma das teclas ⌘, ⌥ ou ⌃."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте хотя бы одну из клавиш ⌘, ⌥ или ⌃."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd minst en av ⌘, ⌥ och ⌃."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘, ⌥ veya ⌃ tuşlarından en az birini kullanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少使用 ⌘、⌥ 或 ⌃ 中的一个。"
          }
        }
      }
    },
