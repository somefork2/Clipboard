    "No network connection. Sync will resume when you are back online.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد اتصال بالشبكة. ستُستأنف المزامنة عند عودتك إلى الإنترنت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense connexió de xarxa. La sincronització continuarà quan tornis a estar en línia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není k dispozici síť. Synchronizace bude pokračovat, až budete zase online."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen netværksforbindelse. Synkroniseringen fortsætter, når du er online igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Netzwerkverbindung. Die Synchronisierung läuft weiter, sobald du wieder online bist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει σύνδεση δικτύου. Ο συγχρονισμός θα συνεχιστεί μόλις επανέλθετε στο διαδίκτυο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No network connection. Sync will resume when you are back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión de red. La sincronización continuará cuando vuelvas a estar en línea."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei verkkoyhteyttä. Synkronointi jatkuu, kun olet taas verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de connexion réseau. La synchronisation reprendra une fois en ligne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין חיבור לרשת. הסנכרון יימשך כשתחזרו להיות מחוברים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क नहीं है। ऑनलाइन लौटते ही सिंक फिर चालू हो जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema mrežne veze. Sinkronizacija će se nastaviti kad ponovno budete na mreži."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs hálózati kapcsolat. A szinkronizálás folytatódik, amint újra online lesz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada koneksi jaringan. Sinkronisasi akan berlanjut saat Anda daring kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna connessione di rete. La sincronizzazione riprenderà quando tornerai online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークに接続していません。オンラインに戻ると同期を再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크에 연결되어 있지 않습니다. 온라인 상태가 되면 동기화를 이어갑니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada sambungan rangkaian. Penyegerakan akan disambung semula apabila anda dalam talian semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen nettverkstilkobling. Synkroniseringen fortsetter når du er på nett igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen netwerkverbinding. De synchronisatie gaat verder zodra je weer online bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak połączenia z siecią. Synchronizacja wznowi się po powrocie do sieci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conexão de rede. A sincronização continua quando você voltar a ficar on-line."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ligação de rede. A sincronização continua assim que voltar a estar online."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără conexiune la rețea. Sincronizarea continuă când reveniți online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения к сети. Синхронизация продолжится, когда связь восстановится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie je k dispozícii sieť. Synchronizácia bude pokračovať, keď budete opäť online."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen nätverksanslutning. Synkroniseringen fortsätter när du är uppkopplad igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการเชื่อมต่อเครือข่าย การซิงค์จะดำเนินต่อเมื่อคุณกลับมาออนไลน์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ bağlantısı yok. Çevrimiçi olduğunuzda eşitleme sürer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає з’єднання з мережею. Синхронізація продовжиться, коли зв’язок відновиться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có kết nối mạng. Việc đồng bộ sẽ tiếp tục khi bạn trực tuyến trở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有网络连接。恢复联网后会继续同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有網路連線。恢復上線後會繼續同步。"
          }
        }
      }
    },
