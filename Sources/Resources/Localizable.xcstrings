    "Press ⌥⌘V anywhere, pick a clip, press ⌘V.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press ⌥⌘V anywhere, pick a clip, press ⌘V."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ⌥⌘V في أي مكان، اختر عنصرًا، ثم اضغط ⌘V."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiskněte kdekoli ⌥⌘V, vyberte položku, stiskněte ⌘V."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på ⌥⌘V hvor som helst, vælg et emne, tryk på ⌘V."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überall ⌥⌘V drücken, Eintrag wählen, ⌘V drücken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⌥⌘V en cualquier sitio, elige un elemento y pulsa ⌘V."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina ⌥⌘V missä tahansa, valitse kohde, paina ⌘V."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites ⌥⌘V n’importe où, choisissez un élément, faites ⌘V."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi ⌥⌘V ovunque, scegli un elemento, premi ⌘V."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこでも⌥⌘Vを押し、項目を選び、⌘Vを押します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서든 ⌥⌘V를 누르고, 항목을 고른 뒤 ⌘V를 누르세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk overal op ⌥⌘V, kies een item, druk op ⌘V."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk ⌥⌘V hvor som helst, velg et objekt, trykk ⌘V."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij ⌥⌘V w dowolnym miejscu, wybierz wpis, naciśnij ⌘V."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperte ⌥⌘V em qualquer lugar, escolha um item, aperte ⌘V."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ⌥⌘V где угодно, выберите запись, нажмите ⌘V."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck ⌥⌘V var som helst, välj ett objekt, tryck ⌘V."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nerede olursanız olun ⌥⌘V’ye basın, bir öğe seçin, ⌘V’ye basın."
          }
        },
        "uk": {
          "stringUnit": {
