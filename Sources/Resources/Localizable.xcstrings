    "CopyWell adds items to the right-click menu of every app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell adds items to the right-click menu of every app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell fügt dem Rechtsklick-Menü jeder App eigene Befehle hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell añade sus órdenes al menú contextual de todas las apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ajoute ses commandes au menu contextuel de toutes les apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell aggiunge i suoi comandi al menu contestuale di ogni app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellはすべてのAppの右クリックメニューに項目を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell은 모든 앱의 우클릭 메뉴에 항목을 추가합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell voegt zijn opdrachten toe aan het rechtsklikmenu van elke app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell dodaje swoje polecenia do menu podręcznego każdej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell adiciona comandos ao menu de contexto de todos os apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell добавляет свои команды в контекстное меню любой программы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell lägger till sina kommandon i högerklicksmenyn i alla program."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell her uygulamanın sağ tık menüsüne kendi komutlarını ekler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 会把自己的命令加入每个 App 的右键菜单。"
          }
        }
      }
    },
    "CopyWell does not have permission to use iCloud on this Mac.": {
      "extractionState": "manual",
