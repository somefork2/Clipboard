          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I gestori di password vengono rispettati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードマネージャを尊重します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호 관리자를 존중합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachtwoordbeheerders worden gerespecteerd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Passordprogrammer blir respektert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Menedżery haseł są respektowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os gerenciadores de senhas são respeitados."
          }
        },
        "ru": {
