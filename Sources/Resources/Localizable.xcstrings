    "This item is stored encrypted and is not shown in previews.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ هذا العنصر مشفرًا ولا يظهر في المعاينات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest element es desa xifrat i no es mostra a les previsualitzacions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato položka je uložena zašifrovaně a v náhledech se nezobrazuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette emne gemmes krypteret og vises ikke i eksempler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Eintrag ist verschlüsselt gespeichert und wird in Vorschauen nicht gezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το στοιχείο αποθηκεύεται κρυπτογραφημένο και δεν εμφανίζεται στις προεπισκοπήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item is stored encrypted and is not shown in previews."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este elemento se guarda cifrado y no se muestra en las vistas previas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kohde tallennetaan salattuna eikä sitä näytetä esikatseluissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément est conservé chiffré et n’apparaît pas dans les aperçus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריט הזה נשמר מוצפן ואינו מוצג בתצוגות מקדימות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह चीज़ एन्क्रिप्ट करके सहेजी गई है और झलक में नहीं दिखती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova se stavka sprema šifrirano i ne prikazuje se u pregledima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt az elemet titkosítva tároljuk, és nem jelenik meg az előnézetekben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item ini disimpan terenkripsi dan tidak ditampilkan di pratinjau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elemento è conservato cifrato e non compare nelle anteprime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目は暗号化して保存されており、プレビューには表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 암호화되어 저장되며 미리보기에는 표시되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Item ini disimpan tersulit dan tidak ditunjukkan dalam pratonton."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette objektet lagres kryptert og vises ikke i forhåndsvisninger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit item wordt versleuteld bewaard en is niet zichtbaar in voorvertoningen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten wpis jest przechowywany w postaci zaszyfrowanej i nie pojawia się w podglądzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item é guardado criptografado e não aparece nas pré-visualizações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item é guardado encriptado e não aparece nas pré-visualizações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest element este salvat criptat și nu apare în previzualizări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта запись хранится в зашифрованном виде и не показывается в просмотре."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto položka je uložená zašifrovane a v náhľadoch sa nezobrazuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här objektet sparas krypterat och visas inte i förhandsvisningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการนี้เก็บแบบเข้ารหัสและไม่แสดงในตัวอย่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğe şifreli saklanır ve önizlemelerde gösterilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей запис зберігається в зашифрованому вигляді й не показується в перегляді."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục này được lưu ở dạng mã hoá và không hiện khi xem trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此条目以加密方式存储，不在预览中显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此項目以加密方式儲存，不會在預覽中顯示。"
          }
        }
      }
    },
    "This permanently removes the clips and any images stored with them. It cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف هذا العناصر وأي صور محفوظة معها نهائيًا. ولا يمكن التراجع عنه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això elimina definitivament els elements i les imatges desades amb ells. No es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvale smaže položky i obrázky uložené spolu s nimi. Tuto akci nelze vzít zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det sletter emnerne og de billeder, der er gemt sammen med dem, permanent. Det kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit werden die Einträge und alle dazu gespeicherten Bilder endgültig entfernt. Das lässt sich nicht widerrufen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό διαγράφει οριστικά τα στοιχεία και τις εικόνες που φυλάσσονται μαζί τους. Δεν αναιρείται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes the clips and any images stored with them. It cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina de forma permanente los elementos y las imágenes guardadas con ellos. No se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa kohteet ja niiden mukana tallennetut kuvat pysyvästi. Sitä ei voi perua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement les éléments et les images conservées avec eux. C’est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מוחקת לצמיתות את הפריטים ואת התמונות שנשמרו איתם. לא ניתן לבטל אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे चीज़ें और उनके साथ सहेजी गई तस्वीरें हमेशा के लिए हट जाएँगी। इसे पलटा नहीं जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo trajno briše stavke i slike spremljene uz njih. Nije moguće poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez véglegesen törli az elemeket és a velük tárolt képeket. Nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapus permanen item beserta gambar yang tersimpan bersamanya. Tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove definitivamente gli elementi e le immagini conservate con essi. Non si può annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目と一緒に保存された画像を完全に削除します。取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목과 함께 저장된 이미지가 영구적으로 삭제됩니다. 되돌릴 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memadam item dan imej yang disimpan bersamanya secara kekal. Ia tidak boleh dibatalkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter objektene og bildene som er lagret sammen med dem, for godt. Det kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee verwijder je de items en de bewaarde afbeeldingen definitief. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwale usuwa wpisy i zapisane z nimi obrazy. Tego nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto remove permanentemente os itens e as imagens guardadas com eles. Não dá para desfazer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto remove permanentemente os itens e as imagens guardadas com eles. Não é possível anular."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta șterge definitiv elementele și imaginile salvate odată cu ele. Nu se poate anula."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи и сохранённые с ними изображения будут удалены безвозвратно. Отменить это нельзя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Natrvalo odstráni položky aj obrázky uložené s nimi. Nedá sa to vrátiť späť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här tar bort objekten och bilderna som sparats med dem permanent. Det går inte att ångra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทำเช่นนี้จะลบรายการและรูปภาพที่เก็บไว้ด้วยกันอย่างถาวร และเลิกทำไม่ได้"
