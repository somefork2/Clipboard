    "%lld days left in your trial — everything is unlocked.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بقي %lld يوماً من فترتك التجريبية — كل شيء متاح."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Queden %lld dies de prova: tot està desbloquejat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do konce zkušební verze zbývá %lld dní — vše je odemčeno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dage tilbage af prøveperioden — alt er låst op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch %lld Tage Testphase — alles ist freigeschaltet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απομένουν %lld ημέρες δοκιμής — όλα είναι ξεκλείδωτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld days left in your trial — everything is unlocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quedan %lld días de prueba: todo está desbloqueado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeilua jäljellä %lld päivää — kaikki on käytössä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reste %lld jours d’essai — tout est débloqué."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נותרו %lld ימים לתקופת הניסיון — הכול פתוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रायल के %lld दिन बाकी — सब कुछ खुला है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preostalo je %lld dana probnog razdoblja — sve je otključano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld nap van hátra a próbaidőszakból — minden elérhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Uji coba tersisa %lld hari — semuanya terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restano %lld giorni di prova — tutto è sbloccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体験期間は残り%lld日です。すべての機能が使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험 기간이 %lld일 남았습니다. 모든 기능을 쓸 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinggal %lld hari percubaan — semuanya terbuka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dager igjen av prøveperioden — alt er låst opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog %lld dagen proefperiode — alles is ontgrendeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do końca okresu próbnego pozostało %lld dni — wszystko jest odblokowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restam %lld dias de teste — tudo está liberado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltam %lld dias do período experimental — tudo está desbloqueado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Au mai rămas %lld zile de probă — totul este deblocat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До конца пробного периода %lld дней — доступно всё."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Do konca skúšobnej verzie zostáva %lld dní — všetko je odomknuté."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dagar kvar av testperioden — allt är upplåst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหลือเวลาทดลองใช้ %lld วัน — ใช้ได้ทุกอย่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme sürenizden %lld gün kaldı — her şey açık."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До кінця пробного періоду %lld днів — доступно все."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn %lld ngày dùng thử — mọi thứ đều được mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
