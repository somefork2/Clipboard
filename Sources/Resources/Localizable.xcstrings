          "stringUnit": {
            "state": "translated",
            "value": "푸른빛이 도는 차가운 회색 다크."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelabu kebiruan yang sejuk dan gelap."
          }
        },
