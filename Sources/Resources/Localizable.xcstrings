    "CopyWell is locked. Subscribe to carry on using it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell مُقفل. اشترك لمواصلة استخدامه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El CopyWell està bloquejat. Subscriu-t’hi per continuar fent-lo servir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell je zamčený. Pro další používání si pořiďte předplatné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell er låst. Tegn et abonnement for at fortsætte."
