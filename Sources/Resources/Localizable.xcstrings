    "CopyWell adds items to the right-click menu of every app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell adds items to the right-click menu of every app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell fügt dem Rechtsklick-Menü jeder App eigene Befehle hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell añade sus órdenes al menú contextual de todas las apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ajoute ses commandes au menu contextuel de toutes les apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell aggiunge i suoi comandi al menu contestuale di ogni app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellはすべてのAppの右クリックメニューに項目を追加します。"
          }
        }
      }
    },
    "CopyWell does not have permission to use iCloud on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell does not have permission to use iCloud on this Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell hat auf diesem Mac keine Berechtigung für iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell no tiene permiso para usar iCloud en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell n’a pas l’autorisation d’utiliser iCloud sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell non ha il permesso di usare iCloud su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでCopyWellにiCloudの使用許可がありません。"
          }
        }
      }
    },
    "CopyWell has nothing to paste.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell has nothing to paste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell hat nichts zum Einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell no tiene nada que pegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell n’a rien à coller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell non ha niente da incollare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellにペーストできるものがありません。"
          }
        }
      }
    },
    "CopyWell keeps what you copy, so you can get it back later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell keeps what you copy, so you can get it back later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell bewahrt auf, was du kopierst – damit du später wieder herankommst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell guarda lo que copias para que puedas recuperarlo después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell conserve ce que vous copiez, pour que vous puissiez le retrouver ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell conserva ciò che copi, così puoi ritrovarlo più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellはコピーした内容を取っておくので、あとから取り出せます。"
          }
        }
      }
    },
    "CopyWell never presses keys for you, so it needs no Accessibility access.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell never presses keys for you, so it needs no Accessibility access."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell drückt keine Tasten für dich und braucht deshalb keinen Zugriff auf die Bedienungshilfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nunca pulsa teclas por ti, así que no necesita acceso a Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell n’appuie jamais sur les touches à votre place : aucun accès à l’Accessibilité n’est nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell non preme mai i tasti al posto tuo, quindi non ha bisogno dell’accesso ad Accessibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellが代わりにキーを押すことはないため、アクセシビリティ権限は必要ありません。"
          }
        }
      }
    },
    "CopyWell never presses keys for you, so it needs no Accessibility access. To insert a clip without pressing ⌘V, use Services ▸ Paste from CopyWell.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell never presses keys for you, so it needs no Accessibility access. To insert a clip without pressing ⌘V, use Services ▸ Paste from CopyWell."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell drückt keine Tasten für dich und braucht deshalb keinen Zugriff auf die Bedienungshilfen. Um einen Eintrag ohne ⌘V einzusetzen, nutze Dienste ▸ Aus CopyWell einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nunca pulsa teclas por ti, así que no necesita acceso a Accesibilidad. Para insertar un elemento sin pulsar ⌘V, usa Servicios ▸ Pegar desde CopyWell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell n’appuie jamais sur les touches à votre place : aucun accès à l’Accessibilité n’est nécessaire. Pour insérer un élément sans faire ⌘V, utilisez Services ▸ Coller depuis CopyWell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell non preme mai i tasti al posto tuo, quindi non ha bisogno dell’accesso ad Accessibilità. Per inserire un elemento senza premere ⌘V, usa Servizi ▸ Incolla da CopyWell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellが代わりにキーを押すことはないため、アクセシビリティ権限は必要ありません。⌘Vを押さずに項目を挿入するには、サービス ▸ CopyWellからペーストを使ってください。"
          }
        }
      }
    },
    "CopyWell only records while it is running. More themes, accent colours and text size are in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell only records while it is running. More themes, accent colours and text size are in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell zeichnet nur auf, solange es läuft. Weitere Designs, Akzentfarben und die Textgröße findest du in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell solo registra mientras está abierto. Hay más temas, colores de acento y el tamaño del texto en los ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell n’enregistre que lorsqu’il est ouvert. D’autres thèmes, couleurs d’accent et la taille du texte sont dans les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell registra solo mentre è in esecuzione. Altri temi, colori d’accento e la dimensione del testo sono nelle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellは起動中のみ記録します。テーマ、アクセントカラー、文字サイズは設定にあります。"
          }
        }
      }
    },
    "CopyWell syncs on launch, when you switch back to it, and a few seconds after you copy something. Images and items marked sensitive stay on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell syncs on launch, when you switch back to it, and a few seconds after you copy something. Images and items marked sensitive stay on this Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell synchronisiert beim Start, beim Zurückwechseln und einige Sekunden nach dem Kopieren. Bilder und als vertraulich markierte Einträge bleiben auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell sincroniza al abrirse, al volver a él y unos segundos después de copiar algo. Las imágenes y los elementos marcados como confidenciales se quedan en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell se synchronise au lancement, quand vous y revenez, et quelques secondes après une copie. Les images et les éléments marqués sensibles restent sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell si sincronizza all’avvio, quando ci torni e pochi secondi dopo una copia. Le immagini e gli elementi segnati come sensibili restano su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellは起動時、切り替えて戻ったとき、そしてコピーの数秒後に同期します。画像と取り扱い注意の項目はこのMacに残ります。"
          }
        }
      }
    },
    "Could not reach the App Store. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
