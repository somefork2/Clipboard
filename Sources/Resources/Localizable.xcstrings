    "See what you copy most and from which apps.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what you copy most and from which apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, was du am häufigsten kopierst und aus welchen Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira qué copias más y desde qué apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez ce que vous copiez le plus, et depuis quelles apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda cosa copi di più e da quali app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を、どのAppから多くコピーしているかがわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 가장 많이, 어떤 앱에서 복사하는지 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie wat je het meest kopieert en uit welke apps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, co kopiujesz najczęściej i z jakich programów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o que você mais copia e de quais apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите, что и откуда вы копируете чаще всего."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vad du kopierar mest och från vilka program."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En çok neyi ve hangi uygulamalardan kopyaladığınızı görün."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看看你最常拷贝什么，又是从哪些 App 拷来的。"
          }
        }
      }
    },
    "See what you copy most, which apps you copy from, and how your history grows over time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what you copy most, which apps you copy from, and how your history grows over time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, was du am häufigsten kopierst, aus welchen Apps es stammt und wie dein Verlauf wächst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira qué copias más, desde qué apps y cómo crece tu historial con el tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez ce que vous copiez le plus, depuis quelles apps, et comment votre historique évolue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda cosa copi di più, da quali app e come cresce la cronologia nel tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を多くコピーしているか、どのAppからか、履歴がどう増えてきたかがわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 가장 많이 복사하는지, 어떤 앱에서 복사하는지, 기록이 어떻게 늘어나는지 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie wat je het meest kopieert, uit welke apps, en hoe je geschiedenis in de loop van de tijd groeit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, co kopiujesz najczęściej, z jakich programów i jak rośnie Twoja historia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o que você mais copia, de quais apps e como seu histórico cresce com o tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите, что вы копируете чаще всего, из каких программ и как растёт ваша история."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vad du kopierar mest, vilka program det kommer från och hur historiken växer med tiden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En çok neyi kopyaladığınızı, hangi uygulamalardan geldiğini ve geçmişinizin zamanla nasıl büyüdüğünü görün."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看看你最常拷贝什么、从哪些 App 拷贝，以及历史记录如何随时间增长。"
          }
        }
      }
    },
    "Sensitive clips are never included in exports.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensitive clips are never included in exports."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertrauliche Einträge werden nie exportiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos confidenciales nunca se incluyen en las exportaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments sensibles ne sont jamais inclus dans les exports."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi sensibili non vengono mai inclusi nelle esportazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り扱い注意の項目が書き出しに含まれることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "민감 항목은 내보내기에 포함되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gevoelige items komen nooit in een export terecht."
