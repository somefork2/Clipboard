    "iCloud is busy. CopyWell will try again shortly.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud مشغول. سيحاول CopyWell مرة أخرى قريبًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iCloud està ocupat. El CopyWell ho tornarà a provar de seguida."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud je zaneprázdněný. CopyWell to za chvíli zkusí znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud er optaget. CopyWell prøver igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist ausgelastet. CopyWell versucht es gleich erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το iCloud είναι απασχολημένο. Το CopyWell θα δοκιμάσει ξανά σύντομα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is busy. CopyWell will try again shortly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud está ocupado. CopyWell lo intentará de nuevo en breve."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud on varattu. CopyWell yrittää pian uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est occupé. CopyWell réessaiera sous peu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud עסוק. CopyWell ינסה שוב בקרוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud व्यस्त है। CopyWell थोड़ी देर में फिर कोशिश करेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud je zauzet. CopyWell će uskoro pokušati ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iCloud foglalt. A CopyWell hamarosan újrapróbálkozik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sedang sibuk. CopyWell akan mencoba lagi sebentar lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
