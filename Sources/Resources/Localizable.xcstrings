    "Password managers are respected.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحترم برامج إدارة كلمات السر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es respecten els gestors de contrasenyes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Správci hesel jsou respektováni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgangskodeprogrammer bliver respekteret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwortmanager werden respektiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι διαχειριστές συνθηματικών γίνονται σεβαστοί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password managers are respected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se respetan los gestores de contraseñas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasanaohjelmia kunnioitetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les gestionnaires de mots de passe sont respectés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנהלי הסיסמאות מכובדים."
          }
