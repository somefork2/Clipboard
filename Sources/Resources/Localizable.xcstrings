    "Off after installation. Changing a sound plays it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off after installation. Changing a sound plays it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Installation aus. Beim Wechseln wird der Ton kurz abgespielt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado tras la instalación. Al cambiar de sonido, se escucha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé après l’installation. Changer de son le fait écouter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato dopo l’installazione. Cambiando suono lo ascolti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール直後はオフです。サウンドを変えると試聴できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치 직후에는 꺼져 있습니다. 사운드를 바꾸면 들어 볼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na de installatie uit. Bij het wisselen hoor je het geluid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po instalacji wyłączone. Zmiana dźwięku od razu go odtwarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado após a instalação. Ao trocar de som, ele é tocado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После установки выключено. При смене звук проигрывается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avstängt efter installationen. När du byter ljud spelas det upp."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulumdan sonra kapalıdır. Sesi değiştirdiğinizde çalınır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装后默认关闭。切换声音时会试听。"
          }
        }
      }
    },
    "Off by default. A utility that beeps every time you copy gets uninstalled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. A utility that beeps every time you copy gets uninstalled."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus. Ein Hilfsprogramm, das bei jedem Kopieren piept, fliegt schnell wieder runter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por omisión. Una utilidad que pita cada vez que copias acaba desinstalada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Un utilitaire qui bipe à chaque copie finit désinstallé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato di default. Un’utility che suona a ogni copia finisce disinstallata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定はオフです。コピーのたびに鳴るユーティリティは消されてしまいますから。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 꺼짐입니다. 복사할 때마다 소리 내는 유틸리티는 결국 삭제되니까요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard uit. Een hulpprogramma dat bij elke kopie piept, wordt verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie wyłączone. Narzędzie piszczące przy każdym kopiowaniu ląduje w koszu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por padrão. Um utilitário que apita a cada cópia acaba desinstalado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию выключено. Программу, которая пищит при каждом копировании, удаляют."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avstängt som standard. Ett program som piper varje gång du kopierar blir avinstallerat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak kapalı. Her kopyalamada öten bir araç silinip gider."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。每次拷贝都响一下的工具，最后都会被卸载。"
          }
        }
      }
    },
    "On the free plan CopyWell keeps the last 48 hours. Favourites and pinboards are never removed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the free plan CopyWell keeps the last 48 hours. Favourites and pinboards are never removed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Gratisversion bewahrt CopyWell die letzten 48 Stunden auf. Favoriten und Pinnwände werden nie entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el plan gratuito, CopyWell conserva las últimas 48 horas. Los favoritos y los tableros nunca se eliminan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec la formule gratuite, CopyWell conserve les 48 dernières heures. Les favoris et les tableaux ne sont jamais supprimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con il piano gratuito CopyWell conserva le ultime 48 ore. I preferiti e le bacheche non vengono mai rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料プランでは直近48時間を保持します。お気に入りとボードが削除されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 요금제에서는 최근 48시간을 보관합니다. 즐겨찾기와 보드는 삭제되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met het gratis abonnement bewaart CopyWell de laatste 48 uur. Favorieten en prikborden worden nooit verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W planie bezpłatnym CopyWell zachowuje ostatnie 48 godzin. Ulubione i tablice nigdy nie są usuwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No plano gratuito, o CopyWell guarda as últimas 48 horas. Favoritos e quadros nunca são removidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На бесплатном тарифе CopyWell хранит последние 48 часов. Избранное и доски не удаляются никогда."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I gratisversionen sparar CopyWell de senaste 48 timmarna. Favoriter och anslagstavlor tas aldrig bort."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz planda CopyWell son 48 saati saklar. Favoriler ve panolar asla silinmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在免费方案下，CopyWell 保留最近 48 小时。收藏和板永远不会被删除。"
          }
        }
      }
    },
    "On-device analysis tags clips by type, language and entities.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device analysis tags clips by type, language and entities."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Analyse auf dem Gerät versieht Einträge mit Typ, Sprache und erkannten Inhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis en el dispositivo etiqueta los elementos por tipo, idioma y datos reconocidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse sur l’appareil étiquette les éléments par type, langue et informations reconnues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi sul dispositivo etichetta gli elementi per tipo, lingua e dati riconosciuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内の解析で、項目に種類・言語・認識した情報のタグを付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 분석으로 항목에 종류, 언어, 인식된 정보를 태그로 붙입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse op het apparaat zelf voorziet items van labels voor soort, taal en herkende gegevens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza na urządzeniu oznacza wpisy według rodzaju, języka i rozpoznanych danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise no próprio dispositivo marca os itens por tipo, idioma e informações reconhecidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анализ прямо на устройстве отмечает записи по типу, языку и найденным данным."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Analys i datorn märker objekt efter typ, språk och det som känns igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıt üzerindeki çözümleme, öğeleri türüne, diline ve tanınan bilgilere göre etiketler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备本机分析会按类型、语言和识别到的信息为条目加标签。"
          }
        }
      }
    },
