    "Automatically remove clips older than a chosen age.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically remove clips older than a chosen age."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف تلقائيًا العناصر الأقدم من المدة التي تختارها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky maže položky starší než zvolená doba."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter automatisk emner, der er ældre end den periode, du vælger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt Einträge automatisch, sobald sie ein festgelegtes Alter erreichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina automáticamente los elementos que superen la antigüedad que elijas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa automaattisesti kohteet, jotka ovat valitsemaasi ikää vanhempia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime automatiquement les éléments au-delà de l’âge que vous choisissez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove automaticamente gli elementi più vecchi dell’età che scegli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定した期間を過ぎた項目を自動で削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지정한 기간이 지난 항목을 자동으로 삭제합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert items automatisch zodra ze ouder zijn dan de ingestelde termijn."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter automatisk objekter som er eldre enn tiden du velger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie usuwa wpisy starsze niż wybrany okres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove automaticamente os itens mais antigos que o prazo escolhido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет записи старше выбранного срока автоматически."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar automatiskt bort objekt som är äldre än den tid du väljer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğiniz süreden eski öğeleri otomatik olarak siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично вилучає записи, старші за вибраний строк."
          }
        },
        "zh-Hans": {
