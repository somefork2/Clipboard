    "Put the next queued item on the clipboard": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع العنصر التالي من الرصة في الحافظة"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Posa al porta-retalls l’element següent de la cua"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vložit do schránky další položku ze zásobníku"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg det næste emne i køen på udklipsholderen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nächsten Eintrag aus der Warteschlange in die Zwischenablage legen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοποθέτηση του επόμενου στοιχείου της σειράς στο πρόχειρο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the next queued item on the clipboard"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poner el siguiente elemento de la cola en el portapapeles"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita jonon seuraava kohde leikepöydälle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre l’élément suivant de la file dans le presse-papiers"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנחת הפריט הבא בתור על הלוח"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क़तार की अगली चीज़ को क्लिपबोर्ड पर रखें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavi sljedeću stavku iz reda u međuspremnik"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sor következő elemének a vágólapra helyezése"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan item antrean berikutnya di papan klip"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti negli appunti l’elemento successivo in coda"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューの次の項目をクリップボードに置く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기열의 다음 항목을 클립보드에 넣기"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan item seterusnya dalam baris pada papan keratan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg det neste objektet i køen på utklippstavlen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het volgende item uit de rij op het klembord zetten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umieść następny wpis z kolejki w schowku"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar o próximo item da fila na área de transferência"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar o próximo item da fila na área de transferência"
          }
        },
        "ro": {
