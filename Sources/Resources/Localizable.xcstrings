        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La paleta s’obre allà on és el cursor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Paleta se otevře u kurzoru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Paletten åbnes ved markøren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Palette öffnet sich an deinem Zeiger."
