    "CopyWell keeps what you copy, so you can get it back later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell keeps what you copy, so you can get it back later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell bewahrt auf, was du kopierst – damit du später wieder herankommst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell guarda lo que copias para que puedas recuperarlo después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell conserve ce que vous copiez, pour que vous puissiez le retrouver ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell conserva ciò che copi, così puoi ritrovarlo più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellはコピーした内容を取っておくので、あとから取り出せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell은 복사한 내용을 보관해 두어 나중에 다시 꺼낼 수 있게 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell bewaart wat je kopieert, zodat je het later terug kunt halen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell przechowuje to, co kopiujesz, żebyś mógł wrócić do tego później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell guarda o que você copia, para você recuperar depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell хранит всё скопированное, чтобы вы могли вернуться к нему позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell sparar det du kopierar, så att du kan hämta tillbaka det senare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell kopyaladıklarınızı saklar, sonra geri alabilesiniz diye."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 会留住你拷贝过的内容，方便你随后取回。"
          }
        }
      }
    },
    "CopyWell never presses keys for you, so it needs no Accessibility access.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell never presses keys for you, so it needs no Accessibility access."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell drückt keine Tasten für dich und braucht deshalb keinen Zugriff auf die Bedienungshilfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nunca pulsa teclas por ti, así que no necesita acceso a Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell n’appuie jamais sur les touches à votre place : aucun accès à l’Accessibilité n’est nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell non preme mai i tasti al posto tuo, quindi non ha bisogno dell’accesso ad Accessibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellが代わりにキーを押すことはないため、アクセシビリティ権限は必要ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell은 대신 키를 누르지 않으므로 손쉬운 사용 권한이 필요 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell drukt nooit toetsen voor je in en heeft dus geen toegang tot Toegankelijkheid nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nigdy nie naciska klawiszy za Ciebie, więc nie potrzebuje dostępu do Dostępności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell nunca aperta teclas por você, então não precisa de acesso à Acessibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell не нажимает клавиши за вас, поэтому доступ к Универсальному доступу не нужен."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell trycker aldrig på tangenter åt dig och behöver därför ingen tillgång till Tillgänglighet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell sizin yerinize tuşlara basmaz, bu yüzden Erişilebilirlik iznine gerek duymaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 从不替你按键，因此无需辅助功能权限。"
          }
        }
      }
    },
    "CopyWell never presses keys for you, so it needs no Accessibility access. To insert a clip without pressing ⌘V, use Services ▸ Paste from CopyWell.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell never presses keys for you, so it needs no Accessibility access. To insert a clip without pressing ⌘V, use Services ▸ Paste from CopyWell."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell drückt keine Tasten für dich und braucht deshalb keinen Zugriff auf die Bedienungshilfen. Um einen Eintrag ohne ⌘V einzusetzen, nutze Dienste ▸ Aus CopyWell einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nunca pulsa teclas por ti, así que no necesita acceso a Accesibilidad. Para insertar un elemento sin pulsar ⌘V, usa Servicios ▸ Pegar desde CopyWell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell n’appuie jamais sur les touches à votre place : aucun accès à l’Accessibilité n’est nécessaire. Pour insérer un élément sans faire ⌘V, utilisez Services ▸ Coller depuis CopyWell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell non preme mai i tasti al posto tuo, quindi non ha bisogno dell’accesso ad Accessibilità. Per inserire un elemento senza premere ⌘V, usa Servizi ▸ Incolla da CopyWell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellが代わりにキーを押すことはないため、アクセシビリティ権限は必要ありません。⌘Vを押さずに項目を挿入するには、サービス ▸ CopyWellからペーストを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell은 대신 키를 누르지 않으므로 손쉬운 사용 권한이 필요 없습니다. ⌘V를 누르지 않고 항목을 넣으려면 서비스 ▸ CopyWell에서 붙여넣기를 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell drukt nooit toetsen voor je in en heeft dus geen toegang tot Toegankelijkheid nodig. Wil je een item invoegen zonder ⌘V, gebruik dan Diensten ▸ Plak uit CopyWell."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nigdy nie naciska klawiszy za Ciebie, więc nie potrzebuje dostępu do Dostępności. Aby wstawić wpis bez ⌘V, użyj Usługi ▸ Wklej z CopyWell."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell nunca aperta teclas por você, então não precisa de acesso à Acessibilidade. Para inserir um item sem apertar ⌘V, use Serviços ▸ Colar do CopyWell."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell не нажимает клавиши за вас, поэтому доступ к Универсальному доступу не нужен. Чтобы вставить запись без ⌘V, используйте Службы ▸ Вставить из CopyWell."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell trycker aldrig på tangenter åt dig och behöver därför ingen tillgång till Tillgänglighet. Vill du infoga ett objekt utan ⌘V använder du Tjänster ▸ Klistra in från CopyWell."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell sizin yerinize tuşlara basmaz, bu yüzden Erişilebilirlik iznine gerek duymaz. ⌘V’ye basmadan öğe eklemek için Hizmetler ▸ CopyWell’den yapıştır seçeneğini kullanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 从不替你按键，因此无需辅助功能权限。若想不按 ⌘V 就插入条目，请用「服务 ▸ 从 CopyWell 粘贴」。"
          }
        }
      }
    },
    "CopyWell only records while it is running. More themes, accent colours and text size are in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell only records while it is running. More themes, accent colours and text size are in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell zeichnet nur auf, solange es läuft. Weitere Designs, Akzentfarben und die Textgröße findest du in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell solo registra mientras está abierto. Hay más temas, colores de acento y el tamaño del texto en los ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell n’enregistre que lorsqu’il est ouvert. D’autres thèmes, couleurs d’accent et la taille du texte sont dans les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell registra solo mentre è in esecuzione. Altri temi, colori d’accento e la dimensione del testo sono nelle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellは起動中のみ記録します。テーマ、アクセントカラー、文字サイズは設定にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell은 실행 중일 때만 기록합니다. 더 많은 테마와 강조 색상, 텍스트 크기는 설정에 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell bewaart alleen zolang het draait. Meer thema's, accentkleuren en de tekstgrootte vind je in de instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell zapisuje tylko wtedy, gdy działa. Więcej motywów, kolorów akcentu i wielkość tekstu znajdziesz w ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell só registra enquanto está aberto. Mais temas, cores de destaque e o tamanho do texto ficam nos ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell записывает, только пока запущен. Другие темы, цвета акцента и размер текста — в настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell sparar bara medan programmet är igång. Fler teman, dekorfärger och textstorlek finns i inställningarna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell yalnızca çalışırken kaydeder. Daha fazla tema, vurgu rengi ve metin boyutu ayarlardadır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 只在运行时记录。更多主题、强调色和文字大小都在设置里。"
          }
        }
      }
    },
    "CopyWell syncs on launch, when you switch back to it, and a few seconds after you copy something. Images and items marked sensitive stay on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell syncs on launch, when you switch back to it, and a few seconds after you copy something. Images and items marked sensitive stay on this Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell synchronisiert beim Start, beim Zurückwechseln und einige Sekunden nach dem Kopieren. Bilder und als vertraulich markierte Einträge bleiben auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell sincroniza al abrirse, al volver a él y unos segundos después de copiar algo. Las imágenes y los elementos marcados como confidenciales se quedan en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell se synchronise au lancement, quand vous y revenez, et quelques secondes après une copie. Les images et les éléments marqués sensibles restent sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell si sincronizza all’avvio, quando ci torni e pochi secondi dopo una copia. Le immagini e gli elementi segnati come sensibili restano su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellは起動時、切り替えて戻ったとき、そしてコピーの数秒後に同期します。画像と取り扱い注意の項目はこのMacに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell은 실행할 때, 다시 전환할 때, 그리고 복사 후 몇 초 뒤에 동기화합니다. 이미지와 민감으로 표시된 항목은 이 Mac에 남습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell synchroniseert bij het starten, als je terugschakelt en een paar seconden nadat je iets kopieert. Afbeeldingen en als gevoelig gemarkeerde items blijven op deze Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell synchronizuje przy starcie, po powrocie do programu i kilka sekund po skopiowaniu. Obrazy i wpisy oznaczone jako poufne zostają na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell sincroniza ao abrir, ao voltar para ele e alguns segundos depois de você copiar algo. Imagens e itens marcados como sensíveis ficam neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell синхронизируется при запуске, при возврате к программе и через несколько секунд после копирования. Изображения и записи, помеченные как конфиденциальные, остаются на этом Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell synkroniserar vid start, när du växlar tillbaka och några sekunder efter att du kopierat något. Bilder och objekt märkta som känsliga stannar på den här datorn."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell açılışta, ona geri döndüğünüzde ve bir şey kopyaladıktan birkaç saniye sonra eşitlenir. Görüntüler ve hassas işaretli öğeler bu Mac’te kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 会在启动时、切回时以及拷贝后几秒同步。图像和标为敏感的条目只留在这台 Mac 上。"
          }
        }
      }
    },
    "Could not reach the App Store. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach the App Store. Check your connection and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store ist nicht erreichbar. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido contactar con el App Store. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre l’App Store. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere l’App Store. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeに接続できませんでした。接続を確認してからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에 연결할 수 없습니다. 연결을 확인한 후 다시 시도하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De App Store is niet bereikbaar. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć z App Store. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar a App Store. Verifique sua conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с App Store. Проверьте подключение и повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att nå App Store. Kontrollera anslutningen och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store’a ulaşılamadı. Bağlantınızı denetleyip yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 App Store。请检查网络后重试。"
          }
        }
      }
    },
    "Could not read the clipboard history.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the clipboard history."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zwischenablageverlauf konnte nicht gelesen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer el historial del portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire l’historique du presse-papiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la cronologia degli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード履歴を読み込めませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 기록을 읽을 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De klembordgeschiedenis kon niet worden gelezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać historii schowka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o histórico da área de transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать историю буфера обмена."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att läsa urklippshistoriken."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pano geçmişi okunamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取剪贴板历史记录。"
          }
        }
      }
    },
    "Could not save the last change.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save the last change."
          }
        },
        "de": {
          "stringUnit": {
