    "With the Dock icon hidden, the menu bar item stays available so CopyWell is always reachable.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the Dock icon hidden, the menu bar item stays available so CopyWell is always reachable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Dock-Symbol bleibt der Eintrag in der Menüleiste erhalten, damit CopyWell immer erreichbar ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el icono del Dock oculto, el de la barra de menús sigue ahí para que CopyWell esté siempre a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans icône dans le Dock, l’élément de la barre des menus reste là pour que CopyWell soit toujours accessible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con l’icona del Dock nascosta, quella nella barra dei menu resta disponibile perché CopyWell sia sempre a portata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockアイコンを隠しても、メニューバーの項目は残るので、CopyWellにはいつでも手が届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 아이콘을 숨겨도 메뉴 막대 항목은 남아 있어 CopyWell에 언제든 접근할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ook met een verborgen Docksymbool blijft het menubalkonderdeel staan, zodat CopyWell altijd bereikbaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawet po ukryciu ikony w Docku pozycja na pasku menu zostaje, więc CopyWell jest zawsze pod ręką."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o ícone do Dock oculto, o item da barra de menus continua lá, então o CopyWell está sempre ao alcance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже со скрытым значком в Dock пункт в строке меню остаётся, так что CopyWell всегда под рукой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Även med symbolen i Dock dold finns menyraden kvar, så att CopyWell alltid går att nå."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock simgesi gizliyken menü çubuğundaki öğe yerinde kalır, böylece CopyWell hep elinizin altındadır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使隐藏了程序坞图标，菜单栏里的图标依然保留，CopyWell 随时都能打开。"
          }
        }
      }
    },
    "Your 30-day trial has ended. CopyWell keeps the last 48 hours of history.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your 30-day trial has ended. CopyWell keeps the last 48 hours of history."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine 30-tägige Testphase ist vorbei. CopyWell bewahrt die letzten 48 Stunden des Verlaufs auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba de 30 días ha terminado. CopyWell conserva las últimas 48 horas del historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre essai de 30 jours est terminé. CopyWell conserve les 48 dernières heures d’historique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua prova di 30 giorni è finita. CopyWell conserva le ultime 48 ore di cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30日間の無料期間が終了しました。CopyWellは直近48時間分の履歴を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30일 체험이 끝났습니다. CopyWell은 최근 48시간의 기록을 보관합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je proefperiode van 30 dagen is voorbij. CopyWell bewaart de laatste 48 uur van je geschiedenis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój 30-dniowy okres próbny dobiegł końca. CopyWell zachowuje ostatnie 48 godzin historii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu teste de 30 dias terminou. O CopyWell guarda as últimas 48 horas do histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш 30-дневный пробный период закончился. CopyWell хранит последние 48 часов истории."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din provperiod på 30 dagar är slut. CopyWell sparar de senaste 48 timmarnas historik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "30 günlük deneme süreniz sona erdi. CopyWell geçmişin son 48 saatini saklar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 30 天试用已结束。CopyWell 会保留最近 48 小时的历史记录。"
          }
        }
      }
    },
