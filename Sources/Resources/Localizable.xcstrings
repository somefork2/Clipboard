          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniserer historikken mellom Macene dine via din egen private iCloud-database."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizuje historię między Twoimi Makami przez Twoją prywatną bazę danych iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza o histórico entre seus Macs pelo seu banco de dados privado do iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
