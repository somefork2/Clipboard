    "The saved history could not be opened. This session is being kept in memory only.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved history could not be opened. This session is being kept in memory only."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gesicherte Verlauf konnte nicht geöffnet werden. Diese Sitzung wird nur im Arbeitsspeicher gehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir el historial guardado. Esta sesión se mantiene solo en memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique enregistré n’a pas pu être ouvert. Cette session est conservée en mémoire seulement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile aprire la cronologia salvata. Questa sessione resta solo in memoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された履歴を開けませんでした。このセッションはメモリ上にのみ保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 기록을 열 수 없습니다. 이번 사용 기록은 메모리에만 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bewaarde geschiedenis kon niet worden geopend. Deze sessie wordt alleen in het geheugen bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć zapisanej historii. Ta sesja jest przechowywana tylko w pamięci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o histórico salvo. Esta sessão está sendo mantida só na memória."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть сохранённую историю. Этот сеанс хранится только в памяти."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den sparade historiken kunde inte öppnas. Den här omgången hålls bara i minnet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı geçmiş açılamadı. Bu oturum yalnızca bellekte tutuluyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开已存储的历史记录。本次使用仅保存在内存中。"
          }
        }
      }
    },
