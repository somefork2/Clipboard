    "Right-click any clip and choose “Add to Paste Stack”, then paste them in order with ⌥⌘S.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر بالزر الأيمن على أي عنصر واختر «إضافة إلى رصة اللصق»، ثم الصقها بالترتيب باستخدام ⌥⌘S."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes clic dret en un element, tria «Afegeix a la pila d’enganxar» i després enganxa’ls en ordre amb ⌥⌘S."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikněte na položku pravým tlačítkem, vyberte „Přidat do zásobníku vkládání“ a pak je vkládejte po pořadí pomocí ⌥⌘S."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højreklik på et emne, vælg “Føj til indsætningsstakken”, og indsæt dem så i rækkefølge med ⌥⌘S."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechtsklick auf einen Eintrag, „Zum Einfügestapel hinzufügen“ wählen und alles der Reihe nach mit ⌥⌘S einfügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε δεξί κλικ σε ένα στοιχείο, επιλέξτε «Προσθήκη στη στοίβα επικόλλησης» και έπειτα επικολλήστε τα με τη σειρά με ⌥⌘S."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click any clip and choose “Add to Paste Stack”, then paste them in order with ⌥⌘S."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic derecho en un elemento, elige «Añadir a la pila de pegado» y pégalos en orden con ⌥⌘S."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikkaa kohdetta kakkospainikkeella, valitse ”Lisää liitäpinoon” ja liitä ne järjestyksessä näppäimillä ⌥⌘S."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un clic droit sur un élément, choisissez « Ajouter à la pile de collage », puis collez-les dans l’ordre avec ⌥⌘S."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחצו לחיצה ימנית על פריט, בחרו ״הוספה לערימת ההדבקה״, ואז הדביקו אותם לפי הסדר עם ⌥⌘S."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी चीज़ पर राइट-क्लिक करके “पेस्ट स्टैक में जोड़ें” चुनें, फिर ⌥⌘S से क्रम में पेस्ट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desnom tipkom kliknite stavku, odaberite „Dodaj u hrpu lijepljenja“, a zatim ih lijepite redom pomoću ⌥⌘S."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kattintson jobb gombbal egy elemre, válassza a „Hozzáadás a beillesztési sorhoz” lehetőséget, majd illessze be őket sorban a ⌥⌘S billentyűkkel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik kanan sebuah item, pilih “Tambahkan ke tumpukan tempel”, lalu tempel berurutan dengan ⌥⌘S."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic destro su un elemento, scegli «Aggiungi alla pila di incollaggio», poi incollali in ordine con ⌥⌘S."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目を右クリックして「ペーストスタックに追加」を選び、⌥⌘Sで順番にペーストします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 우클릭해 ‘붙여넣기 스택에 추가’를 선택한 다음, ⌥⌘S로 순서대로 붙여넣으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik kanan mana-mana item, pilih “Tambah ke timbunan tampal”, kemudian tampal mengikut urutan dengan ⌥⌘S."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyreklikk på et objekt, velg «Legg til i limstabelen», og lim dem så inn etter tur med ⌥⌘S."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik met de rechtermuisknop op een item, kies ‘Aan plakstapel toevoegen’ en plak ze op volgorde met ⌥⌘S."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij wpis prawym przyciskiem, wybierz „Dodaj do stosu wklejania”, a potem wklejaj po kolei przez ⌥⌘S."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito em um item, escolha “Adicionar à pilha de colagem” e cole na ordem com ⌥⌘S."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito num item, escolha “Adicionar à pilha de colagem” e cole-os por ordem com ⌥⌘S."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic dreapta pe un element, alegeți „Adaugă în teancul de lipire”, apoi lipiți-le în ordine cu ⌥⌘S."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на запись правой кнопкой, выберите «В стопку вставки», затем вставляйте по порядку через ⌥⌘S."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite na položku pravým tlačidlom, vyberte „Pridať do zásobníka vkladania“ a potom ich vkladajte po poradí pomocou ⌥⌘S."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högerklicka på ett objekt och välj ”Lägg till i klistra in-stacken”, klistra sedan in dem i ordning med ⌥⌘S."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกขวาที่รายการใดก็ได้แล้วเลือก “เพิ่มไปยังกองวาง” จากนั้นวางตามลำดับด้วย ⌥⌘S"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir öğeye sağ tıklayıp “Yapıştırma yığınına ekle” seçin, sonra ⌥⌘S ile sırayla yapıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть запис правою кнопкою, виберіть «Додати до стосу вставляння», а потім вставляйте по черзі через ⌥⌘S."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấp chuột phải vào một mục, chọn “Thêm vào ngăn dán”, rồi dán lần lượt bằng ⌥⌘S."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点按任一条目，选择「加入粘贴栈」，然后用 ⌥⌘S 按顺序粘贴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任一項目上按右鍵，選擇「加入貼上堆疊」，然後用 ⌥⌘S 依序貼上。"
          }
