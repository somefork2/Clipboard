    "Every clip you copy, kept for as long as you want it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل عنصر تنسخه، محفوظ ما دمت تريده."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada element que copies, guardat tant de temps com vulguis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá zkopírovaná položka, uchovaná tak dlouho, jak chcete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert emne, du kopierer, gemt så længe du vil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Eintrag, den du kopierst, bleibt so lange, wie du willst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε στοιχείο που αντιγράφετε, φυλαγμένο όσο θέλετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every clip you copy, kept for as long as you want it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada elemento que copias, guardado el tiempo que quieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen kopioimasi kohde, tallessa niin kauan kuin haluat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque élément que vous copiez, gardé aussi longtemps que vous voulez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל פריט שאתם מעתיקים, נשמר כל עוד תרצו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी कॉपी की हर चीज़, जब तक चाहें तब तक।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka stavka koju kopirate, sačuvana koliko god želite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden másolt elem, addig megőrizve, ameddig csak szeretné."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap item yang Anda salin, disimpan selama Anda mau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni elemento che copi, conservato finché vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしたものは、必要なだけずっと残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 모든 항목을, 원하는 만큼 오래."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap item yang anda salin, disimpan selama yang anda mahu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert objekt du kopierer, tatt vare på så lenge du vil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk item dat je kopieert, bewaard zolang je wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy skopiowany wpis, przechowywany tak długo, jak chcesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada item que você copia, guardado pelo tempo que quiser."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada item que copia, guardado o tempo que quiser."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare element pe care îl copiați, păstrat cât timp doriți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая скопированная запись — столько, сколько нужно вам."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá skopírovaná položka, uchovaná tak dlho, ako chcete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje objekt du kopierar, sparat så länge du vill."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกรายการที่คุณคัดลอก เก็บไว้นานเท่าที่คุณต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyaladığınız her öğe, istediğiniz sürece saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен скопійований запис — стільки, скільки потрібно вам."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi mục bạn sao chép, giữ lại bao lâu tuỳ bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你复制的每一条，想留多久就留多久。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你拷貝的每一則，想留多久就留多久。"
          }
        }
      }
    },
    "Everything in CopyWell, for as long as you subscribe.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما في CopyWell، ما دام اشتراكك سارياً."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot el CopyWell, mentre duri la teva subscripció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celý CopyWell, dokud trvá vaše předplatné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele CopyWell, så længe dit abonnement løber."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles in CopyWell, solange dein Abo läuft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλο το CopyWell, όσο διαρκεί η συνδρομή σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in CopyWell, for as long as you subscribe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo CopyWell, mientras dure tu suscripción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koko CopyWell, niin kauan kuin tilauksesi on voimassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout CopyWell, aussi longtemps que dure votre abonnement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל CopyWell, כל עוד המינוי שלכם בתוקף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक सदस्यता चले, पूरा CopyWell।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cijeli CopyWell, dok traje vaša pretplata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljes CopyWell, amíg az előfizetése tart."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh CopyWell, selama langganan Anda berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto CopyWell, finché dura il tuo abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellのすべてを、登録している間ずっと。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독하는 동안 CopyWell의 모든 기능을."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh CopyWell, selagi langganan anda berjalan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele CopyWell, så lenge abonnementet ditt varer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles van CopyWell, zolang je abonnement loopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cały CopyWell, dopóki trwa subskrypcja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o CopyWell, enquanto durar sua assinatura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o CopyWell, enquanto durar a sua subscrição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot CopyWell, cât timp durează abonamentul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь CopyWell, пока действует подписка."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Celý CopyWell, kým trvá vaše predplatné."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hela CopyWell, så länge din prenumeration gäller."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างใน CopyWell ตราบที่การสมัครสมาชิกยังอยู่"
