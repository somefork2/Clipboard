    "Right-click any clip and choose “Add to Paste Stack”, then paste them in order with ⌥⌘S.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click any clip and choose “Add to Paste Stack”, then paste them in order with ⌥⌘S."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechtsklick auf einen Eintrag, „Zum Einfügestapel hinzufügen“ wählen und alles der Reihe nach mit ⌥⌘S einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic derecho en un elemento, elige «Añadir a la pila de pegado» y pégalos en orden con ⌥⌘S."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un clic droit sur un élément, choisissez « Ajouter à la pile de collage », puis collez-les dans l’ordre avec ⌥⌘S."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic destro su un elemento, scegli «Aggiungi alla pila di incollaggio», poi incollali in ordine con ⌥⌘S."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目を右クリックして「ペーストスタックに追加」を選び、⌥⌘Sで順番にペーストします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 우클릭해 ‘붙여넣기 스택에 추가’를 선택한 다음, ⌥⌘S로 순서대로 붙여넣으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik met de rechtermuisknop op een item, kies ‘Aan plakstapel toevoegen’ en plak ze op volgorde met ⌥⌘S."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij wpis prawym przyciskiem, wybierz „Dodaj do stosu wklejania”, a potem wklejaj po kolei przez ⌥⌘S."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito em um item, escolha “Adicionar à pilha de colagem” e cole na ordem com ⌥⌘S."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на запись правой кнопкой, выберите «В стопку вставки», затем вставляйте по порядку через ⌥⌘S."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högerklicka på ett objekt och välj ”Lägg till i klistra in-stacken”, klistra sedan in dem i ordning med ⌥⌘S."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir öğeye sağ tıklayıp “Yapıştırma yığınına ekle” seçin, sonra ⌥⌘S ile sırayla yapıştırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点按任一条目，选择「加入粘贴栈」，然后用 ⌥⌘S 按顺序粘贴。"
          }
        }
      }
    },
