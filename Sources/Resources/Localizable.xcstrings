    "No active subscription was found for this Apple Account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No active subscription was found for this Apple Account."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على اشتراك ساري لحساب Apple هذا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tento účet Apple nebylo nalezeno žádné aktivní předplatné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet et aktivt abonnement til denne Apple-konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Apple-Account wurde kein aktives Abo gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ninguna suscripción activa para esta cuenta de Apple."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tälle Apple-tilille ei löytynyt voimassa olevaa tilausta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun abonnement actif n’a été trouvé pour ce compte Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun abbonamento attivo trovato per questo account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple アカウントで有効なサブスクリプションは見つかりませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple 계정에서 사용 중인 구독을 찾지 못했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen actief abonnement gevonden voor deze Apple Account."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen aktive abonnementer for denne Apple-kontoen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono aktywnej subskrypcji dla tego konta Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma assinatura ativa foi encontrada para esta conta Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого аккаунта Apple активная подписка не найдена."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen aktiv prenumeration hittades för det här Apple-kontot."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple Hesabı için etkin abonelik bulunamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цього облікового запису Apple активної передплати не знайдено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到此 Apple 账户的有效订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到此 Apple 帳號的有效訂閱。"
          }
