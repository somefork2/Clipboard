    "Copy anything and it appears here. Press ⌥⌘V anywhere to paste it back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy anything and it appears here. Press ⌥⌘V anywhere to paste it back."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere irgendetwas und es erscheint hier. ⌥⌘V holt es überall wieder hervor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia lo que sea y aparecerá aquí. Pulsa ⌥⌘V en cualquier sitio para recuperarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez n’importe quoi et cela apparaît ici. ⌥⌘V le ramène où que vous soyez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia qualsiasi cosa e comparirà qui. ⌥⌘V te la riporta ovunque tu sia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何かをコピーするとここに並びます。どこでも⌥⌘Vで呼び戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이든 복사하면 여기에 쌓입니다. 어디서든 ⌥⌘V로 다시 꺼내세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieer wat dan ook en het verschijnt hier. Met ⌥⌘V haal je het overal terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiuj cokolwiek, a pojawi się tutaj. ⌥⌘V przywoła to w dowolnym miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie qualquer coisa e ela aparece aqui. ⌥⌘V traz de volta, de onde você estiver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте что угодно — оно появится здесь. ⌥⌘V вернёт его в любом месте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiera vad som helst så dyker det upp här. ⌥⌘V hämtar tillbaka det var du än är."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neyi kopyalarsanız burada belirir. Nerede olursanız olun ⌥⌘V ile geri çağırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝任何内容都会出现在这里。在任意位置按 ⌥⌘V 即可取回。"
          }
        }
      }
    },
