          "stringUnit": {
            "state": "translated",
            "value": "Zařaďte několik položek za sebe a vkládejte je jednu po druhé."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt flere emner i kø, og indsæt dem et ad gangen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reihe mehrere Einträge auf und füge sie nacheinander ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλτε πολλά στοιχεία στη σειρά και επικολλήστε τα το ένα μετά το άλλο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queue several clips and paste them one after another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon varios elementos en cola y pégalos uno tras otro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita useampi kohde jonoon ja liitä ne peräkkäin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez plusieurs éléments en file et collez-les l’un après l’autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סדרו כמה פריטים בתור והדביקו אותם בזה אחר זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कई चीज़ों को क़तार में लगाएँ और एक के बाद एक पेस्ट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poredajte nekoliko stavki i lijepite ih jednu za drugom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítson sorba több elemet, és illessze be őket egymás után."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrekan beberapa item lalu tempel satu per satu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in coda più elementi e incollali uno dopo l’altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の項目を並べて、順番にペーストできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 항목을 모아 차례대로 붙여넣으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bariskan beberapa item dan tampal satu demi satu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett flere objekter i kø, og lim dem inn etter hverandre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet meerdere items op rij en plak ze na elkaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw kilka wpisów w kolejce i wklejaj je jeden po drugim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfileire vários itens e cole um depois do outro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponha vários itens em fila e cole-os um a seguir ao outro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puneți mai multe elemente la rând și lipiți-le unul după altul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соберите несколько записей и вставляйте их одну за другой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaraďte niekoľko položiek za sebou a vkladajte ich jednu po druhej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ flera objekt i kö och klistra in dem ett efter ett."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดคิวหลายรายการแล้ววางทีละอัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
