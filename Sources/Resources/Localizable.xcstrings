    "Rebind every global shortcut to whatever you prefer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind every global shortcut to whatever you prefer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد تعيين كل اختصار عام كما يناسبك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přiřaďte každé globální zkratce klávesy, které vám vyhovují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt hver global genvej til det, du foretrækker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belege jeden globalen Kurzbefehl so, wie es dir passt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reasigna cada atajo global a lo que prefieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määritä jokainen yleinen oikopolku haluamaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redéfinissez chaque raccourci global comme vous le souhaitez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riassegna ogni scorciatoia globale come preferisci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのグローバルショートカットを好きなキーに割り当て直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 전역 단축키를 원하는 대로 바꾸세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijs elke globale toetscombinatie toe zoals jij wilt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett hver globale snarvei til det du foretrekker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypisz każdy skrót globalny tak, jak Ci wygodnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefina cada atalho global do jeito que preferir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переназначьте любое глобальное сочетание клавиш как вам удобно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändra varje globalt kortkommando till det du föredrar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her genel kısayolu dilediğiniz tuşlara atayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перепризначте будь-яке глобальне сполучення клавіш так, як вам зручно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把每个全局快捷键都改成你习惯的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把每個全域快速鍵都改成你習慣的。"
          }
        }
      }
    },
    "Rebinding every shortcut is part of CopyWell Pro. The palette and pause shortcuts stay editable on the free plan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebinding every shortcut is part of CopyWell Pro. The palette and pause shortcuts stay editable on the free plan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة تعيين جميع الاختصارات جزء من CopyWell Pro. ويظل اختصارا اللوحة والإيقاف المؤقت قابلين للتعديل في الخطة المجانية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna všech zkratek patří do CopyWell Pro. Zkratky pro paletu a pauzu lze upravit i v bezplatném tarifu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At ændre alle genveje hører til CopyWell Pro. Genvejene til paletten og pausen kan stadig ændres i gratisversionen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Kurzbefehle neu zu belegen gehört zu CopyWell Pro. Die Kurzbefehle für Palette und Pause bleiben auch in der Gratisversion änderbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reasignar todos los atajos forma parte de CopyWell Pro. Los de la paleta y la pausa se pueden seguir editando en el plan gratuito."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikkien oikopolkujen uudelleenmäärittäminen kuuluu CopyWell Prohon. Paletin ja tauon oikopolkuja voi muokata myös ilmaisversiossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redéfinir tous les raccourcis fait partie de CopyWell Pro. Ceux de la palette et de la pause restent modifiables avec la formule gratuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riassegnare tutte le scorciatoie fa parte di CopyWell Pro. Quelle della palette e della pausa restano modificabili anche nel piano gratuito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのショートカットの割り当て変更はCopyWell Proの機能です。パレットと一時停止のショートカットは無料プランでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 단축키를 다시 지정하는 기능은 CopyWell Pro에 포함됩니다. 팔레트와 일시 정지 단축키는 무료 요금제에서도 바꿀 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle toetscombinaties opnieuw toewijzen hoort bij CopyWell Pro. Die voor het palet en de pauze blijven ook gratis aanpasbaar."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Å endre alle snarveiene hører til CopyWell Pro. Snarveiene for paletten og pausen kan endres også i gratisversjonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana wszystkich skrótów należy do CopyWell Pro. Skróty palety i wstrzymania pozostają edytowalne w planie bezpłatnym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefinir todos os atalhos faz parte do CopyWell Pro. Os atalhos da paleta e da pausa continuam editáveis no plano gratuito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переназначение всех сочетаний входит в CopyWell Pro. Сочетания для палитры и паузы можно менять и на бесплатном тарифе."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att ändra alla kortkommandon ingår i CopyWell Pro. Kommandona för paletten och pausen går att ändra även i gratisversionen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm kısayolları yeniden atamak CopyWell Pro’nun parçasıdır. Palet ve duraklatma kısayolları ücretsiz planda da değiştirilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перепризначення всіх сполучень входить до CopyWell Pro. Сполучення для палітри та паузи можна змінювати й на безкоштовному тарифі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重设全部快捷键属于 CopyWell Pro。面板和暂停这两个快捷键在免费方案下仍可修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重設全部快速鍵屬於 CopyWell Pro。面板和暫停這兩個快速鍵在免費方案下仍可修改。"
          }
        }
      }
    },
