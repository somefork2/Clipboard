    "Subscriptions renew automatically until cancelled.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتجدد الاشتراكات تلقائيًا حتى إلغائها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les subscripcions es renoven automàticament fins que es cancel·len."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předplatné se automaticky obnovuje, dokud ho nezrušíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementer fornyes automatisk, indtil de opsiges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos verlängern sich automatisch, bis sie gekündigt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι συνδρομές ανανεώνονται αυτόματα μέχρι να ακυρωθούν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions renew automatically until cancelled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones se renuevan automáticamente hasta que se cancelan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaukset uusiutuvat automaattisesti, kunnes ne perutaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements se renouvellent automatiquement jusqu’à leur résiliation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המינויים מתחדשים אוטומטית עד לביטולם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द करने तक सदस्यता अपने आप नवीनीकृत होती रहती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretplate se automatski obnavljaju dok se ne otkažu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előfizetések automatikusan megújulnak, amíg le nem mondják őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan diperpanjang otomatis sampai dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli abbonamenti si rinnovano automaticamente finché non vengono annullati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは、解約するまで自動更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독은 취소할 때까지 자동으로 갱신됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan diperbaharui secara automatik sehingga dibatalkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementer fornyes automatisk til de sies opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementen worden automatisch verlengd tot je ze opzegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcje odnawiają się automatycznie do czasu rezygnacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As assinaturas renovam automaticamente até serem canceladas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As subscrições renovam-se automaticamente até serem canceladas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonamentele se reînnoiesc automat până la anulare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписка продлевается автоматически, пока вы её не отмените."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predplatné sa automaticky obnovuje, kým ho nezrušíte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenumerationer förnyas automatiskt tills de sägs upp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสมัครสมาชิกจะต่ออายุอัตโนมัติจนกว่าจะยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelikler, iptal edilene dek otomatik olarak yenilenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передплата продовжується автоматично, доки ви її не скасуєте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói đăng ký tự động gia hạn cho tới khi bạn huỷ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅会自动续期，直到你取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱會自動續訂，直到你取消為止。"
          }
        }
      }
    },
