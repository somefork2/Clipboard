            "state": "translated",
            "value": "Log ind på iCloud i Systemindstillinger for at synkronisere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich in den Systemeinstellungen bei iCloud an, um zu synchronisieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε στο iCloud από τις Ρυθμίσεις συστήματος για να χρησιμοποιήσετε τον συγχρονισμό."
          }
        },
