    "With the Dock icon hidden, the menu bar item stays available so CopyWell is always reachable.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى مع إخفاء أيقونة Dock يبقى بند شريط القوائم موجودًا، فيظل CopyWell في متناولك دائمًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb la icona del Dock amagada, l’element de la barra de menús es manté perquè el CopyWell sigui sempre a l’abast."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "I se skrytou ikonou v Docku zůstává položka v řádku nabídek, takže CopyWell je vždy po ruce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Selv med symbolet i Dock skjult bliver menulinjens emne stående, så CopyWell altid er inden for rækkevidde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Dock-Symbol bleibt der Eintrag in der Menüleiste erhalten, damit CopyWell immer erreichbar ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακόμη και με κρυμμένο το εικονίδιο του Dock, το στοιχείο της γραμμής μενού παραμένει, ώστε το CopyWell να είναι πάντα προσιτό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the Dock icon hidden, the menu bar item stays available so CopyWell is always reachable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el icono del Dock oculto, el de la barra de menús sigue ahí para que CopyWell esté siempre a mano."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaikka Dock-kuvake on piilotettu, valikkorivin kohde säilyy, joten CopyWell on aina käden ulottuvilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans icône dans le Dock, l’élément de la barre des menus reste là pour que CopyWell soit toujours accessible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גם כשסמל ה-Dock מוסתר, הפריט בשורת התפריטים נשאר, כך ש-CopyWell תמיד בהישג יד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock का आइकन छिपा हो तब भी मेनू बार वाला बना रहता है, ताकि CopyWell हमेशा पहुँच में रहे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čak i sa skrivenom ikonom u Docku stavka u traci izbornika ostaje, pa je CopyWell uvijek nadohvat ruke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elrejtett Dock-ikon mellett is megmarad a menüsor eleme, így a CopyWell mindig elérhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meski ikon Dock disembunyikan, item di bar menu tetap ada sehingga CopyWell selalu terjangkau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con l’icona del Dock nascosta, quella nella barra dei menu resta disponibile perché CopyWell sia sempre a portata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockアイコンを隠しても、メニューバーの項目は残るので、CopyWellにはいつでも手が届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 아이콘을 숨겨도 메뉴 막대 항목은 남아 있어 CopyWell에 언제든 접근할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Walaupun ikon Dock disembunyikan, item bar menu kekal ada supaya CopyWell sentiasa dalam capaian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Selv med symbolet i Dock skjult blir menylinjeobjektet stående, så CopyWell alltid er innen rekkevidde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ook met een verborgen Docksymbool blijft het menubalkonderdeel staan, zodat CopyWell altijd bereikbaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawet po ukryciu ikony w Docku pozycja na pasku menu zostaje, więc CopyWell jest zawsze pod ręką."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o ícone do Dock oculto, o item da barra de menus continua lá, então o CopyWell está sempre ao alcance."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o ícone da Dock oculto, o item da barra de menus mantém-se, para que o CopyWell esteja sempre ao alcance."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiar și cu pictograma din Dock ascunsă, elementul din bara de meniu rămâne, așa că CopyWell este mereu la îndemână."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже со скрытым значком в Dock пункт в строке меню остаётся, так что CopyWell всегда под рукой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aj so skrytou ikonou v Docku zostáva položka v lište ponúk, takže CopyWell je vždy po ruke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Även med symbolen i Dock dold finns menyraden kvar, så att CopyWell alltid går att nå."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม้ซ่อนไอคอนใน Dock รายการในแถบเมนูก็ยังอยู่ ทำให้เรียก CopyWell ได้เสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
