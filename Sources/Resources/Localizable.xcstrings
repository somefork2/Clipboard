    "Favourites and clips on a pinboard are never removed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favourites and clips on a pinboard are never removed."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُحذف المفضلة ولا العناصر الموجودة على لوحة أبدًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oblíbené položky a položky na nástěnce se nikdy nemažou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoritter og emner på en opslagstavle bliver aldrig slettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten und Einträge auf einer Pinnwand werden nie entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los favoritos y los elementos de un tablero nunca se eliminan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suosikkeja ja taululla olevia kohteita ei poisteta koskaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris et les éléments épinglés ne sont jamais supprimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I preferiti e gli elementi su una bacheca non vengono mai rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りとボード上の項目が削除されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기와 보드에 있는 항목은 삭제되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorieten en items op een prikbord worden nooit verwijderd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoritter og objekter på en oppslagstavle slettes aldri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulubione i wpisy na tablicy nigdy nie są usuwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoritos e itens em um quadro nunca são removidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избранное и записи на досках не удаляются никогда."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriter och objekt på en anslagstavla tas aldrig bort."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriler ve bir panodaki öğeler asla silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обране та записи на дошках не вилучаються ніколи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏和板上的条目永远不会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "喜好項目和看板上的項目永遠不會被刪除。"
          }
        }
      }
    },
    "Floating palette at the cursor; pick a clip and press ⌘V": {
      "extractionState": "manual",
      "localizations": {
