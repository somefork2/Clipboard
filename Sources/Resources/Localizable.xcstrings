    "See what you copy most and from which apps.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what you copy most and from which apps."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطّلع على ما تنسخه أكثر ومن أي التطبيقات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podívejte se, co kopírujete nejčastěji a ze kterých aplikací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se, hvad du kopierer mest, og fra hvilke programmer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, was du am häufigsten kopierst und aus welchen Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira qué copias más y desde qué apps."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katso, mitä kopioit eniten ja mistä ohjelmista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez ce que vous copiez le plus, et depuis quelles apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda cosa copi di più e da quali app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を、どのAppから多くコピーしているかがわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 가장 많이, 어떤 앱에서 복사하는지 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie wat je het meest kopieert en uit welke apps."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hva du kopierer mest, og fra hvilke programmer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, co kopiujesz najczęściej i z jakich programów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o que você mais copia e de quais apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите, что и откуда вы копируете чаще всего."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vad du kopierar mest och från vilka program."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En çok neyi ve hangi uygulamalardan kopyaladığınızı görün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Подивіться, що й звідки ви копіюєте найчастіше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看看你最常拷贝什么，又是从哪些 App 拷来的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看看你最常拷貝什麼，又是從哪些 App 拷來的。"
          }
        }
      }
    },
    "See what you copy most, which apps you copy from, and how your history grows over time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what you copy most, which apps you copy from, and how your history grows over time."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطّلع على ما تنسخه أكثر، ومن أي التطبيقات، وكيف ينمو سجلك مع الوقت."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podívejte se, co kopírujete nejčastěji, ze kterých aplikací a jak vaše historie v čase roste."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se, hvad du kopierer mest, hvilke programmer det kommer fra, og hvordan din historik vokser med tiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, was du am häufigsten kopierst, aus welchen Apps es stammt und wie dein Verlauf wächst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira qué copias más, desde qué apps y cómo crece tu historial con el tiempo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katso, mitä kopioit eniten, mistä ohjelmista ja miten historiasi kasvaa ajan myötä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez ce que vous copiez le plus, depuis quelles apps, et comment votre historique évolue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda cosa copi di più, da quali app e come cresce la cronologia nel tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を多くコピーしているか、どのAppからか、履歴がどう増えてきたかがわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 가장 많이 복사하는지, 어떤 앱에서 복사하는지, 기록이 어떻게 늘어나는지 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie wat je het meest kopieert, uit welke apps, en hoe je geschiedenis in de loop van de tijd groeit."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hva du kopierer mest, hvilke programmer det kommer fra, og hvordan historikken vokser over tid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, co kopiujesz najczęściej, z jakich programów i jak rośnie Twoja historia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o que você mais copia, de quais apps e como seu histórico cresce com o tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите, что вы копируете чаще всего, из каких программ и как растёт ваша история."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vad du kopierar mest, vilka program det kommer från och hur historiken växer med tiden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En çok neyi kopyaladığınızı, hangi uygulamalardan geldiğini ve geçmişinizin zamanla nasıl büyüdüğünü görün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Подивіться, що ви копіюєте найчастіше, з яких програм і як зростає ваша історія."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看看你最常拷贝什么、从哪些 App 拷贝，以及历史记录如何随时间增长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看看你最常拷貝什麼、從哪些 App 拷貝，以及記錄如何隨時間成長。"
          }
        }
      }
    },
    "Sensitive clips are never included in exports.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensitive clips are never included in exports."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُدرج العناصر الحساسة في عمليات التصدير أبدًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Citlivé položky se do exportů nikdy nezahrnují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følsomme emner kommer aldrig med i eksporter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertrauliche Einträge werden nie exportiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos confidenciales nunca se incluyen en las exportaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkaluonteisia kohteita ei sisällytetä koskaan vienteihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments sensibles ne sont jamais inclus dans les exports."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi sensibili non vengono mai inclusi nelle esportazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り扱い注意の項目が書き出しに含まれることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "민감 항목은 내보내기에 포함되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gevoelige items komen nooit in een export terecht."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensitive objekter blir aldri med i eksporter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisy poufne nigdy nie trafiają do eksportu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens sensíveis nunca entram nas exportações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфиденциальные записи никогда не попадают в экспорт."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Känsliga objekt kommer aldrig med i exporter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hassas öğeler dışa aktarmalara asla dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфіденційні записи ніколи не потрапляють до експорту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感条目永远不会包含在导出内容中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感項目永遠不會包含在輸出內容中。"
          }
        }
      }
    },
