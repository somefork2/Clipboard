          "stringUnit": {
            "state": "translated",
            "value": "पासवर्ड मैनेजर का सम्मान किया जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravitelji lozinki se poštuju."
          }
