          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plovoucí paleta u kurzoru: vyberte položku a stiskněte ⌘V"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
