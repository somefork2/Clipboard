    "Never record anything that looks like a password": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never record anything that looks like a password"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحفظ أبدًا ما يبدو كأنه كلمة سر"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikdy neukládat nic, co vypadá jako heslo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem aldrig noget, der ligner en adgangskode"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie speichern, was wie ein Passwort aussieht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No guardar nunca nada que parezca una contraseña"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä koskaan tallenna mitään salasanalta näyttävää"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jamais enregistrer ce qui ressemble à un mot de passe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non registrare mai ciò che sembra una password"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードらしきものは記録しない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호로 보이는 항목은 절대 기록하지 않기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar nooit iets dat op een wachtwoord lijkt"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Aldri lagre noe som ser ut som et passord"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nigdy nie zapisuj niczego, co wygląda jak hasło"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca registrar nada que pareça uma senha"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не сохранять то, что похоже на пароль"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara aldrig något som ser ut som ett lösenord"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parolaya benzeyen hiçbir şeyi kaydetme"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніколи не зберігати те, що схоже на пароль"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绝不记录看起来像密码的内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "絕不記錄看起來像密碼的內容"
          }
        }
      }
    },
