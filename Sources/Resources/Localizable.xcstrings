    "No active subscription was found for this Apple Account.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على اشتراك ساري لحساب Apple هذا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha trobat cap subscripció activa per a aquest compte d’Apple."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tento účet Apple nebylo nalezeno žádné aktivní předplatné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet et aktivt abonnement til denne Apple-konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Apple-Account wurde kein aktives Abo gefunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκε ενεργή συνδρομή για αυτόν τον λογαριασμό Apple."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No active subscription was found for this Apple Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ninguna suscripción activa para esta cuenta de Apple."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tälle Apple-tilille ei löytynyt voimassa olevaa tilausta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun abonnement actif n’a été trouvé pour ce compte Apple."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצא מינוי פעיל לחשבון Apple הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Apple खाते के लिए कोई चालू सदस्यता नहीं मिली।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ovaj Apple račun nije pronađena aktivna pretplata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem található aktív előfizetés ehhez az Apple-fiókhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ditemukan langganan aktif untuk Akun Apple ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun abbonamento attivo trovato per questo account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple アカウントで有効なサブスクリプションは見つかりませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple 계정에서 사용 중인 구독을 찾지 못했습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada langganan aktif ditemui untuk Akaun Apple ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen aktive abonnementer for denne Apple-kontoen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen actief abonnement gevonden voor deze Apple Account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono aktywnej subskrypcji dla tego konta Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma assinatura ativa foi encontrada para esta conta Apple."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi encontrada nenhuma subscrição ativa para esta conta Apple."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a găsit niciun abonament activ pentru acest cont Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого аккаунта Apple активная подписка не найдена."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre tento účet Apple sa nenašlo žiadne aktívne predplatné."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen aktiv prenumeration hittades för det här Apple-kontot."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบการสมัครสมาชิกที่ใช้งานอยู่สำหรับบัญชี Apple นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple Hesabı için etkin abonelik bulunamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цього облікового запису Apple активної передплати не знайдено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy gói đăng ký đang hoạt động cho Tài khoản Apple này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
