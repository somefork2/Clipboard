    "macOS ships third-party menu items switched off. Turn them on once and they stay on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ships third-party menu items switched off. Turn them on once and they stay on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS liefert Menübefehle anderer Anbieter ausgeschaltet aus. Einmal einschalten genügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS trae desactivadas las órdenes de menú de terceros. Actívalas una vez y se quedan activas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS livre les commandes de menu tierces désactivées. Activez-les une fois, elles le restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS consegna disattivate le voci di menu di terze parti. Attivale una volta e restano attive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSでは他社製のメニュー項目は最初オフになっています。一度オンにすれば、そのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS는 서드파티 메뉴 항목을 꺼진 상태로 제공합니다. 한 번만 켜면 계속 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS levert menuonderdelen van derden uitgeschakeld. Eén keer inschakelen is genoeg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W macOS pozycje menu od innych producentów są domyślnie wyłączone. Włącz je raz, a zostaną włączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS vem com os itens de menu de terceiros desativados. Ative uma vez e eles continuam ativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В macOS пункты меню от сторонних разработчиков выключены. Включите их один раз — и они останутся включёнными."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS levererar menyalternativ från andra utvecklare avstängda. Slå på dem en gång så stannar de på."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, başka geliştiricilerin menü öğelerini kapalı getirir. Bir kez açın, açık kalsın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 默认关闭第三方菜单项。打开一次，之后就一直有效。"
          }
        }
      }
    },
