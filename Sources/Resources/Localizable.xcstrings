    "Password managers are respected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password managers are respected."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwortmanager werden respektiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se respetan los gestores de contraseñas."
          }
        },
