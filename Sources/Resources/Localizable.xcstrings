          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest wysyłane, dopóki sam nie włączysz synchronizacji z iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é enviado enquanto você mesmo não ativar a sincronização com o iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не выгружается, пока вы сами не включите синхронизацию с iCloud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
