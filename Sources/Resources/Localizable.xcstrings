    "CopyWell keeps what you copy, so you can get it back later.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ CopyWell بما تنسخه لتتمكن من استعادته لاحقًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El CopyWell desa el que copies perquè el puguis recuperar més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell uchovává to, co zkopírujete, abyste se k tomu mohli později vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell gemmer det, du kopierer, så du kan hente det frem igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell bewahrt auf, was du kopierst – damit du später wieder herankommst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το CopyWell κρατά ό,τι αντιγράφετε, για να το βρείτε ξανά αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell keeps what you copy, so you can get it back later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell guarda lo que copias para que puedas recuperarlo después."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell säilyttää kopioimasi, jotta saat sen myöhemmin takaisin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell conserve ce que vous copiez, pour que vous puissiez le retrouver ensuite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell שומר את מה שהעתקתם, כדי שתוכלו לחזור אליו אחר כך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell आपकी कॉपी की गई चीज़ें रख लेता है, ताकि आप बाद में उन्हें वापस पा सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell čuva ono što kopirate kako biste se poslije mogli vratiti na to."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A CopyWell megőrzi, amit másol, hogy később visszakaphassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell menyimpan apa yang Anda salin, supaya bisa Anda ambil lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell conserva ciò che copi, così puoi ritrovarlo più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellはコピーした内容を取っておくので、あとから取り出せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell은 복사한 내용을 보관해 두어 나중에 다시 꺼낼 수 있게 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell menyimpan apa yang anda salin, supaya anda boleh mendapatkannya semula kemudian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell tar vare på det du kopierer, så du kan hente det fram igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell bewaart wat je kopieert, zodat je het later terug kunt halen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell przechowuje to, co kopiujesz, żebyś mógł wrócić do tego później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell guarda o que você copia, para você recuperar depois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell guarda o que copia, para o poder recuperar mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell păstrează ce copiați, ca să puteți reveni mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell хранит всё скопированное, чтобы вы могли вернуться к нему позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell uchováva to, čo skopírujete, aby ste sa k tomu mohli neskôr vrátiť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell sparar det du kopierar, så att du kan hämta tillbaka det senare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell เก็บสิ่งที่คุณคัดลอกไว้ เพื่อให้คุณเรียกกลับมาได้ภายหลัง"
