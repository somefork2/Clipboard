        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell sizin yerinize tuşlara basmaz, bu yüzden Erişilebilirlik iznine gerek duymaz. ⌘V’ye basmadan öğe eklemek için Hizmetler ▸ CopyWell’den yapıştır seçeneğini kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell не натискає клавіші замість вас, тому доступ до Доступності не потрібен. Щоб вставити запис без ⌘V, скористайтеся Служби ▸ Вставити з CopyWell."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell không bao giờ bấm phím thay bạn, nên không cần quyền Trợ năng. Để chèn một mục mà không nhấn ⌘V, hãy dùng Dịch vụ ▸ Dán từ CopyWell."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 从不替你按键，因此无需辅助功能权限。若想不按 ⌘V 就插入条目，请用「服务 ▸ 从 CopyWell 粘贴」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 從不替你按鍵，因此不需要輔助使用權限。若想不按 ⌘V 就插入項目，請用「服務 ▸ 從 CopyWell 貼上」。"
          }
        }
      }
    },
    "CopyWell only records while it is running. More themes, accent colours and text size are in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell записывает только пока запущен. Другие темы, акцентные цвета и размер текста — в настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell записує, лише доки працює. Інші теми, акцентні кольори та розмір тексту — у налаштуваннях."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell zeichnet nur auf, solange es läuft. Weitere Themes, Akzentfarben und die Textgröße finden sich in den Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell n’enregistre que lorsqu’il est ouvert. D’autres thèmes, couleurs d’accentuation et tailles de texte se trouvent dans les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell solo graba mientras está en marcha. Hay más temas, colores de acento y tamaños de texto en los ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell registra solo mentre è in esecuzione. Altri temi, colori d’accento e dimensioni del testo sono nelle impostazioni."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell só grava enquanto está a correr. Há mais temas, cores de destaque e tamanhos de texto nas definições."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell só grava enquanto está em execução. Há mais temas, cores de destaque e tamanhos de texto nos ajustes."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El CopyWell només enregistra mentre s’executa. Hi ha més temes, colors d’accent i mides de text als ajustos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell legt alleen vast zolang het draait. Meer thema’s, accentkleuren en tekstgrootte staan in de instellingen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell spelar bara in medan det körs. Fler teman, accentfärger och textstorlek finns i inställningarna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell optager kun, mens det kører. Flere temaer, accentfarver og tekststørrelse findes i indstillingerne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell tar bare opp mens det kjører. Flere temaer, aksentfarger og tekststørrelse finnes i innstillingene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell tallentaa vain ollessaan käynnissä. Lisää teemoja, korostusvärejä ja tekstikokoja löytyy asetuksista."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell zapisuje tylko wtedy, gdy jest uruchomiony. Więcej motywów, kolorów akcentu i rozmiarów tekstu znajduje się w ustawieniach."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell zaznamenává, jen dokud běží. Další motivy, barvy zvýraznění a velikost textu jsou v nastavení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell zaznamenáva, len kým beží. Ďalšie motívy, farby zvýraznenia a veľkosť textu sú v nastaveniach."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell bilježi samo dok radi. Više tema, boja naglaska i veličina teksta nalazi se u postavkama."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell înregistrează doar cât timp rulează. Mai multe teme, culori de accent și dimensiuni de text se află în setări."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A CopyWell csak addig rögzít, amíg fut. További témák, kiemelőszínek és szövegméret a beállításokban található."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το CopyWell καταγράφει μόνο όσο εκτελείται. Περισσότερα θέματα, χρώματα τονισμού και μέγεθος κειμένου βρίσκονται στις ρυθμίσεις."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell yalnızca çalışırken kaydeder. Daha fazla tema, vurgu rengi ve metin boyutu ayarlarda bulunur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏CopyWell يسجّل فقط أثناء تشغيله. مزيد من السمات وألوان التمييز وحجم النص في الإعدادات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏CopyWell מקליט רק בזמן שהוא פועל. ערכות נוספות, צבעי הדגשה וגודל טקסט נמצאים בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell केवल चलते रहने के दौरान ही रिकॉर्ड करता है। और थीम, एक्सेंट रंग और टेक्स्ट आकार सेटिंग्स में हैं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell บันทึกเฉพาะขณะที่ทำงานอยู่ ธีม สีเน้น และขนาดข้อความเพิ่มเติมอยู่ในการตั้งค่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell chỉ ghi lại trong lúc đang chạy. Thêm chủ đề, màu nhấn và cỡ chữ nằm trong phần cài đặt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell hanya merekam selama berjalan. Tema, warna aksen, dan ukuran teks lainnya ada di pengaturan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell hanya merakam semasa ia berjalan. Lebih banyak tema, warna aksen dan saiz teks ada dalam tetapan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell が記録するのは実行中のあいだだけです。ほかのテーマ、アクセントカラー、文字サイズは設定にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell은 실행 중일 때만 기록합니다. 다른 테마와 강조 색상, 글자 크기는 설정에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 只在运行时记录。更多主题、强调色和文字大小都在设置中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 只在執行時記錄。更多佈景主題、強調色與文字大小都在設定中。"
          }
        }
      }
    },
    "CopyWell syncs on launch, when you switch back to it, and a few seconds after you copy something. Images and items marked sensitive stay on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزامن CopyWell عند التشغيل، وعند العودة إليه، وبعد ثوانٍ من نسخك لشيء ما. تبقى الصور والعناصر المعلّمة كحساسة على هذا الـ Mac."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El CopyWell se sincronitza en obrir-se, quan hi tornes i uns segons després de copiar alguna cosa. Les imatges i els elements marcats com a sensibles es queden en aquest Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell se synchronizuje při spuštění, při návratu k němu a několik sekund po zkopírování. Obrázky a položky označené jako citlivé zůstávají na tomto Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell synkroniserer ved start, når du skifter tilbage, og få sekunder efter at du har kopieret noget. Billeder og emner markeret som følsomme bliver på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell synchronisiert beim Start, beim Zurückwechseln und einige Sekunden nach dem Kopieren. Bilder und als vertraulich markierte Einträge bleiben auf diesem Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το CopyWell συγχρονίζεται κατά την εκκίνηση, όταν επιστρέφετε σε αυτό και λίγα δευτερόλεπτα μετά από κάθε αντιγραφή. Οι εικόνες και τα στοιχεία που έχουν σημανθεί ως ευαίσθητα παραμένουν σε αυτό το Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell syncs on launch, when you switch back to it, and a few seconds after you copy something. Images and items marked sensitive stay on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell sincroniza al abrirse, al volver a él y unos segundos después de copiar algo. Las imágenes y los elementos marcados como confidenciales se quedan en este Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell synkronoi käynnistyessään, kun palaat siihen, ja muutama sekunti kopioinnin jälkeen. Kuvat ja arkaluonteisiksi merkityt kohteet jäävät tälle Macille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell se synchronise au lancement, quand vous y revenez, et quelques secondes après une copie. Les images et les éléments marqués sensibles restent sur ce Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell מסתנכרן בהפעלה, כשחוזרים אליו, וכמה שניות אחרי שמעתיקים משהו. תמונות ופריטים המסומנים כרגישים נשארים ב-Mac הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell खुलने पर, आपके लौटने पर, और कुछ कॉपी करने के कुछ सेकंड बाद सिंक करता है। तस्वीरें और संवेदनशील चिह्नित चीज़ें इसी Mac पर रहती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell se sinkronizira pri pokretanju, kad mu se vratite i nekoliko sekundi nakon kopiranja. Slike i stavke označene kao osjetljive ostaju na ovom Macu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A CopyWell indításkor, visszaváltáskor és a másolás után néhány másodperccel szinkronizál. A képek és az érzékenynek jelölt elemek ezen a Macen maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell menyinkronkan saat dibuka, saat Anda kembali ke sana, dan beberapa detik setelah Anda menyalin sesuatu. Gambar dan item bertanda sensitif tetap di Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell si sincronizza all’avvio, quando ci torni e pochi secondi dopo una copia. Le immagini e gli elementi segnati come sensibili restano su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellは起動時、切り替えて戻ったとき、そしてコピーの数秒後に同期します。画像と取り扱い注意の項目はこのMacに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell은 실행할 때, 다시 전환할 때, 그리고 복사 후 몇 초 뒤에 동기화합니다. 이미지와 민감으로 표시된 항목은 이 Mac에 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell menyegerak semasa dibuka, apabila anda kembali kepadanya, dan beberapa saat selepas anda menyalin sesuatu. Imej dan item yang ditanda sensitif kekal pada Mac ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell synkroniserer ved oppstart, når du bytter tilbake, og noen sekunder etter at du har kopiert noe. Bilder og objekter merket som sensitive blir på denne Macen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell synchroniseert bij het starten, als je terugschakelt en een paar seconden nadat je iets kopieert. Afbeeldingen en als gevoelig gemarkeerde items blijven op deze Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell synchronizuje przy starcie, po powrocie do programu i kilka sekund po skopiowaniu. Obrazy i wpisy oznaczone jako poufne zostają na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell sincroniza ao abrir, ao voltar para ele e alguns segundos depois de você copiar algo. Imagens e itens marcados como sensíveis ficam neste Mac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell sincroniza ao arrancar, quando volta a ele e alguns segundos depois de copiar algo. As imagens e os itens marcados como sensíveis ficam neste Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell se sincronizează la pornire, când reveniți la el și la câteva secunde după ce copiați ceva. Imaginile și elementele marcate ca sensibile rămân pe acest Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell синхронизируется при запуске, при возврате к программе и через несколько секунд после копирования. Изображения и записи, помеченные как конфиденциальные, остаются на этом Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell sa synchronizuje pri spustení, pri návrate k nemu a niekoľko sekúnd po skopírovaní. Obrázky a položky označené ako citlivé zostávajú na tomto Macu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell synkroniserar vid start, när du växlar tillbaka och några sekunder efter att du kopierat något. Bilder och objekt märkta som känsliga stannar på den här datorn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ซิงค์ตอนเปิด ตอนคุณสลับกลับมา และอีกไม่กี่วินาทีหลังคุณคัดลอก รูปภาพและรายการที่ทำเครื่องหมายว่าละเอียดอ่อนจะอยู่บน Mac เครื่องนี้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell açılışta, ona geri döndüğünüzde ve bir şey kopyaladıktan birkaç saniye sonra eşitlenir. Görüntüler ve hassas işaretli öğeler bu Mac’te kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell синхронізується під час запуску, коли ви повертаєтеся до нього, і за кілька секунд після копіювання. Зображення й записи, позначені як конфіденційні, лишаються на цьому Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell đồng bộ khi khởi động, khi bạn quay lại và vài giây sau khi bạn sao chép. Hình ảnh và các mục đánh dấu nhạy cảm vẫn ở lại máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 会在启动时、切回时以及拷贝后几秒同步。图像和标为敏感的条目只留在这台 Mac 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 會在啟動時、切換回來時以及拷貝後幾秒同步。影像和標為敏感的項目只留在這部 Mac。"
          }
        }
      }
    },
    "CopyWell's right-click entries are macOS Services, which macOS keeps switched off until someone chooses otherwise. In that list the groups start collapsed; the CopyWell entries live under Text, Images, and Files and Folders. The Finder menu is a separate switch, under Finder Extensions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell's right-click entries are macOS Services, which macOS keeps switched off until someone chooses otherwise. In that list the groups start collapsed; the CopyWell entries live under Text, Images, and Files and Folders. The Finder menu is a separate switch, under Finder Extensions."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عناصر CopyWell في قائمة النقر بالزر الأيمن هي خدمات macOS، ويبقيها النظام مُعطَّلة إلى أن يختار المستخدم غير ذلك. المجموعات في تلك القائمة تبدأ مطوية، وعناصر CopyWell موجودة ضمن «نص» و«صور» و«ملفات ومجلدات». أما قائمة Finder فهي مفتاح منفصل ضمن إضافات Finder."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les entrades de CopyWell al menú contextual són serveis de macOS, que el sistema manté desactivats fins que algú decideix el contrari. En aquella llista els grups comencen plegats; les entrades de CopyWell són a Text, Imatges i Fitxers i carpetes. El menú del Finder és un interruptor a part, a Extensions del Finder."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky CopyWellu v kontextové nabídce jsou služby macOS, které systém ponechává vypnuté, dokud se někdo nerozhodne jinak. V tom seznamu jsou skupiny sbalené; položky CopyWell najdete v Textu, Obrázcích a Souborech a složkách. Nabídka Finderu je samostatný přepínač v rozšířeních Finderu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWells punkter i højrekliksmenuen er macOS-tjenester, som systemet holder slået fra, indtil nogen vælger andet. I den liste er grupperne foldet sammen; CopyWell-punkterne ligger under Tekst, Billeder samt Filer og mapper. Finder-menuen er en separat kontakt under Finder-udvidelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kontextmenü-Einträge von CopyWell sind macOS-Dienste, die das System ausgeschaltet lässt, bis jemand etwas anderes wählt. In dieser Liste sind die Gruppen zugeklappt; die CopyWell-Einträge stehen unter Text, Bilder sowie Dateien und Ordner. Das Finder-Menü ist ein eigener Schalter unter Finder-Erweiterungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εγγραφές του CopyWell στο μενού δεξιού κλικ είναι υπηρεσίες macOS, τις οποίες το σύστημα κρατά απενεργοποιημένες μέχρι να επιλέξει κάποιος διαφορετικά. Σε εκείνη τη λίστα οι ομάδες ξεκινούν κλειστές· οι εγγραφές CopyWell βρίσκονται στο Κείμενο, στις Εικόνες και στα Αρχεία και φάκελοι. Το μενού του Finder είναι ξεχωριστός διακόπτης, στις επεκτάσεις Finder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las entradas de CopyWell en el menú contextual son servicios de macOS, que el sistema mantiene desactivados hasta que alguien elija lo contrario. En esa lista los grupos vienen plegados; las entradas de CopyWell están en Texto, Imágenes y Archivos y carpetas. El menú del Finder es un interruptor aparte, en Extensiones del Finder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellin kohdat kakkospainikkeen valikossa ovat macOS-palveluita, jotka järjestelmä pitää pois käytöstä, kunnes joku valitsee toisin. Luettelossa ryhmät ovat suljettuina; CopyWellin kohdat ovat kohdissa Teksti, Kuvat sekä Tiedostot ja kansiot. Finderin valikko on erillinen kytkin Finder-laajennuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les entrées de CopyWell dans le menu contextuel sont des services macOS, que le système laisse désactivés tant que personne n’en décide autrement. Dans cette liste, les groupes sont repliés ; les entrées CopyWell se trouvent sous Texte, Images et Fichiers et dossiers. Le menu du Finder est un réglage distinct, sous Extensions du Finder."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריטים של CopyWell בתפריט הלחיצה הימנית הם שירותי macOS, שהמערכת משאירה כבויים עד שמישהו בוחר אחרת. ברשימה הזו הקבוצות מכווצות; הפריטים של CopyWell נמצאים תחת טקסט, תמונות וכן קבצים ותיקיות. תפריט ה‑Finder הוא מתג נפרד, תחת הרחבות Finder."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell के राइट-क्लिक विकल्प macOS सेवाएँ हैं, जिन्हें सिस्टम तब तक बंद रखता है जब तक कोई अन्यथा न चुने। उस सूची में समूह सिमटे हुए होते हैं; CopyWell के विकल्प टेक्स्ट, इमेज तथा फ़ाइलें और फ़ोल्डर में हैं। Finder का मेन्यू अलग स्विच है, Finder एक्सटेंशन में।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavke CopyWella u kontekstnom izborniku su usluge macOS-a koje sustav drži isključenima dok netko ne odluči drukčije. Na tom popisu grupe su sklopljene; stavke CopyWell nalaze se pod Tekst, Slike te Datoteke i mape. Izbornik Findera zaseban je prekidač, u proširenjima Findera."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A CopyWell helyi menüs elemei macOS-szolgáltatások, amelyeket a rendszer kikapcsolva hagy, amíg valaki másként nem dönt. A listában a csoportok összecsukva jelennek meg; a CopyWell elemei a Szöveg, a Képek, valamint a Fájlok és mappák alatt vannak. A Finder menüje külön kapcsoló, a Finder-bővítményeknél."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Entri klik kanan CopyWell adalah Layanan macOS, yang dibiarkan mati oleh sistem sampai seseorang memilih sebaliknya. Dalam daftar itu grupnya tertutup; entri CopyWell ada di Teks, Gambar, serta Berkas dan Folder. Menu Finder adalah sakelar terpisah, di Ekstensi Finder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voci di CopyWell nel menu contestuale sono servizi di macOS, che il sistema tiene disattivati finché qualcuno non sceglie diversamente. In quell’elenco i gruppi sono chiusi; le voci CopyWell stanno sotto Testo, Immagini e File e cartelle. Il menu del Finder è un interruttore a parte, nelle estensioni del Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellの右クリック項目はmacOSのサービスで、誰かが変更するまでシステムはオフのままにします。その一覧ではグループが折りたたまれており、CopyWellの項目は「テキスト」「イメージ」「ファイルとフォルダ」にあります。Finderのメニューは別のスイッチで、Finder機能拡張にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell의 마우스 오른쪽 메뉴 항목은 macOS 서비스로, 사용자가 달리 선택하기 전까지 시스템이 꺼 둡니다. 그 목록에서 그룹은 접혀 있고, CopyWell 항목은 텍스트, 이미지, 파일 및 폴더에 있습니다. Finder 메뉴는 Finder 확장 프로그램에 있는 별도의 스위치입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Entri klik kanan CopyWell ialah Perkhidmatan macOS, yang dibiarkan dimatikan oleh sistem sehingga seseorang memilih sebaliknya. Dalam senarai itu kumpulannya tertutup; entri CopyWell berada di bawah Teks, Imej, serta Fail dan Folder. Menu Finder ialah suis berasingan, di Sambungan Finder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWells punkter i høyreklikkmenyen er macOS-tjenester, som systemet lar være avslått til noen velger noe annet. I den listen er gruppene slått sammen; CopyWell-punktene ligger under Tekst, Bilder og Filer og mapper. Finder-menyen er en egen bryter, under Finder-utvidelser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De rechtermuisknop-items van CopyWell zijn macOS-diensten, die het systeem uitgeschakeld laat tot iemand anders beslist. In die lijst staan de groepen dichtgeklapt; de CopyWell-items staan onder Tekst, Afbeeldingen en Bestanden en mappen. Het Finder-menu is een aparte schakelaar, onder Finder-extensies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozycje CopyWell w menu kontekstowym to usługi macOS, które system pozostawia wyłączone, dopóki ktoś nie zdecyduje inaczej. Na tej liście grupy są zwinięte; pozycje CopyWell znajdują się w Tekst, Obrazy oraz Pliki i foldery. Menu Findera to osobny przełącznik, w rozszerzeniach Findera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens do CopyWell no menu de clique direito são Serviços do macOS, que o sistema mantém desligados até alguém decidir o contrário. Nessa lista os grupos vêm recolhidos; os itens do CopyWell ficam em Texto, Imagens e Arquivos e pastas. O menu do Finder é um interruptor à parte, em Extensões do Finder."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens do CopyWell no menu do botão direito são Serviços do macOS, que o sistema mantém desligados até alguém decidir o contrário. Nessa lista os grupos vêm recolhidos; os itens do CopyWell ficam em Texto, Imagens e Ficheiros e pastas. O menu do Finder é um interruptor à parte, em Extensões do Finder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Intrările CopyWell din meniul contextual sunt servicii macOS, pe care sistemul le lasă dezactivate până când cineva alege altfel. În acea listă grupurile sunt restrânse; intrările CopyWell se află la Text, Imagini și Fișiere și dosare. Meniul Finder este un comutator separat, la extensiile Finder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пункты CopyWell в контекстном меню — это службы macOS, и система держит их выключенными, пока человек не решит иначе. В том списке группы свёрнуты, а пункты CopyWell находятся в «Тексте», «Изображениях» и «Файлах и папках». Меню Finder — отдельный переключатель, в расширениях Finder."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky CopyWellu v kontextovej ponuke sú služby macOS, ktoré systém necháva vypnuté, kým sa niekto nerozhodne inak. V tom zozname sú skupiny zbalené; položky CopyWell nájdete v Texte, Obrázkoch a Súboroch a priečinkoch. Ponuka Findera je samostatný prepínač v rozšíreniach Findera."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWells poster i högerklicksmenyn är macOS-tjänster, som systemet låter vara avstängda tills någon väljer annat. I den listan är grupperna hopfällda; CopyWell-posterna finns under Text, Bilder samt Filer och mappar. Finder-menyn är en egen brytare, under Finder-tillägg."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการคลิกขวาของ CopyWell คือบริการของ macOS ซึ่งระบบจะปิดไว้จนกว่าจะมีคนเลือกเป็นอย่างอื่น ในรายการนั้นกลุ่มต่าง ๆ จะถูกย่อไว้ และรายการของ CopyWell อยู่ใน ข้อความ, ภาพ และ ไฟล์และโฟลเดอร์ ส่วนเมนูใน Finder เป็นสวิตช์แยกต่างหากที่ส่วนขยาย Finder"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell'in sağ tık girişleri macOS Hizmetleridir; sistem, biri aksini seçene kadar bunları kapalı tutar. O listede gruplar kapalı başlar; CopyWell girişleri Metin, Görüntüler ve Dosyalar ve Klasörler altındadır. Finder menüsü ise Finder Uzantıları altındaki ayrı bir anahtardır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пункти CopyWell у контекстному меню — це служби macOS, і система тримає їх вимкненими, доки людина не вирішить інакше. У тому списку групи згорнуті, а пункти CopyWell розташовані в «Тексті», «Зображеннях» та «Файлах і теках». Меню Finder — окремий перемикач, у розширеннях Finder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục chuột phải của CopyWell là Dịch vụ của macOS, và hệ thống để tắt cho đến khi ai đó chọn khác đi. Trong danh sách ấy các nhóm đang thu gọn; các mục CopyWell nằm ở Văn bản, Hình ảnh và Tệp và thư mục. Menu trong Finder là một công tắc riêng, ở phần tiện ích Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 的右键菜单项是 macOS 的「服务」，在有人另行选择之前系统会一直保持关闭。该列表中的分组默认折叠，CopyWell 的条目位于「文本」「图像」「文件和文件夹」下。访达菜单是「访达扩展」中的一个独立开关。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 的右鍵選單項目是 macOS 的「服務」，在有人另行選擇之前系統會一直保持關閉。該列表中的群組預設收合，CopyWell 的項目位於「文字」「影像」「檔案與檔案夾」下。Finder 選單是「Finder 延伸功能」中的獨立開關。"
          }
        }
      }
    },
    "Could not reach the App Store. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى App Store. تحقق من الاتصال وحاول مرة أخرى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut contactar amb l’App Store. Comprova la connexió i torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se spojit s App Storem. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke få forbindelse til App Store. Tjek din forbindelse, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store ist nicht erreichbar. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η σύνδεση με το App Store. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach the App Store. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido contactar con el App Store. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeen ei saatu yhteyttä. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre l’App Store. Vérifiez votre connexion et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה להתחבר ל-App Store. בדקו את החיבור ונסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store से संपर्क नहीं हो सका। अपना कनेक्शन जाँचकर फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije se moguće povezati s App Storeom. Provjerite vezu i pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült elérni az App Store-t. Ellenőrizze a kapcsolatot, és próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menghubungi App Store. Periksa koneksi Anda lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
