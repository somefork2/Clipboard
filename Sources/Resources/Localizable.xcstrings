    "Sensitive clips are never included in exports.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُدرج العناصر الحساسة في عمليات التصدير أبدًا."
          }
