    "The saved history could not be opened. This session is being kept in memory only.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح السجل المحفوظ. تُحفظ هذه الجلسة في الذاكرة فقط."
