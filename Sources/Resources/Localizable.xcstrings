    "Ignore items marked secret by other apps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore items marked secret by other apps"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاهل العناصر التي تعلّمها تطبيقات أخرى كسرية"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorovat položky, které jiné aplikace označí jako tajné"
