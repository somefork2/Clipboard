    "Queue several clips and paste them one after another.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queue several clips and paste them one after another."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رتّب عدة عناصر والصقها واحدًا تلو الآخر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zařaďte několik položek za sebe a vkládejte je jednu po druhé."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt flere emner i kø, og indsæt dem et ad gangen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reihe mehrere Einträge auf und füge sie nacheinander ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon varios elementos en cola y pégalos uno tras otro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita useampi kohde jonoon ja liitä ne peräkkäin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez plusieurs éléments en file et collez-les l’un après l’autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in coda più elementi e incollali uno dopo l’altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の項目を並べて、順番にペーストできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 항목을 모아 차례대로 붙여넣으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet meerdere items op rij en plak ze na elkaar."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett flere objekter i kø, og lim dem inn etter hverandre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw kilka wpisów w kolejce i wklejaj je jeden po drugim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfileire vários itens e cole um depois do outro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соберите несколько записей и вставляйте их одну за другой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ flera objekt i kö och klistra in dem ett efter ett."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç öğeyi sıraya dizin ve arka arkaya yapıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберіть кілька записів і вставляйте їх один за одним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把几个条目排好队，一个接一个地粘贴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把幾個項目排好，一個接一個貼上。"
          }
        }
      }
    },
