    "Everything in CopyWell, without the free-tier limits.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in CopyWell, without the free-tier limits."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما في CopyWell، دون حدود النسخة المجانية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celý CopyWell bez omezení bezplatné verze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele CopyWell, uden gratisversionens grænser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles in CopyWell, ohne die Grenzen der Gratisversion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo CopyWell, sin los límites de la versión gratuita."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koko CopyWell ilman ilmaisversion rajoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout CopyWell, sans les limites de la version gratuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto CopyWell, senza i limiti della versione gratuita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版の制限なしで、CopyWellのすべてを。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 버전의 제한 없이, CopyWell의 모든 기능을."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles van CopyWell, zonder de grenzen van de gratis versie."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele CopyWell, uten grensene i gratisversjonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cały CopyWell, bez ograniczeń wersji darmowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o CopyWell, sem os limites da versão gratuita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь CopyWell, без ограничений бесплатной версии."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt i CopyWell, utan gratisversionens gränser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz sürümün sınırları olmadan CopyWell’in tamamı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увесь CopyWell, без обмежень безкоштовної версії."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
