    "Use at least one of ⌘, ⌥ or ⌃.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم واحدًا على الأقل من ⌘ أو ⌥ أو ⌃."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes servir almenys una de les tecles ⌘, ⌥ o ⌃."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte alespoň jednu z kláves ⌘, ⌥ nebo ⌃."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug mindst en af tasterne ⌘, ⌥ og ⌃."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende mindestens eine der Tasten ⌘, ⌥ oder ⌃."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε τουλάχιστον ένα από τα ⌘, ⌥ ή ⌃."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use at least one of ⌘, ⌥ or ⌃."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa al menos una de las teclas ⌘, ⌥ o ⌃."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä vähintään yhtä näppäimistä ⌘, ⌥ ja ⌃."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez au moins l’une des touches ⌘, ⌥ ou ⌃."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמשו לפחות באחד מהמקשים ⌘, ⌥ או ⌃."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘, ⌥ या ⌃ में से कम से कम एक ज़रूर लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotrijebite barem jednu od tipki ⌘, ⌥ ili ⌃."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használja a ⌘, ⌥ vagy ⌃ billentyűk legalább egyikét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan setidaknya salah satu dari ⌘, ⌥, atau ⌃."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa almeno uno fra ⌘, ⌥ e ⌃."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘、⌥、⌃のいずれかを必ず含めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘, ⌥, ⌃ 중 하나 이상을 사용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan sekurang-kurangnya salah satu daripada ⌘, ⌥ atau ⌃."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk minst én av tastene ⌘, ⌥ og ⌃."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik ten minste een van de toetsen ⌘, ⌥ of ⌃."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj przynajmniej jednego z klawiszy ⌘, ⌥ lub ⌃."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use pelo menos uma das teclas ⌘, ⌥ ou ⌃."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use pelo menos uma das teclas ⌘, ⌥ ou ⌃."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosiți cel puțin una dintre tastele ⌘, ⌥ sau ⌃."
          }
        },
        "ru": {
          "stringUnit": {
