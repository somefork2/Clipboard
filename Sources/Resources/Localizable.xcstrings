    "Another app already uses the shortcut for: %@. Pick a different one in Settings ▸ Shortcuts.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم تطبيق آخر الاختصار الخاص بـ: %@. اختر اختصاراً مختلفاً من الإعدادات ◂ الاختصارات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una altra app ja fa servir la drecera de: %@. Tria’n una altra a Configuració ▸ Dreceres."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkratku už používá jiná aplikace: %@. Vyberte jinou v Nastavení ▸ Zkratky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden app bruger allerede genvejen til: %@. Vælg en anden i Indstillinger ▸ Genveje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere App verwendet den Kurzbefehl für %@ bereits. Wähle in den Einstellungen ▸ Kurzbefehle einen anderen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια άλλη εφαρμογή χρησιμοποιεί ήδη τη συντόμευση για: %@. Επιλέξτε άλλη στις Ρυθμίσεις ▸ Συντομεύσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app already uses the shortcut for: %@. Pick a different one in Settings ▸ Shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app ya usa el atajo de: %@. Elige otro en Ajustes ▸ Atajos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toinen sovellus käyttää jo pikanäppäintä: %@. Valitse toinen kohdassa Asetukset ▸ Pikanäppäimet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre app utilise déjà le raccourci de : %@. Choisissez-en un autre dans Réglages ▸ Raccourcis."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפליקציה אחרת כבר משתמשת בקיצור עבור: %@. בחרו קיצור אחר בהגדרות ◂ קיצורי דרך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई दूसरा ऐप पहले से यह शॉर्टकट इस्तेमाल कर रहा है: %@। सेटिंग्स ▸ शॉर्टकट में दूसरा चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugi program već koristi prečac za: %@. Odaberite drugi u Postavkama ▸ Prečaci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy másik alkalmazás már használja ezt a billentyűparancsot: %@. Válasszon másikat: Beállítások ▸ Billentyűparancsok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi lain sudah memakai pintasan untuk: %@. Pilih yang lain di Pengaturan ▸ Pintasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’altra app usa già la scorciatoia per: %@. Scegline un’altra in Impostazioni ▸ Scorciatoie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のアプリがすでにこのショートカットを使用しています: %@。設定 ▸ ショートカットで別のものを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 이미 이 단축키를 쓰고 있습니다: %@. 설정 ▸ 단축키에서 다른 것을 고르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi lain sudah menggunakan pintasan untuk: %@. Pilih yang lain di Tetapan ▸ Pintasan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen app bruker allerede snarveien for: %@. Velg en annen i Innstillinger ▸ Snarveier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere app gebruikt de sneltoets voor %@ al. Kies een andere in Instellingen ▸ Sneltoetsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Innej aplikacji przypisano już skrót do: %@. Wybierz inny w Ustawieniach ▸ Skróty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro app já usa o atalho de: %@. Escolha outro em Ajustes ▸ Atalhos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra app já usa o atalho de: %@. Escolha outro em Definições ▸ Atalhos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O altă aplicație folosește deja scurtătura pentru: %@. Alege alta în Setări ▸ Scurtături."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сочетание клавиш уже занято другим приложением: %@. Выберите другое в Настройках ▸ Сочетания клавиш."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skratku už používa iná aplikácia: %@. Vyberte inú v Nastaveniach ▸ Skratky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En annan app använder redan kortkommandot för: %@. Välj ett annat i Inställningar ▸ Kortkommandon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปอื่นใช้ทางลัดนี้อยู่แล้ว: %@ เลือกปุ่มอื่นได้ที่ การตั้งค่า ▸ ทางลัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir uygulama bu kısayolu zaten kullanıyor: %@. Ayarlar ▸ Kısayollar bölümünden başka birini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це поєднання клавіш уже зайняте іншим застосунком: %@. Виберіть інше в Налаштуваннях ▸ Сполучення клавіш."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng khác đã dùng phím tắt cho: %@. Hãy chọn phím khác trong Cài đặt ▸ Phím tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个 App 已占用该快捷键：%@。请在“设置 ▸ 快捷键”中另选一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個 App 已佔用該快速鍵：%@。請在「設定 ▸ 快速鍵」中另選一個。"
          }
        }
      }
    },
