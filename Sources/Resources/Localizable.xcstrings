    "Floating palette at the cursor; pick a clip and press ⌘V": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لوحة عائمة عند المؤشر: اختر عنصرًا ثم اضغط ⌘V"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
