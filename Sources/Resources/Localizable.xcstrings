    "A clip that looked like a password was not recorded.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clip that looked like a password was not recorded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Eintrag, der wie ein Passwort aussah, wurde nicht gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se guardó un elemento que parecía una contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un élément qui ressemblait à un mot de passe n’a pas été enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un elemento che sembrava una password non è stato registrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードらしき項目は記録しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호로 보이는 항목은 기록하지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een item dat op een wachtwoord leek, is niet bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpis wyglądający na hasło nie został zapisany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um item que parecia uma senha não foi registrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись, похожая на пароль, не сохранена."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett objekt som såg ut som ett lösenord sparades inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parolaya benzeyen bir öğe kaydedilmedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一项看起来像密码，已不予记录。"
          }
        }
      }
    },
