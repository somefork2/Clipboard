    "Keep clips you reuse, or queue several and paste them in order.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep clips you reuse, or queue several and paste them in order."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre Einträge auf, die du wieder brauchst, oder reihe mehrere auf und füge sie der Reihe nach ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda lo que reutilizas, o pon varios elementos en cola y pégalos en orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez ce que vous réutilisez, ou mettez plusieurs éléments en file et collez-les dans l’ordre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni gli elementi che riusi, oppure mettine diversi in coda e incollali in ordine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使う項目を取っておいたり、複数を並べて順にペーストしたりできます。"
          }
        }
      }
    },
