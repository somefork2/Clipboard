    "Press ⌥⌘V anywhere, pick a clip, press ⌘V.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ⌥⌘V في أي مكان، اختر عنصرًا، ثم اضغط ⌘V."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Prem ⌥⌘V a qualsevol lloc, tria un element i prem ⌘V."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiskněte kdekoli ⌥⌘V, vyberte položku, stiskněte ⌘V."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på ⌥⌘V hvor som helst, vælg et emne, tryk på ⌘V."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überall ⌥⌘V drücken, Eintrag wählen, ⌘V drücken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ⌥⌘V οπουδήποτε, διαλέξτε στοιχείο, πατήστε ⌘V."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press ⌥⌘V anywhere, pick a clip, press ⌘V."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⌥⌘V en cualquier sitio, elige un elemento y pulsa ⌘V."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina ⌥⌘V missä tahansa, valitse kohde, paina ⌘V."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites ⌥⌘V n’importe où, choisissez un élément, faites ⌘V."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחצו ⌥⌘V בכל מקום, בחרו פריט, לחצו ⌘V."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कहीं भी ⌥⌘V दबाएँ, कोई चीज़ चुनें, ⌘V दबाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritisnite ⌥⌘V bilo gdje, odaberite stavku, pritisnite ⌘V."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomjon ⌥⌘V-t bárhol, válasszon egy elemet, nyomjon ⌘V-t."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan ⌥⌘V di mana saja, pilih item, tekan ⌘V."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi ⌥⌘V ovunque, scegli un elemento, premi ⌘V."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこでも⌥⌘Vを押し、項目を選び、⌘Vを押します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서든 ⌥⌘V를 누르고, 항목을 고른 뒤 ⌘V를 누르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan ⌥⌘V di mana-mana, pilih item, tekan ⌘V."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk ⌥⌘V hvor som helst, velg et objekt, trykk ⌘V."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk overal op ⌥⌘V, kies een item, druk op ⌘V."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij ⌥⌘V w dowolnym miejscu, wybierz wpis, naciśnij ⌘V."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperte ⌥⌘V em qualquer lugar, escolha um item, aperte ⌘V."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima ⌥⌘V em qualquer lado, escolha um item, prima ⌘V."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați ⌥⌘V oriunde, alegeți un element, apăsați ⌘V."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ⌥⌘V где угодно, выберите запись, нажмите ⌘V."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stlačte kdekoľvek ⌥⌘V, vyberte položku, stlačte ⌘V."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck ⌥⌘V var som helst, välj ett objekt, tryck ⌘V."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กด ⌥⌘V ที่ไหนก็ได้ เลือกรายการ แล้วกด ⌘V"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nerede olursanız olun ⌥⌘V’ye basın, bir öğe seçin, ⌘V’ye basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть ⌥⌘V де завгодно, виберіть запис, натисніть ⌘V."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn ⌥⌘V ở bất kỳ đâu, chọn một mục, nhấn ⌘V."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意位置按 ⌥⌘V，选一个条目，再按 ⌘V。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何地方按 ⌥⌘V，選一個項目，再按 ⌘V。"
          }
        }
      }
