    "Sign in to iCloud in System Settings to use sync.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى iCloud من إعدادات النظام لاستخدام المزامنة."
          }
        },
        "ca": {
          "stringUnit": {
