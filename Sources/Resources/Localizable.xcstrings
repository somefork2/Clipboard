    "Favourites and clips on a pinboard are never removed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُحذف المفضلة ولا العناصر الموجودة على لوحة أبدًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els preferits i els elements d’un tauler no s’eliminen mai."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oblíbené položky a položky na nástěnce se nikdy nemažou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoritter og emner på en opslagstavle bliver aldrig slettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten und Einträge auf einer Pinnwand werden nie entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αγαπημένα και τα στοιχεία σε πίνακα δεν διαγράφονται ποτέ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favourites and clips on a pinboard are never removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los favoritos y los elementos de un tablero nunca se eliminan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suosikkeja ja taululla olevia kohteita ei poisteta koskaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris et les éléments épinglés ne sont jamais supprimés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מועדפים ופריטים על לוח לעולם אינם נמחקים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पसंदीदा और बोर्ड पर रखी चीज़ें कभी नहीं हटतीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriti i stavke na ploči nikad se ne brišu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kedvencek és a táblán lévő elemek soha nem törlődnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorit dan item di papan tidak pernah dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I preferiti e gli elementi su una bacheca non vengono mai rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りとボード上の項目が削除されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기와 보드에 있는 항목은 삭제되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kegemaran dan item pada papan tidak pernah dipadam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoritter og objekter på en oppslagstavle slettes aldri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorieten en items op een prikbord worden nooit verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulubione i wpisy na tablicy nigdy nie są usuwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoritos e itens em um quadro nunca são removidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os favoritos e os itens num quadro nunca são removidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoritele și elementele de pe un panou nu sunt șterse niciodată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избранное и записи на досках не удаляются никогда."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obľúbené položky a položky na nástenke sa nikdy nemažú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriter och objekt på en anslagstavla tas aldrig bort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการโปรดและรายการบนบอร์ดจะไม่ถูกลบเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriler ve bir panodaki öğeler asla silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обране та записи на дошках не вилучаються ніколи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục yêu thích và mục trên bảng ghim không bao giờ bị xoá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏和板上的条目永远不会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "喜好項目和看板上的項目永遠不會被刪除。"
          }
        }
      }
    },
