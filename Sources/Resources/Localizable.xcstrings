    "Copy anything and it appears here. Press ⌥⌘V anywhere to paste it back.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسخ أي شيء فيظهر هنا. اضغط ⌥⌘V في أي مكان لاستعادته."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia el que sigui i apareixerà aquí. Prem ⌥⌘V a qualsevol lloc per recuperar-ho."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkopírujte cokoli a objeví se to tady. ⌥⌘V to vrátí kdekoli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopier hvad som helst, så dukker det op her. ⌥⌘V henter det tilbage, uanset hvor du er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere irgendetwas und es erscheint hier. ⌥⌘V holt es überall wieder hervor."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντιγράψτε οτιδήποτε και εμφανίζεται εδώ. Με ⌥⌘V το ανακτάτε από παντού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy anything and it appears here. Press ⌥⌘V anywhere to paste it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia lo que sea y aparecerá aquí. Pulsa ⌥⌘V en cualquier sitio para recuperarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioi mitä tahansa, ja se ilmestyy tänne. ⌥⌘V hakee sen takaisin missä tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez n’importe quoi et cela apparaît ici. ⌥⌘V le ramène où que vous soyez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העתיקו כל דבר והוא יופיע כאן. ⌥⌘V מחזיר אותו מכל מקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी कॉपी करें और वह यहाँ आ जाएगा। कहीं भी ⌥⌘V दबाकर उसे वापस पाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopirajte bilo što i pojavit će se ovdje. ⌥⌘V to vraća bilo gdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Másoljon bármit, és itt megjelenik. A ⌥⌘V bárhonnan visszahozza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin apa pun dan ia muncul di sini. Tekan ⌥⌘V di mana saja untuk mengambilnya kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia qualsiasi cosa e comparirà qui. ⌥⌘V te la riporta ovunque tu sia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何かをコピーするとここに並びます。どこでも⌥⌘Vで呼び戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이든 복사하면 여기에 쌓입니다. 어디서든 ⌥⌘V로 다시 꺼내세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin apa sahaja dan ia muncul di sini. Tekan ⌥⌘V di mana-mana untuk mendapatkannya semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopier hva som helst, så dukker det opp her. ⌥⌘V henter det tilbake uansett hvor du er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieer wat dan ook en het verschijnt hier. Met ⌥⌘V haal je het overal terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiuj cokolwiek, a pojawi się tutaj. ⌥⌘V przywoła to w dowolnym miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie qualquer coisa e ela aparece aqui. ⌥⌘V traz de volta, de onde você estiver."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie o que quiser e aparece aqui. ⌥⌘V traz de volta, onde quer que esteja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiați orice și apare aici. ⌥⌘V îl aduce înapoi oriunde v-ați afla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте что угодно — оно появится здесь. ⌥⌘V вернёт его в любом месте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopírujte čokoľvek a objaví sa tu. ⌥⌘V to vráti kdekoľvek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiera vad som helst så dyker det upp här. ⌥⌘V hämtar tillbaka det var du än är."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกอะไรก็ได้แล้วมันจะมาอยู่ที่นี่ กด ⌥⌘V ที่ไหนก็ได้เพื่อเรียกกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neyi kopyalarsanız burada belirir. Nerede olursanız olun ⌥⌘V ile geri çağırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопіюйте будь-що — воно з’явиться тут. ⌥⌘V поверне його де завгодно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao chép bất cứ thứ gì và nó hiện ra ở đây. Nhấn ⌥⌘V ở bất kỳ đâu để lấy lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝任何内容都会出现在这里。在任意位置按 ⌥⌘V 即可取回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝任何內容都會出現在這裡。在任何地方按 ⌥⌘V 就能取回。"
          }
        }
      }
    },
