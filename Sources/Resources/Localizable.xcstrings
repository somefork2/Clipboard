    "A clip that looked like a password was not recorded.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clip that looked like a password was not recorded."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم حفظ عنصر بدا كأنه كلمة سر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položka, která vypadala jako heslo, nebyla uložena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et emne, der lignede en adgangskode, blev ikke gemt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Eintrag, der wie ein Passwort aussah, wurde nicht gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se guardó un elemento que parecía una contraseña."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasanalta näyttänyttä kohdetta ei tallennettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un élément qui ressemblait à un mot de passe n’a pas été enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un elemento che sembrava una password non è stato registrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードらしき項目は記録しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호로 보이는 항목은 기록하지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een item dat op een wachtwoord leek, is niet bewaard."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Et objekt som så ut som et passord, ble ikke lagret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpis wyglądający na hasło nie został zapisany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um item que parecia uma senha não foi registrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись, похожая на пароль, не сохранена."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett objekt som såg ut som ett lösenord sparades inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parolaya benzeyen bir öğe kaydedilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис, схожий на пароль, не збережено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一项看起来像密码，已不予记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有一項看起來像密碼，已不予記錄。"
          }
        }
      }
    },
