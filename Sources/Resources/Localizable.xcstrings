    "Clips and their stored images are removed permanently.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحذف العناصر والصور المحفوظة معها نهائيًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els elements i les imatges desades amb ells s’eliminen definitivament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky i obrázky uložené spolu s nimi budou trvale smazány."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Emnerne og de billeder, der er gemt sammen med dem, slettes permanent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einträge und die dazu gespeicherten Bilder werden endgültig entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα στοιχεία και οι εικόνες που φυλάσσονται μαζί τους διαγράφονται οριστικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips and their stored images are removed permanently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos y las imágenes guardadas con ellos se eliminan de forma permanente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohteet ja niiden mukana tallennetut kuvat poistetaan pysyvästi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments et les images conservées avec eux sont supprimés définitivement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריטים והתמונות שנשמרו איתם נמחקים לצמיתות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चीज़ें और उनके साथ सहेजी गई तस्वीरें हमेशा के लिए हट जाती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavke i slike spremljene uz njih brišu se trajno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elemek és a velük tárolt képek véglegesen törlődnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item beserta gambar yang tersimpan bersamanya dihapus permanen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi e le immagini conservate con essi vengono rimossi definitivamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目と一緒に保存された画像は完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목과 함께 저장된 이미지가 영구적으로 삭제됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Item dan imej yang disimpan bersamanya dipadam secara kekal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Objektene og bildene som er lagret sammen med dem, slettes for godt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Items en de bewaarde afbeeldingen worden definitief verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisy i zapisane z nimi obrazy zostaną usunięte trwale."
          }
        },
