        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ مشفرًا ولا يظهر في المعاينات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloženo zašifrovaně; v náhledech se nezobrazuje."
