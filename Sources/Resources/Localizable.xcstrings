          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidite što najviše kopirate i iz kojih aplikacija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézze meg, mit másol a legtöbbet, és mely alkalmazásokból."
