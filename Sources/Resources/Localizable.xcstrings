    "Password managers are respected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password managers are respected."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحترم برامج إدارة كلمات السر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Správci hesel jsou respektováni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgangskodeprogrammer bliver respekteret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwortmanager werden respektiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se respetan los gestores de contraseñas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasanaohjelmia kunnioitetaan."
          }
        },
        "fr": {
          "stringUnit": {
