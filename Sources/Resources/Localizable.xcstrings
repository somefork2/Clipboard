    "CopyWell adds items to the right-click menu of every app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell adds items to the right-click menu of every app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف CopyWell أوامره إلى قائمة النقر بالزر الأيمن في كل تطبيق."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell přidá své příkazy do kontextové nabídky každé aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell føjer sine kommandoer til højrekliksmenuen i alle programmer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell fügt dem Rechtsklick-Menü jeder App eigene Befehle hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell añade sus órdenes al menú contextual de todas las apps."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell lisää komentonsa jokaisen ohjelman kakkospainikkeen valikkoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ajoute ses commandes au menu contextuel de toutes les apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell aggiunge i suoi comandi al menu contestuale di ogni app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellはすべてのAppの右クリックメニューに項目を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell은 모든 앱의 우클릭 메뉴에 항목을 추가합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell voegt zijn opdrachten toe aan het rechtsklikmenu van elke app."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell legger kommandoene sine i høyreklikkmenyen i alle programmer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell dodaje swoje polecenia do menu podręcznego każdej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell adiciona comandos ao menu de contexto de todos os apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell добавляет свои команды в контекстное меню любой программы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell lägger till sina kommandon i högerklicksmenyn i alla program."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell her uygulamanın sağ tık menüsüne kendi komutlarını ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell додає свої команди до контекстного меню будь-якої програми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 会把自己的命令加入每个 App 的右键菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 會把自己的指令加入每個 App 的右鍵選單。"
          }
        }
      }
    },
    "CopyWell does not have permission to use iCloud on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell does not have permission to use iCloud on this Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لدى CopyWell إذن لاستخدام iCloud على هذا الـ Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nemá na tomto Macu oprávnění používat iCloud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell har ikke tilladelse til at bruge iCloud på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell hat auf diesem Mac keine Berechtigung für iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell no tiene permiso para usar iCloud en este Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellilla ei ole oikeutta käyttää iCloudia tällä Macilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell n’a pas l’autorisation d’utiliser iCloud sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell non ha il permesso di usare iCloud su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでCopyWellにiCloudの使用許可がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 CopyWell에 iCloud 사용 권한이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell heeft geen toestemming om iCloud op deze Mac te gebruiken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell har ikke tillatelse til å bruke iCloud på denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nie ma uprawnień do korzystania z iCloud na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell não tem permissão para usar o iCloud neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У CopyWell нет разрешения на использование iCloud на этом Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell har inte behörighet att använda iCloud på den här datorn."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell’in bu Mac’te iCloud kullanma izni yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell не має дозволу користуватися iCloud на цьому Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 在这台 Mac 上没有使用 iCloud 的权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 在這部 Mac 上沒有使用 iCloud 的權限。"
          }
        }
      }
    },
    "CopyWell has nothing to paste.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell has nothing to paste."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لدى CopyWell ما يلصقه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nemá co vložit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell har intet at indsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell hat nichts zum Einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell no tiene nada que pegar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellilla ei ole mitään liitettävää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell n’a rien à coller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell non ha niente da incollare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellにペーストできるものがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell에 붙여넣을 항목이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell heeft niets om te plakken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell har ingenting å lime inn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nie ma czego wkleić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell não tem nada para colar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell нечего вставить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell har inget att klistra in."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell’de yapıştırılacak bir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell нічого вставляти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 没有可粘贴的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 沒有可貼上的內容。"
          }
        }
      }
    },
    "CopyWell keeps what you copy, so you can get it back later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell keeps what you copy, so you can get it back later."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ CopyWell بما تنسخه لتتمكن من استعادته لاحقًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell uchovává to, co zkopírujete, abyste se k tomu mohli později vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell gemmer det, du kopierer, så du kan hente det frem igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell bewahrt auf, was du kopierst – damit du später wieder herankommst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell guarda lo que copias para que puedas recuperarlo después."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell säilyttää kopioimasi, jotta saat sen myöhemmin takaisin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell conserve ce que vous copiez, pour que vous puissiez le retrouver ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell conserva ciò che copi, così puoi ritrovarlo più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellはコピーした内容を取っておくので、あとから取り出せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell은 복사한 내용을 보관해 두어 나중에 다시 꺼낼 수 있게 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell bewaart wat je kopieert, zodat je het later terug kunt halen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell tar vare på det du kopierer, så du kan hente det fram igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell przechowuje to, co kopiujesz, żebyś mógł wrócić do tego później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell guarda o que você copia, para você recuperar depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell хранит всё скопированное, чтобы вы могли вернуться к нему позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell sparar det du kopierar, så att du kan hämta tillbaka det senare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell kopyaladıklarınızı saklar, sonra geri alabilesiniz diye."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell зберігає все скопійоване, щоб ви могли повернутися до нього згодом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 会留住你拷贝过的内容，方便你随后取回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 會留住你拷貝過的內容，方便你稍後取回。"
          }
        }
      }
    },
    "CopyWell never presses keys for you, so it needs no Accessibility access.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell never presses keys for you, so it needs no Accessibility access."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يضغط CopyWell المفاتيح نيابة عنك، ولذلك لا يحتاج إلى إذن تسهيلات الاستخدام."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell za vás nikdy nemačká klávesy, a proto nepotřebuje přístup ke Zpřístupnění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell trykker aldrig på taster for dig og har derfor ikke brug for adgang til Tilgængelighed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell drückt keine Tasten für dich und braucht deshalb keinen Zugriff auf die Bedienungshilfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nunca pulsa teclas por ti, así que no necesita acceso a Accesibilidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ei koskaan paina näppäimiä puolestasi, joten se ei tarvitse Käyttöapu-oikeutta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell n’appuie jamais sur les touches à votre place : aucun accès à l’Accessibilité n’est nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell non preme mai i tasti al posto tuo, quindi non ha bisogno dell’accesso ad Accessibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellが代わりにキーを押すことはないため、アクセシビリティ権限は必要ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell은 대신 키를 누르지 않으므로 손쉬운 사용 권한이 필요 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell drukt nooit toetsen voor je in en heeft dus geen toegang tot Toegankelijkheid nodig."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell trykker aldri på taster for deg, og trenger derfor ingen tilgang til Tilgjengelighet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nigdy nie naciska klawiszy za Ciebie, więc nie potrzebuje dostępu do Dostępności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell nunca aperta teclas por você, então não precisa de acesso à Acessibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell не нажимает клавиши за вас, поэтому доступ к Универсальному доступу не нужен."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell trycker aldrig på tangenter åt dig och behöver därför ingen tillgång till Tillgänglighet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell sizin yerinize tuşlara basmaz, bu yüzden Erişilebilirlik iznine gerek duymaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell не натискає клавіші замість вас, тому доступ до Доступності не потрібен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 从不替你按键，因此无需辅助功能权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 從不替你按鍵，因此不需要輔助使用權限。"
          }
        }
      }
    },
    "CopyWell never presses keys for you, so it needs no Accessibility access. To insert a clip without pressing ⌘V, use Services ▸ Paste from CopyWell.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell never presses keys for you, so it needs no Accessibility access. To insert a clip without pressing ⌘V, use Services ▸ Paste from CopyWell."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يضغط CopyWell المفاتيح نيابة عنك، ولذلك لا يحتاج إلى إذن تسهيلات الاستخدام. لإدراج عنصر دون الضغط على ⌘V، استخدم الخدمات ▸ اللصق من CopyWell."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell za vás nikdy nemačká klávesy, a proto nepotřebuje přístup ke Zpřístupnění. Chcete-li vložit položku bez ⌘V, použijte Služby ▸ Vložit z CopyWellu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell trykker aldrig på taster for dig og har derfor ikke brug for adgang til Tilgængelighed. Vil du indsætte et emne uden ⌘V, så brug Tjenester ▸ Indsæt fra CopyWell."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell drückt keine Tasten für dich und braucht deshalb keinen Zugriff auf die Bedienungshilfen. Um einen Eintrag ohne ⌘V einzusetzen, nutze Dienste ▸ Aus CopyWell einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nunca pulsa teclas por ti, así que no necesita acceso a Accesibilidad. Para insertar un elemento sin pulsar ⌘V, usa Servicios ▸ Pegar desde CopyWell."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ei koskaan paina näppäimiä puolestasi, joten se ei tarvitse Käyttöapu-oikeutta. Jos haluat lisätä kohteen painamatta ⌘V, käytä Palvelut ▸ Liitä CopyWellista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell n’appuie jamais sur les touches à votre place : aucun accès à l’Accessibilité n’est nécessaire. Pour insérer un élément sans faire ⌘V, utilisez Services ▸ Coller depuis CopyWell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell non preme mai i tasti al posto tuo, quindi non ha bisogno dell’accesso ad Accessibilità. Per inserire un elemento senza premere ⌘V, usa Servizi ▸ Incolla da CopyWell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellが代わりにキーを押すことはないため、アクセシビリティ権限は必要ありません。⌘Vを押さずに項目を挿入するには、サービス ▸ CopyWellからペーストを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell은 대신 키를 누르지 않으므로 손쉬운 사용 권한이 필요 없습니다. ⌘V를 누르지 않고 항목을 넣으려면 서비스 ▸ CopyWell에서 붙여넣기를 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell drukt nooit toetsen voor je in en heeft dus geen toegang tot Toegankelijkheid nodig. Wil je een item invoegen zonder ⌘V, gebruik dan Diensten ▸ Plak uit CopyWell."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell trykker aldri på taster for deg, og trenger derfor ingen tilgang til Tilgjengelighet. Vil du sette inn et objekt uten ⌘V, bruker du Tjenester ▸ Lim inn fra CopyWell."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nigdy nie naciska klawiszy za Ciebie, więc nie potrzebuje dostępu do Dostępności. Aby wstawić wpis bez ⌘V, użyj Usługi ▸ Wklej z CopyWell."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell nunca aperta teclas por você, então não precisa de acesso à Acessibilidade. Para inserir um item sem apertar ⌘V, use Serviços ▸ Colar do CopyWell."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell не нажимает клавиши за вас, поэтому доступ к Универсальному доступу не нужен. Чтобы вставить запись без ⌘V, используйте Службы ▸ Вставить из CopyWell."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell trycker aldrig på tangenter åt dig och behöver därför ingen tillgång till Tillgänglighet. Vill du infoga ett objekt utan ⌘V använder du Tjänster ▸ Klistra in från CopyWell."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell sizin yerinize tuşlara basmaz, bu yüzden Erişilebilirlik iznine gerek duymaz. ⌘V’ye basmadan öğe eklemek için Hizmetler ▸ CopyWell’den yapıştır seçeneğini kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell не натискає клавіші замість вас, тому доступ до Доступності не потрібен. Щоб вставити запис без ⌘V, скористайтеся Служби ▸ Вставити з CopyWell."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 从不替你按键，因此无需辅助功能权限。若想不按 ⌘V 就插入条目，请用「服务 ▸ 从 CopyWell 粘贴」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 從不替你按鍵，因此不需要輔助使用權限。若想不按 ⌘V 就插入項目，請用「服務 ▸ 從 CopyWell 貼上」。"
          }
        }
      }
    },
    "CopyWell only records while it is running. More themes, accent colours and text size are in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell only records while it is running. More themes, accent colours and text size are in Settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ CopyWell أثناء تشغيله فقط. تجد المزيد من السمات وألوان التمييز وحجم النص في الإعدادات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ukládá, jen když běží. Další motivy, barvy zvýraznění a velikost textu najdete v nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell gemmer kun, mens programmet kører. Flere temaer, accentfarver og tekststørrelse findes i indstillingerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell zeichnet nur auf, solange es läuft. Weitere Designs, Akzentfarben und die Textgröße findest du in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell solo registra mientras está abierto. Hay más temas, colores de acento y el tamaño del texto en los ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell tallentaa vain ollessaan käynnissä. Lisää teemoja, korostusvärejä ja tekstin koko löytyvät asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell n’enregistre que lorsqu’il est ouvert. D’autres thèmes, couleurs d’accent et la taille du texte sont dans les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell registra solo mentre è in esecuzione. Altri temi, colori d’accento e la dimensione del testo sono nelle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellは起動中のみ記録します。テーマ、アクセントカラー、文字サイズは設定にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell은 실행 중일 때만 기록합니다. 더 많은 테마와 강조 색상, 텍스트 크기는 설정에 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell bewaart alleen zolang het draait. Meer thema's, accentkleuren en de tekstgrootte vind je in de instellingen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell lagrer bare mens programmet kjører. Flere temaer, aksentfarger og tekststørrelse finner du i innstillingene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell zapisuje tylko wtedy, gdy działa. Więcej motywów, kolorów akcentu i wielkość tekstu znajdziesz w ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell só registra enquanto está aberto. Mais temas, cores de destaque e o tamanho do texto ficam nos ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell записывает, только пока запущен. Другие темы, цвета акцента и размер текста — в настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell sparar bara medan programmet är igång. Fler teman, dekorfärger och textstorlek finns i inställningarna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell yalnızca çalışırken kaydeder. Daha fazla tema, vurgu rengi ve metin boyutu ayarlardadır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell зберігає, лише поки працює. Інші теми, кольори акценту й розмір тексту — у налаштуваннях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 只在运行时记录。更多主题、强调色和文字大小都在设置里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 只在執行時記錄。更多主題、強調色和文字大小都在設定裡。"
          }
        }
      }
    },
    "CopyWell syncs on launch, when you switch back to it, and a few seconds after you copy something. Images and items marked sensitive stay on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell syncs on launch, when you switch back to it, and a few seconds after you copy something. Images and items marked sensitive stay on this Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزامن CopyWell عند التشغيل، وعند العودة إليه، وبعد ثوانٍ من نسخك لشيء ما. تبقى الصور والعناصر المعلّمة كحساسة على هذا الـ Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell se synchronizuje při spuštění, při návratu k němu a několik sekund po zkopírování. Obrázky a položky označené jako citlivé zůstávají na tomto Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell synkroniserer ved start, når du skifter tilbage, og få sekunder efter at du har kopieret noget. Billeder og emner markeret som følsomme bliver på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell synchronisiert beim Start, beim Zurückwechseln und einige Sekunden nach dem Kopieren. Bilder und als vertraulich markierte Einträge bleiben auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell sincroniza al abrirse, al volver a él y unos segundos después de copiar algo. Las imágenes y los elementos marcados como confidenciales se quedan en este Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell synkronoi käynnistyessään, kun palaat siihen, ja muutama sekunti kopioinnin jälkeen. Kuvat ja arkaluonteisiksi merkityt kohteet jäävät tälle Macille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell se synchronise au lancement, quand vous y revenez, et quelques secondes après une copie. Les images et les éléments marqués sensibles restent sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell si sincronizza all’avvio, quando ci torni e pochi secondi dopo una copia. Le immagini e gli elementi segnati come sensibili restano su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellは起動時、切り替えて戻ったとき、そしてコピーの数秒後に同期します。画像と取り扱い注意の項目はこのMacに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell은 실행할 때, 다시 전환할 때, 그리고 복사 후 몇 초 뒤에 동기화합니다. 이미지와 민감으로 표시된 항목은 이 Mac에 남습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell synchroniseert bij het starten, als je terugschakelt en een paar seconden nadat je iets kopieert. Afbeeldingen en als gevoelig gemarkeerde items blijven op deze Mac."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell synkroniserer ved oppstart, når du bytter tilbake, og noen sekunder etter at du har kopiert noe. Bilder og objekter merket som sensitive blir på denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell synchronizuje przy starcie, po powrocie do programu i kilka sekund po skopiowaniu. Obrazy i wpisy oznaczone jako poufne zostają na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell sincroniza ao abrir, ao voltar para ele e alguns segundos depois de você copiar algo. Imagens e itens marcados como sensíveis ficam neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell синхронизируется при запуске, при возврате к программе и через несколько секунд после копирования. Изображения и записи, помеченные как конфиденциальные, остаются на этом Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell synkroniserar vid start, när du växlar tillbaka och några sekunder efter att du kopierat något. Bilder och objekt märkta som känsliga stannar på den här datorn."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell açılışta, ona geri döndüğünüzde ve bir şey kopyaladıktan birkaç saniye sonra eşitlenir. Görüntüler ve hassas işaretli öğeler bu Mac’te kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell синхронізується під час запуску, коли ви повертаєтеся до нього, і за кілька секунд після копіювання. Зображення й записи, позначені як конфіденційні, лишаються на цьому Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 会在启动时、切回时以及拷贝后几秒同步。图像和标为敏感的条目只留在这台 Mac 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 會在啟動時、切換回來時以及拷貝後幾秒同步。影像和標為敏感的項目只留在這部 Mac。"
          }
        }
      }
    },
    "Could not reach the App Store. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach the App Store. Check your connection and try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى App Store. تحقق من الاتصال وحاول مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se spojit s App Storem. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke få forbindelse til App Store. Tjek din forbindelse, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store ist nicht erreichbar. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido contactar con el App Store. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeen ei saatu yhteyttä. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre l’App Store. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere l’App Store. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeに接続できませんでした。接続を確認してからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에 연결할 수 없습니다. 연결을 확인한 후 다시 시도하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De App Store is niet bereikbaar. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Fikk ikke kontakt med App Store. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć z App Store. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar a App Store. Verifique sua conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с App Store. Проверьте подключение и повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att nå App Store. Kontrollera anslutningen och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store’a ulaşılamadı. Bağlantınızı denetleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зв’язатися з App Store. Перевірте з’єднання і спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 App Store。请检查网络后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連接 App Store。請檢查連線後再試一次。"
          }
        }
      }
    },
