      }
    },
    "Everything is unlocked. Afterwards CopyWell keeps the last 48 hours.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is unlocked. Afterwards CopyWell keeps the last 48 hours."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء متاح. بعد ذلك يحتفظ CopyWell بآخر ٤٨ ساعة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše je odemčeno. Poté si CopyWell ponechá posledních 48 hodin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt er låst op. Derefter gemmer CopyWell de seneste 48 timer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles ist freigeschaltet. Danach bewahrt CopyWell die letzten 48 Stunden auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo está desbloqueado. Después, CopyWell conserva las últimas 48 horas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki on avattu. Sen jälkeen CopyWell säilyttää viimeiset 48 tuntia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est débloqué. Ensuite, CopyWell conserve les 48 dernières heures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto è sbloccato. Poi CopyWell conserva le ultime 48 ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて利用できます。期間終了後は直近48時間分を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기능이 열려 있습니다. 이후에는 최근 48시간을 보관합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles is ontgrendeld. Daarna bewaart CopyWell de laatste 48 uur."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt er låst opp. Etterpå tar CopyWell vare på de siste 48 timene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko jest odblokowane. Potem CopyWell zachowa ostatnie 48 godzin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo está liberado. Depois, o CopyWell guarda as últimas 48 horas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё открыто. Потом CopyWell будет хранить последние 48 часов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt är upplåst. Därefter sparar CopyWell de senaste 48 timmarna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey açık. Sonrasında CopyWell son 48 saati saklar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе відкрито. Потім CopyWell зберігатиме останні 48 годин."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有功能都已解锁。之后 CopyWell 会保留最近 48 小时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有功能都已解鎖。之後 CopyWell 會保留最近 48 小時。"
          }
        }
      }
    },
