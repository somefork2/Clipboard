    "Off after installation. Changing a sound plays it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معطّل بعد التثبيت. عند تغيير الصوت يُشغَّل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivat després de la instal·lació. En canviar de so, es reprodueix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po instalaci vypnuto. Při změně se zvuk přehraje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slået fra efter installationen. Når du skifter lyd, afspilles den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Installation aus. Beim Wechseln wird der Ton kurz abgespielt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανενεργό μετά την εγκατάσταση. Με την αλλαγή ήχου ακούγεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off after installation. Changing a sound plays it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado tras la instalación. Al cambiar de sonido, se escucha."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pois päältä asennuksen jälkeen. Ääntä vaihtaessa se soitetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé après l’installation. Changer de son le fait écouter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבוי אחרי ההתקנה. החלפת צליל משמיעה אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंस्टॉल के बाद बंद रहता है। ध्वनि बदलने पर वह बजकर सुनाई देती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključeno nakon instalacije. Promjenom zvuka on se reproducira."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telepítés után kikapcsolva. A hang váltásakor le is játsszuk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mati setelah pemasangan. Mengganti suara akan memutarnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato dopo l’installazione. Cambiando suono lo ascolti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール直後はオフです。サウンドを変えると試聴できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치 직후에는 꺼져 있습니다. 사운드를 바꾸면 들어 볼 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimatikan selepas pemasangan. Menukar bunyi akan memainkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Av etter installeringen. Når du bytter lyd, spilles den av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na de installatie uit. Bij het wisselen hoor je het geluid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po instalacji wyłączone. Zmiana dźwięku od razu go odtwarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado após a instalação. Ao trocar de som, ele é tocado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado após a instalação. Ao mudar de som, este é reproduzido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivat după instalare. Când schimbați sunetul, acesta se redă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После установки выключено. При смене звук проигрывается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po inštalácii vypnuté. Pri zmene sa zvuk prehrá."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avstängt efter installationen. När du byter ljud spelas det upp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดอยู่หลังติดตั้ง เมื่อเปลี่ยนเสียงจะเล่นให้ฟัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulumdan sonra kapalıdır. Sesi değiştirdiğinizde çalınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після встановлення вимкнено. Під час зміни звук програється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt sau khi cài đặt. Đổi âm thanh sẽ phát thử."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装后默认关闭。切换声音时会试听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝後預設關閉。切換聲音時會試聽。"
          }
        }
      }
    },
    "Off by default. A utility that beeps every time you copy gets uninstalled.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معطّل افتراضيًا. الأداة التي تصدر صوتًا مع كل نسخة ينتهي بها الأمر محذوفة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivat per omissió. Una utilitat que fa un so cada cop que copies acaba desinstal·lada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve výchozím stavu vypnuto. Nástroj, který pípne při každém kopírování, skončí odinstalovaný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slået fra som standard. Et værktøj, der bipper hver gang du kopierer, bliver afinstalleret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus. Ein Hilfsprogramm, das bei jedem Kopieren piept, fliegt schnell wieder runter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανενεργό εξ ορισμού. Ένα βοηθητικό που ηχεί σε κάθε αντιγραφή καταλήγει απεγκατεστημένο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. A utility that beeps every time you copy gets uninstalled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por omisión. Una utilidad que pita cada vez que copias acaba desinstalada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletuksena pois päältä. Apuohjelma, joka piippaa joka kopioinnilla, päätyy roskiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Un utilitaire qui bipe à chaque copie finit désinstallé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבוי כברירת מחדל. כלי שמצפצף בכל העתקה נמחק בסוף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट रूप से बंद। हर कॉपी पर आवाज़ करने वाला औज़ार आख़िर हटा ही दिया जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadano isključeno. Alat koji pišti pri svakom kopiranju na kraju bude deinstaliran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alapból kikapcsolva. Az olyan segédprogramot, amely minden másoláskor csipog, előbb-utóbb letörlik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mati secara bawaan. Utilitas yang berbunyi setiap kali Anda menyalin ujungnya akan dicopot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato di default. Un’utility che suona a ogni copia finisce disinstallata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定はオフです。コピーのたびに鳴るユーティリティは消されてしまいますから。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 꺼짐입니다. 복사할 때마다 소리 내는 유틸리티는 결국 삭제되니까요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimatikan secara lalai. Utiliti yang berbunyi setiap kali anda menyalin akhirnya dinyahpasang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Av som standard. Et verktøy som piper hver gang du kopierer, blir avinstallert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard uit. Een hulpprogramma dat bij elke kopie piept, wordt verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie wyłączone. Narzędzie piszczące przy każdym kopiowaniu ląduje w koszu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por padrão. Um utilitário que apita a cada cópia acaba desinstalado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por omissão. Um utilitário que apita a cada cópia acaba desinstalado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivat implicit. Un utilitar care sună la fiecare copiere ajunge dezinstalat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию выключено. Программу, которая пищит при каждом копировании, удаляют."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predvolene vypnuté. Nástroj, ktorý pípne pri každom kopírovaní, skončí odinštalovaný."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avstängt som standard. Ett program som piper varje gång du kopierar blir avinstallerat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดไว้เป็นค่าเริ่มต้น เครื่องมือที่ส่งเสียงทุกครั้งที่คัดลอกมักจะถูกถอนออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak kapalı. Her kopyalamada öten bir araç silinip gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Типово вимкнено. Програму, що пищить під час кожного копіювання, видаляють."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặc định tắt. Một tiện ích kêu bíp mỗi lần sao chép rồi cũng bị gỡ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。每次拷贝都响一下的工具，最后都会被卸载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設關閉。每次拷貝都響一聲的工具，最後都會被移除。"
          }
        }
      }
    },
    "On-device analysis tags clips by type, language and entities.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضع التحليل على الجهاز علامات على العناصر حسب النوع واللغة والمعلومات المتعرف عليها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anàlisi al mateix dispositiu etiqueta els elements per tipus, idioma i informació reconeguda."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Analýza přímo v počítači označí položky podle typu, jazyka a rozpoznaných údajů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse på selve computeren mærker emner efter type, sprog og genkendte oplysninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Analyse auf dem Gerät versieht Einträge mit Typ, Sprache und erkannten Inhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ανάλυση στη συσκευή σημειώνει τα στοιχεία κατά τύπο, γλώσσα και αναγνωρισμένες πληροφορίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device analysis tags clips by type, language and entities."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis en el dispositivo etiqueta los elementos por tipo, idioma y datos reconocidos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laitteessa tehtävä analyysi merkitsee kohteet tyypin, kielen ja tunnistettujen tietojen mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse sur l’appareil étiquette les éléments par type, langue et informations reconnues."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתוח במכשיר עצמו מתייג פריטים לפי סוג, שפה ומידע שזוהה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस पर ही होने वाला विश्लेषण चीज़ों को प्रकार, भाषा और पहचानी गई जानकारी के हिसाब से चिह्नित करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza na samom uređaju označava stavke po vrsti, jeziku i prepoznatim podacima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gépen futó elemzés típus, nyelv és felismert adatok szerint címkézi az elemeket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisis di perangkat memberi label pada item menurut jenis, bahasa, dan informasi yang dikenali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi sul dispositivo etichetta gli elementi per tipo, lingua e dati riconosciuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内の解析で、項目に種類・言語・認識した情報のタグを付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 분석으로 항목에 종류, 언어, 인식된 정보를 태그로 붙입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisis pada peranti menandakan item mengikut jenis, bahasa dan maklumat yang dikenali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse på selve maskinen merker objekter etter type, språk og gjenkjent informasjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse op het apparaat zelf voorziet items van labels voor soort, taal en herkende gegevens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza na urządzeniu oznacza wpisy według rodzaju, języka i rozpoznanych danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise no próprio dispositivo marca os itens por tipo, idioma e informações reconhecidas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise no próprio dispositivo etiqueta os itens por tipo, idioma e informação reconhecida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza pe dispozitiv etichetează elementele după tip, limbă și informațiile recunoscute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анализ прямо на устройстве отмечает записи по типу, языку и найденным данным."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Analýza priamo v počítači označí položky podľa typu, jazyka a rozpoznaných údajov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Analys i datorn märker objekt efter typ, språk och det som känns igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวิเคราะห์บนเครื่องติดป้ายรายการตามชนิด ภาษา และข้อมูลที่จำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıt üzerindeki çözümleme, öğeleri türüne, diline ve tanınan bilgilere göre etiketler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аналіз просто на пристрої позначає записи за типом, мовою та знайденими даними."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phân tích ngay trên máy gắn nhãn cho các mục theo loại, ngôn ngữ và thông tin nhận ra được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备本机分析会按类型、语言和识别到的信息为条目加标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置本機分析會依類型、語言和辨識到的資訊為項目加上標籤。"
          }
        }
      }
    },
    "Once there are more than %@ clips, the oldest are removed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يتجاوز العدد %@ عنصراً، تُحذف الأقدم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan hi hagi més de %@ elements, se n’eliminen els més antics."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakmile je položek více než %@, nejstarší se odstraní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når der er mere end %@ klip, fjernes de ældste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald es mehr als %@ Einträge gibt, werden die ältesten entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν υπάρχουν περισσότερα από %@ αντικείμενα, τα παλαιότερα αφαιρούνται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once there are more than %@ clips, the oldest are removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando hay más de %@ elementos, se eliminan los más antiguos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun leikkeitä on yli %@, vanhimmat poistetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-delà de %@ éléments, les plus anciens sont supprimés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשיש יותר מ‑%@ פריטים, הישנים ביותר נמחקים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ से ज़्यादा आइटम होने पर सबसे पुराने हटा दिए जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad bude više od %@ stavki, najstarije se uklanjaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha több mint %@ elem van, a legrégebbiek törlődnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika lebih dari %@ item, yang terlama dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ci sono più di %@ elementi, i più vecchi vengono rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@件を超えると、古いものから削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@개를 넘으면 오래된 것부터 삭제됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila melebihi %@ item, yang terlama dibuang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når det er mer enn %@ klipp, fjernes de eldste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra er meer dan %@ items zijn, worden de oudste verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy elementów jest więcej niż %@, najstarsze są usuwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando houver mais de %@ itens, os mais antigos são removidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando houver mais de %@ itens, os mais antigos são removidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când sunt mai mult de %@ elemente, cele mai vechi sunt șterse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда записей становится больше %@, самые старые удаляются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď je položiek viac ako %@, najstaršie sa odstránia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När det finns fler än %@ klipp tas de äldsta bort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อมีมากกว่า %@ รายการ รายการเก่าสุดจะถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ögeden fazla olduğunda en eskiler silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли записів стає більше %@, найстаріші видаляються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi có hơn %@ mục, những mục cũ nhất sẽ bị xoá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过 %@ 条后，最早的会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過 %@ 筆後，最早的會被刪除。"
          }
        }
      }
    },
