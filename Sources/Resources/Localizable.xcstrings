    "Click one to put it back on the clipboard without opening the app.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقرة واحدة تعيده إلى الحافظة دون فتح التطبيق."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic el torna al porta-retalls, sense obrir l’app."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno kliknutí vrátí položku do schránky, aniž byste otvírali aplikaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et klik lægger emnet tilbage på udklipsholderen uden at åbne programmet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Klick legt den Eintrag zurück in die Zwischenablage, ganz ohne die App zu öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα κλικ το επιστρέφει στο πρόχειρο, χωρίς να ανοίξετε την εφαρμογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click one to put it back on the clipboard without opening the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en uno y vuelve al portapapeles sin abrir la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi klikkaus palauttaa kohteen leikepöydälle avaamatta ohjelmaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic le remet dans le presse-papiers, sans ouvrir l’app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחיצה אחת מחזירה אותו ללוח, בלי לפתוח את היישום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक क्लिक उसे ऐप खोले बिना ही क्लिपबोर्ड पर लौटा देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedan klik vraća stavku u međuspremnik, bez otvaranja aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy kattintás visszateszi a vágólapra, anélkül hogy megnyitná az alkalmazást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekali klik mengembalikannya ke papan klip, tanpa membuka aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic lo rimette negli appunti, senza aprire l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックするだけで、Appを開かずにクリップボードへ戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭만 하면 앱을 열지 않고도 클립보드로 되돌립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu klik mengembalikannya ke papan keratan, tanpa membuka apl."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett klikk legger objektet tilbake på utklippstavlen, uten å åpne programmet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén klik zet het terug op het klembord, zonder de app te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno kliknięcie wraca wpis do schowka, bez otwierania programu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um clique devolve o item à área de transferência, sem abrir o app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um clique devolve o item à área de transferência, sem abrir a aplicação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic îl pune înapoi în clipboard, fără să deschideți aplicația."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один щелчок вернёт запись в буфер обмена, не открывая программу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno kliknutie vráti položku do schránky bez otvorenia aplikácie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett klick lägger tillbaka objektet i urklipp, utan att programmet öppnas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกครั้งเดียวก็นำกลับเข้าคลิปบอร์ดได้ โดยไม่ต้องเปิดแอพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tıklamanız yeterli; uygulamayı açmadan panoya geri gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один клац поверне запис до буфера обміну, не відкриваючи програму."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một cú nhấp đưa mục đó trở lại bảng nhớ tạm mà không cần mở ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
