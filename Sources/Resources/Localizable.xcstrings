    "Nothing is removed automatically. The database grows until you clear it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُحذف شيء تلقائيًا. تنمو قاعدة البيانات حتى تمسحها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’elimina res automàticament. La base de dades creix fins que la buides."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic se nemaže automaticky. Databáze roste, dokud ji nevymažete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der slettes ikke noget automatisk. Databasen vokser, indtil du rydder den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nichts automatisch entfernt. Die Datenbank wächst, bis du sie leerst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν διαγράφεται τίποτα αυτόματα. Η βάση μεγαλώνει ώσπου να την καθαρίσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is removed automatically. The database grows until you clear it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se elimina nada automáticamente. La base de datos crece hasta que la vacías."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei poisteta automaattisesti. Tietokanta kasvaa, kunnes tyhjennät sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est supprimé automatiquement. La base grandit jusqu’à ce que vous l’effaciez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר לא נמחק אוטומטית. מסד הנתונים גדל עד שתנקו אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी अपने आप नहीं हटता। जब तक आप साफ़ न करें, डेटाबेस बढ़ता रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa se ne briše automatski. Baza raste dok je ne očistite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi nem törlődik automatikusan. Az adatbázis addig nő, amíg ki nem üríti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang dihapus otomatis. Basis data terus bertambah sampai Anda membersihkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene rimosso niente automaticamente. Il database cresce finché non lo svuoti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動では何も削除されません。消去するまでデータベースは増え続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 삭제되는 항목은 없습니다. 지울 때까지 데이터베이스가 계속 커집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa dipadam secara automatik. Pangkalan data terus membesar sehingga anda mengosongkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting slettes automatisk. Databasen vokser til du tømmer den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets automatisch verwijderd. De database groeit tot je hem wist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest usuwane automatycznie. Baza rośnie, dopóki jej nie wyczyścisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é removido automaticamente. O banco de dados cresce até você limpá-lo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é removido automaticamente. A base de dados cresce até a limpar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu se șterge nimic automat. Baza de date crește până o goliți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически ничего не удаляется. База растёт, пока вы её не очистите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič sa nemaže automaticky. Databáza rastie, kým ju nevymažete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget tas bort automatiskt. Databasen växer tills du rensar den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอะไรถูกลบอัตโนมัติ ฐานข้อมูลจะโตขึ้นจนกว่าคุณจะล้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey otomatik silinmez. Siz temizleyene kadar veritabanı büyür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично нічого не вилучається. База зростає, доки ви її не очистите."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì bị xoá tự động. Cơ sở dữ liệu lớn dần cho tới khi bạn xoá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会自动删除任何内容。数据库会一直增长，直到你清除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會自動刪除任何內容。資料庫會一直成長，直到你清除。"
          }
        }
      }
    },
    "Nothing is uploaded unless you turn on iCloud sync yourself.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُرفع أي شيء ما لم تُفعّل أنت مزامنة iCloud."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No es puja res mentre no activis tu mateix la sincronització amb l’iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic se neodesílá, dokud sami nezapnete synchronizaci s iCloudem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der sendes ikke noget, medmindre du selv slår iCloud-synkronisering til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nichts hochgeladen, solange du die iCloud-Synchronisierung nicht selbst einschaltest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν αποστέλλεται τίποτα αν δεν ενεργοποιήσετε εσείς τον συγχρονισμό με το iCloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is uploaded unless you turn on iCloud sync yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se sube nada mientras no actives tú la sincronización con iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei lähetetä, ellet itse ota iCloud-synkronointia käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est envoyé tant que vous n’activez pas vous-même la synchronisation iCloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר לא נשלח אלא אם תפעילו בעצמכם את הסנכרון עם iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप ख़ुद iCloud सिंक चालू न करें, कुछ भी अपलोड नहीं होता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa se ne šalje dok sami ne uključite sinkronizaciju s iCloudom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi nem kerül fel, amíg ön maga be nem kapcsolja az iCloud-szinkronizálást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang diunggah kecuali Anda sendiri mengaktifkan sinkronisasi iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene caricato niente finché non attivi tu la sincronizzazione iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご自分でiCloud同期を有効にしない限り、何もアップロードされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 iCloud 동기화를 켜지 않는 한 아무것도 업로드되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa dimuat naik melainkan anda sendiri menghidupkan penyegerakan iCloud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting lastes opp med mindre du selv slår på iCloud-synkronisering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets geüpload zolang je iCloud-synchronisatie niet zelf inschakelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest wysyłane, dopóki sam nie włączysz synchronizacji z iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é enviado enquanto você mesmo não ativar a sincronização com o iCloud."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é enviado enquanto não ativar você mesmo a sincronização com o iCloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu se încarcă nimic până nu activați dvs. sincronizarea cu iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не выгружается, пока вы сами не включите синхронизацию с iCloud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič sa neodosiela, kým sami nezapnete synchronizáciu s iCloudom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget överförs om du inte själv slår på iCloud-synkronisering."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการอัปโหลดอะไรจนกว่าคุณจะเปิดการซิงค์ iCloud ด้วยตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz iCloud eşitlemesini açmadıkça hiçbir şey yüklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не вивантажується, доки ви самі не ввімкнете синхронізацію з iCloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì được tải lên trừ khi chính bạn bật đồng bộ iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你自己打开 iCloud 同步，否则不会上传任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你自己打開 iCloud 同步，否則不會上傳任何內容。"
          }
        }
      }
    },
    "Nothing new is recorded while CopyWell is locked.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما دام CopyWell مُقفلاً، لا يُحفظ أي شيء جديد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre el CopyWell està bloquejat, no es desa res de nou."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokud je CopyWell zamčený, nic nového se neukládá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Så længe CopyWell er låst, bliver intet nyt gemt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange CopyWell gesperrt ist, wird nichts Neues aufgezeichnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσο το CopyWell είναι κλειδωμένο, δεν καταγράφεται τίποτα καινούριο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing new is recorded while CopyWell is locked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras CopyWell está bloqueado, no se registra nada nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Niin kauan kuin CopyWell on lukittu, mitään uutta ei tallenneta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que CopyWell est verrouillé, rien de nouveau n’est enregistré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל עוד CopyWell נעול, שום דבר חדש לא נשמר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक CopyWell बंद है, कुछ भी नया नहीं सहेजा जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dok je CopyWell zaključan, ništa se novo ne sprema."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amíg a CopyWell zárolva van, semmi új nem kerül mentésre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selama CopyWell terkunci, tidak ada yang baru disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché CopyWell è bloccato, non viene registrato nulla di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック中は新しく記録されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠겨 있는 동안에는 아무것도 새로 기록되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selagi CopyWell dikunci, tiada apa-apa baharu disimpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Så lenge CopyWell er låst, lagres ingenting nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zolang CopyWell vergrendeld is, wordt er niets nieuws bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopóki CopyWell jest zablokowany, nic nowego nie jest zapisywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto o CopyWell está bloqueado, nada novo é registrado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto o CopyWell está bloqueado, nada de novo é registado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât timp CopyWell este blocat, nu se înregistrează nimic nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока CopyWell заблокирован, ничего нового не записывается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kým je CopyWell zamknutý, nič nové sa neukladá."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Så länge CopyWell är låst sparas inget nytt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระหว่างที่ CopyWell ถูกล็อก จะไม่มีการบันทึกอะไรใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell kilitliyken yeni hiçbir şey kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки CopyWell заблоковано, нічого нового не записується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi CopyWell đang khoá, không có gì mới được ghi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定期间不会记录任何新内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定期間不會記錄任何新內容。"
          }
        }
      }
    },
