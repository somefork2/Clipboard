    "Copies marked secret by 1Password, Bitwarden or Keychain are never recorded.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies marked secret by 1Password, Bitwarden or Keychain are never recorded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was 1Password, Bitwarden oder der Schlüsselbund als geheim markiert, wird nie gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que 1Password, Bitwarden o Llavero marcan como secreto nunca se guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que 1Password, Bitwarden ou Trousseau marque comme secret n’est jamais enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che 1Password, Bitwarden o Portachiavi segnano come segreto non viene mai registrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password、Bitwarden、キーチェーンが秘密として印を付けたものは記録しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password, Bitwarden, 키체인이 비밀로 표시한 항목은 기록하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat 1Password, Bitwarden of Sleutelhanger als geheim markeert, wordt nooit bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co 1Password, Bitwarden lub Pęk kluczy oznaczają jako tajne, nigdy nie jest zapisywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que 1Password, Bitwarden ou Chaves marcam como secreto nunca é registrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То, что 1Password, Bitwarden или Связка ключей помечают как секретное, не сохраняется никогда."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det som 1Password, Bitwarden eller Nyckelhanteraren märker som hemligt sparas aldrig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password, Bitwarden veya Anahtar Zinciri’nin gizli işaretlediği şeyler asla kaydedilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password、Bitwarden 或钥匙串标为机密的内容，一律不记录。"
          }
        }
      }
    },
