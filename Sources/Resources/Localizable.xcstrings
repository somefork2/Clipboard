    "CopyWell never presses keys for you, so it needs no Accessibility access.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يضغط CopyWell المفاتيح نيابة عنك، ولذلك لا يحتاج إلى إذن تسهيلات الاستخدام."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El CopyWell no prem mai tecles per tu, així que no necessita accés a l’Accessibilitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell za vás nikdy nemačká klávesy, a proto nepotřebuje přístup ke Zpřístupnění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell trykker aldrig på taster for dig og har derfor ikke brug for adgang til Tilgængelighed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell drückt keine Tasten für dich und braucht deshalb keinen Zugriff auf die Bedienungshilfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το CopyWell δεν πατά ποτέ πλήκτρα για εσάς, γι’ αυτό δεν χρειάζεται πρόσβαση στην Προσβασιμότητα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell never presses keys for you, so it needs no Accessibility access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nunca pulsa teclas por ti, así que no necesita acceso a Accesibilidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ei koskaan paina näppäimiä puolestasi, joten se ei tarvitse Käyttöapu-oikeutta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell n’appuie jamais sur les touches à votre place : aucun accès à l’Accessibilité n’est nécessaire."
