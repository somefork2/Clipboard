    "Near-black with a muted brass accent.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسود تقريبًا مع لمسة نحاسية هادئة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gairebé negre, amb un toc discret de llautó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Téměř černá s tlumeným mosazným akcentem."
          }
        },
