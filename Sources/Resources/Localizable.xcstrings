    "This item is stored encrypted and is not shown in previews.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item is stored encrypted and is not shown in previews."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Eintrag ist verschlüsselt gespeichert und wird in Vorschauen nicht gezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este elemento se guarda cifrado y no se muestra en las vistas previas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément est conservé chiffré et n’apparaît pas dans les aperçus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elemento è conservato cifrato e non compare nelle anteprime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目は暗号化して保存されており、プレビューには表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 암호화되어 저장되며 미리보기에는 표시되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit item wordt versleuteld bewaard en is niet zichtbaar in voorvertoningen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten wpis jest przechowywany w postaci zaszyfrowanej i nie pojawia się w podglądzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item é guardado criptografado e não aparece nas pré-visualizações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта запись хранится в зашифрованном виде и не показывается в просмотре."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här objektet sparas krypterat och visas inte i förhandsvisningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğe şifreli saklanır ve önizlemelerde gösterilmez."
          }
        },
