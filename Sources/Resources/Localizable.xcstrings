    "Move with ↑↓ or jump with ⌘1–9. ⌘Y looks at a clip before you take it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move with ↑↓ or jump with ⌘1–9. ⌘Y looks at a clip before you take it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit ↑↓ bewegen oder mit ⌘1–9 springen. ⌘Y zeigt einen Eintrag an, bevor du ihn nimmst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muévete con ↑↓ o salta con ⌘1–9. ⌘Y te muestra un elemento antes de cogerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez-vous avec ↑↓ ou sautez avec ⌘1–9. ⌘Y montre un élément avant que vous le preniez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Muoviti con ↑↓ o salta con ⌘1–9. ⌘Y ti mostra un elemento prima che tu lo prenda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓で移動、⌘1–9でジャンプ。⌘Yなら取り出す前に中身を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓로 이동하거나 ⌘1–9로 건너뛰세요. ⌘Y로 가져오기 전에 내용을 볼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweeg met ↑↓ of spring met ⌘1–9. Met ⌘Y bekijk je een item voordat je het pakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poruszaj się klawiszami ↑↓ albo przeskakuj przez ⌘1–9. ⌘Y pokaże wpis, zanim go weźmiesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegue com ↑↓ ou pule com ⌘1–9. ⌘Y mostra o item antes de você pegá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещайтесь клавишами ↑↓ или переходите через ⌘1–9. ⌘Y покажет запись до того, как вы её возьмёте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta med ↑↓ eller hoppa med ⌘1–9. ⌘Y visar ett objekt innan du tar det."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓ ile gezinin ya da ⌘1–9 ile atlayın. ⌘Y, almadan önce öğeye bakmanızı sağlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 ↑↓ 移动，或用 ⌘1–9 跳转。⌘Y 可在取用前先看一眼。"
          }
        }
      }
    },
