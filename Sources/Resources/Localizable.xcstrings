    "See what you copy most, which apps you copy from, and how your history grows over time.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطّلع على ما تنسخه أكثر، ومن أي التطبيقات، وكيف ينمو سجلك مع الوقت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira què copies més, des de quines apps i com creix el teu historial amb el temps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podívejte se, co kopírujete nejčastěji, ze kterých aplikací a jak vaše historie v čase roste."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se, hvad du kopierer mest, hvilke programmer det kommer fra, og hvordan din historik vokser med tiden."
