    "CopyWell does not have permission to use iCloud on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لدى CopyWell إذن لاستخدام iCloud على هذا الـ Mac."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El CopyWell no té permís per utilitzar l’iCloud en aquest Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nemá na tomto Macu oprávnění používat iCloud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell har ikke tilladelse til at bruge iCloud på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell hat auf diesem Mac keine Berechtigung für iCloud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το CopyWell δεν έχει άδεια να χρησιμοποιεί το iCloud σε αυτό το Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell does not have permission to use iCloud on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell no tiene permiso para usar iCloud en este Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellilla ei ole oikeutta käyttää iCloudia tällä Macilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell n’a pas l’autorisation d’utiliser iCloud sur ce Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ל-CopyWell אין הרשאה להשתמש ב-iCloud ב-Mac הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac पर CopyWell को iCloud इस्तेमाल करने की अनुमति नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nema dopuštenje za korištenje iClouda na ovom Macu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A CopyWellnek nincs engedélye az iCloud használatára ezen a Macen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell tidak punya izin memakai iCloud di Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell non ha il permesso di usare iCloud su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでCopyWellにiCloudの使用許可がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 CopyWell에 iCloud 사용 권한이 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell tiada kebenaran untuk menggunakan iCloud pada Mac ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell har ikke tillatelse til å bruke iCloud på denne Macen."
          }
        },
