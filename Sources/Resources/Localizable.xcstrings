        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定はオフです。コピーのたびに鳴るユーティリティは消されてしまいますから。"
          }
        }
      }
    },
    "On the free plan CopyWell keeps the last 48 hours. Favourites and pinboards are never removed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the free plan CopyWell keeps the last 48 hours. Favourites and pinboards are never removed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Gratisversion bewahrt CopyWell die letzten 48 Stunden auf. Favoriten und Pinnwände werden nie entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el plan gratuito, CopyWell conserva las últimas 48 horas. Los favoritos y los tableros nunca se eliminan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec la formule gratuite, CopyWell conserve les 48 dernières heures. Les favoris et les tableaux ne sont jamais supprimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con il piano gratuito CopyWell conserva le ultime 48 ore. I preferiti e le bacheche non vengono mai rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料プランでは直近48時間を保持します。お気に入りとボードが削除されることはありません。"
          }
        }
      }
    },
    "On-device analysis tags clips by type, language and entities.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device analysis tags clips by type, language and entities."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Analyse auf dem Gerät versieht Einträge mit Typ, Sprache und erkannten Inhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis en el dispositivo etiqueta los elementos por tipo, idioma y datos reconocidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse sur l’appareil étiquette les éléments par type, langue et informations reconnues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi sul dispositivo etichetta gli elementi per tipo, lingua e dati riconosciuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内の解析で、項目に種類・言語・認識した情報のタグを付けます。"
          }
        }
