    "iCloud is busy. CopyWell will try again shortly.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is busy. CopyWell will try again shortly."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud مشغول. سيحاول CopyWell مرة أخرى قريبًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud je zaneprázdněný. CopyWell to za chvíli zkusí znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud er optaget. CopyWell prøver igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist ausgelastet. CopyWell versucht es gleich erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud está ocupado. CopyWell lo intentará de nuevo en breve."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud on varattu. CopyWell yrittää pian uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est occupé. CopyWell réessaiera sous peu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud è occupato. CopyWell riproverà a breve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudが混み合っています。CopyWellはまもなく再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud가 사용 중입니다. CopyWell이 곧 다시 시도합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud heeft het druk. CopyWell probeert het zo opnieuw."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud er opptatt. CopyWell prøver igjen snart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud jest zajęty. CopyWell spróbuje ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud está ocupado. O CopyWell vai tentar de novo em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud занят. CopyWell скоро повторит попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud är upptaget. CopyWell försöker igen snart."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud meşgul. CopyWell birazdan yeniden deneyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud зайнятий. CopyWell скоро повторить спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 正忙。CopyWell 稍后会重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 忙碌中。CopyWell 稍後會重試。"
          }
