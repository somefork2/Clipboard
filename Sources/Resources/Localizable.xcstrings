{
  "sourceLanguage": "en",
  "strings": {
    " The %@ trial converts to a paid subscription unless cancelled at least 24 hours before it ends.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " تتحول الفترة التجريبية %@ إلى اشتراك مدفوع ما لم تُلغَ قبل انتهائها بـ 24 ساعة على الأقل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": " La prova de %@ passa a ser una subscripció de pagament si no la canceles com a mínim 24 hores abans que acabi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": " Zkušební období %@ se změní na placené předplatné, pokud ho nezrušíte alespoň 24 hodin před koncem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": " Prøveperioden på %@ bliver til et betalt abonnement, medmindre du opsiger senest 24 timer før den slutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Die Testphase von %@ geht in ein kostenpflichtiges Abo über, sofern sie nicht mindestens 24 Stunden vor Ende gekündigt wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": " Η δοκιμή %@ μετατρέπεται σε συνδρομή επί πληρωμή, εκτός αν ακυρωθεί τουλάχιστον 24 ώρες πριν λήξει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " The %@ trial converts to a paid subscription unless cancelled at least 24 hours before it ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " La prueba de %@ pasa a ser una suscripción de pago si no se cancela al menos 24 horas antes de que termine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ kokeilu muuttuu maksulliseksi tilaukseksi, ellei sitä peruuteta vähintään 24 tuntia ennen päättymistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " L’essai de %@ devient un abonnement payant s’il n’est pas résilié au moins 24 heures avant son terme."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": " תקופת הניסיון של %@ הופכת למינוי בתשלום אלא אם תבוטל לפחות 24 שעות לפני סיומה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ का ट्रायल समाप्त होने से कम से कम 24 घंटे पहले रद्द न करने पर सशुल्क सदस्यता में बदल जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": " Probno razdoblje od %@ prelazi u plaćenu pretplatu ako se ne otkaže najmanje 24 sata prije isteka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": " A(z) %@ próbaidőszak fizetős előfizetéssé alakul, ha nem mondja le legalább 24 órával a vége előtt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": " Uji coba %@ berubah menjadi langganan berbayar kecuali dibatalkan minimal 24 jam sebelum berakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " La prova di %@ diventa un abbonamento a pagamento se non viene annullata almeno 24 ore prima della scadenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " %@の体験期間は、終了の24時間前までに解約しない限り有料サブスクリプションに移行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ 체험 기간은 종료 24시간 전까지 취소하지 않으면 유료 구독으로 전환됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": " Percubaan %@ bertukar kepada langganan berbayar melainkan dibatalkan sekurang-kurangnya 24 jam sebelum tamat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": " Prøveperioden på %@ går over til et betalt abonnement hvis den ikke sies opp minst 24 timer før den utløper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": " De proefperiode van %@ gaat over in een betaald abonnement tenzij je minstens 24 uur voor het einde opzegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " Okres próbny %@ zamienia się w płatną subskrypcję, jeśli nie zostanie anulowany co najmniej 24 godziny przed końcem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " O teste de %@ vira uma assinatura paga se não for cancelado pelo menos 24 horas antes de terminar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": " O período experimental de %@ passa a subscrição paga se não for cancelado pelo menos 24 horas antes de terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": " Perioada de probă de %@ devine abonament cu plată dacă nu este anulată cu cel puțin 24 de ore înainte de expirare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Пробный период %@ превращается в платную подписку, если не отменить его не позже чем за 24 часа до окончания."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": " Skúšobné obdobie %@ sa zmení na platené predplatné, ak ho nezrušíte aspoň 24 hodín pred koncom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": " Testperioden på %@ övergår till en betald prenumeration om den inte sägs upp minst 24 timmar innan den tar slut."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": " ช่วงทดลองใช้ %@ จะเปลี่ยนเป็นการสมัครแบบเสียเงิน หากไม่ยกเลิกอย่างน้อย 24 ชั่วโมงก่อนสิ้นสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ deneme süresi, bitiminden en az 24 saat önce iptal edilmezse ücretli aboneliğe dönüşür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": " Пробний період %@ перетворюється на платну передплату, якщо не скасувати його щонайменше за 24 години до завершення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": " Bản dùng thử %@ sẽ chuyển thành gói trả phí nếu không huỷ trước khi kết thúc ít nhất 24 giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ 试用期在结束前至少 24 小时未取消，将自动转为付费订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ 試用期在結束前至少 24 小時未取消，將自動轉為付費訂閱。"
          }
        }
      }
    },
    "%@ per %@, billed through your Apple Account and renewed automatically until cancelled.%@ Manage or cancel in App Store ▸ Subscriptions.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ لكل %@، تُحصَّل عبر حساب Apple الخاص بك وتُجدَّد تلقائياً حتى الإلغاء.%@ يمكنك الإدارة أو الإلغاء من App Store ◂ الاشتراكات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per %@, cobrat mitjançant el teu compte d’Apple i renovat automàticament fins que el cancel·lis.%@ Gestiona’l o cancel·la’l a l’App Store ▸ Subscripcions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ za %@, účtováno přes váš účet Apple a automaticky obnovováno, dokud ho nezrušíte.%@ Spravovat nebo zrušit můžete v App Store ▸ Předplatná."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pr. %@, betales via din Apple-konto og fornyes automatisk, indtil du opsiger.%@ Administrer eller opsig i App Store ▸ Abonnementer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pro %@, Abrechnung über deinen Apple-Account, automatische Verlängerung bis zur Kündigung.%@ Verwalten oder kündigen im App Store ▸ Abos."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ανά %@, με χρέωση μέσω του λογαριασμού Apple σας και αυτόματη ανανέωση μέχρι την ακύρωση.%@ Διαχείριση ή ακύρωση στο App Store ▸ Συνδρομές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per %@, billed through your Apple Account and renewed automatically until cancelled.%@ Manage or cancel in App Store ▸ Subscriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al %@, con cargo a tu cuenta de Apple y renovación automática hasta que la canceles.%@ Gestiónala o cancélala en App Store ▸ Suscripciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@, veloitetaan Apple-tililtäsi ja uusitaan automaattisesti, kunnes peruutat.%@ Hallinnoi tai peruuta: App Store ▸ Tilaukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ par %@, facturé via votre compte Apple et renouvelé automatiquement jusqu’à résiliation.%@ Gérez ou résiliez dans l’App Store ▸ Abonnements."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ל%@, החיוב דרך חשבון Apple שלכם וחידוש אוטומטי עד לביטול.%@ ניהול או ביטול ב‑App Store ◂ מינויים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ प्रति %@, आपके Apple खाते से शुल्क लिया जाता है और रद्द करने तक अपने आप नवीनीकृत होता है।%@ App Store ▸ सदस्यताएँ में प्रबंधित या रद्द करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ po %@, naplaćuje se putem vašeg Apple računa i automatski se obnavlja dok ne otkažete.%@ Upravljajte ili otkažite u App Storeu ▸ Pretplate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ díjszabással, az Apple-fiókján keresztül számlázva, lemondásig automatikusan megújul.%@ Kezelés vagy lemondás: App Store ▸ Előfizetések."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per %@, ditagihkan melalui Akun Apple Anda dan diperpanjang otomatis sampai dibatalkan.%@ Kelola atau batalkan di App Store ▸ Langganan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al %@, addebitato sul tuo account Apple e rinnovato automaticamente fino all’annullamento.%@ Gestisci o annulla in App Store ▸ Abbonamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@。Apple アカウントに請求され、解約するまで自動更新されます。%@ App Store ▸ サブスクリプションで管理・解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/%@, Apple 계정으로 청구되며 취소할 때까지 자동으로 갱신됩니다.%@ App Store ▸ 구독에서 관리하거나 취소하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ setiap %@, dicaj melalui Akaun Apple anda dan diperbaharui secara automatik sehingga dibatalkan.%@ Urus atau batalkan di App Store ▸ Langganan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per %@, belastes Apple-kontoen din og fornyes automatisk til du sier opp.%@ Administrer eller si opp i App Store ▸ Abonnementer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per %@, in rekening gebracht via je Apple-account en automatisch verlengd tot je opzegt.%@ Beheer of zeg op via App Store ▸ Abonnementen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ za %@, płatność przez konto Apple, automatyczne odnawianie do momentu anulowania.%@ Zarządzaj lub anuluj w App Store ▸ Subskrypcje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ por %@, cobrado na sua Conta Apple e renovado automaticamente até o cancelamento.%@ Gerencie ou cancele em App Store ▸ Assinaturas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ por %@, cobrado na sua Conta Apple e renovado automaticamente até ao cancelamento.%@ Faça a gestão ou cancele em App Store ▸ Subscrições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pe %@, facturat prin contul Apple și reînnoit automat până la anulare.%@ Gestionează sau anulează în App Store ▸ Abonamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ в %@, оплата через ваш аккаунт Apple, продление автоматическое до отмены.%@ Управлять или отменить можно в App Store ▸ Подписки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ za %@, účtované cez váš účet Apple a automaticky obnovované, kým nezrušíte.%@ Spravovať alebo zrušiť môžete v App Store ▸ Predplatné."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per %@, debiteras via ditt Apple-konto och förnyas automatiskt tills du säger upp.%@ Hantera eller säg upp i App Store ▸ Prenumerationer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ต่อ %@ เรียกเก็บผ่านบัญชี Apple ของคุณและต่ออายุอัตโนมัติจนกว่าจะยกเลิก%@ จัดการหรือยกเลิกได้ที่ App Store ▸ การสมัครใช้บริการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@, Apple Hesabınızdan tahsil edilir ve iptal edene kadar otomatik yenilenir.%@ App Store ▸ Abonelikler bölümünden yönetebilir veya iptal edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ за %@, оплата через ваш обліковий запис Apple, поновлення автоматичне до скасування.%@ Керувати або скасувати можна в App Store ▸ Передплати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mỗi %@, tính phí qua Tài khoản Apple của bạn và tự động gia hạn cho đến khi huỷ.%@ Quản lý hoặc huỷ trong App Store ▸ Đăng ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@，通过你的 Apple 账户扣款，到期自动续订，直至取消。%@ 可在 App Store ▸ 订阅中管理或取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@，透過你的 Apple 帳戶扣款，到期自動續訂，直至取消。%@ 可在 App Store ▸ 訂閱中管理或取消。"
          }
        }
      }
    },
