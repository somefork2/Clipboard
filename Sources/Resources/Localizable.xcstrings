    "Nothing is removed automatically. The database grows until you clear it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is removed automatically. The database grows until you clear it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nichts automatisch entfernt. Die Datenbank wächst, bis du sie leerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se elimina nada automáticamente. La base de datos crece hasta que la vacías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est supprimé automatiquement. La base grandit jusqu’à ce que vous l’effaciez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene rimosso niente automaticamente. Il database cresce finché non lo svuoti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動では何も削除されません。消去するまでデータベースは増え続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 삭제되는 항목은 없습니다. 지울 때까지 데이터베이스가 계속 커집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets automatisch verwijderd. De database groeit tot je hem wist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest usuwane automatycznie. Baza rośnie, dopóki jej nie wyczyścisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é removido automaticamente. O banco de dados cresce até você limpá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически ничего не удаляется. База растёт, пока вы её не очистите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget tas bort automatiskt. Databasen växer tills du rensar den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey otomatik silinmez. Siz temizleyene kadar veritabanı büyür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会自动删除任何内容。数据库会一直增长，直到你清除。"
          }
        }
      }
    },
    "Nothing is uploaded unless you turn on iCloud sync yourself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is uploaded unless you turn on iCloud sync yourself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nichts hochgeladen, solange du die iCloud-Synchronisierung nicht selbst einschaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se sube nada mientras no actives tú la sincronización con iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est envoyé tant que vous n’activez pas vous-même la synchronisation iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene caricato niente finché non attivi tu la sincronizzazione iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご自分でiCloud同期を有効にしない限り、何もアップロードされません。"
