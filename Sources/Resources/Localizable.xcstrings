    "Scales every label in CopyWell, and the rows grow with it. Independent of the system-wide setting.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scales every label in CopyWell, and the rows grow with it. Independent of the system-wide setting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaliert jede Beschriftung in CopyWell, die Zeilen wachsen mit. Unabhängig von der systemweiten Einstellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escala cada texto de CopyWell, y las filas crecen con él. Independiente del ajuste del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met à l’échelle tous les libellés de CopyWell, et les lignes suivent. Indépendant du réglage du système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridimensiona ogni testo di CopyWell, e le righe crescono con esso. Indipendente dall’impostazione di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell内のすべての文字を拡大し、行の高さも一緒に変わります。システム全体の設定とは別です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell의 모든 글자 크기를 조절하고, 행 높이도 함께 커집니다. 시스템 전체 설정과는 별개입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaalt alle tekst in CopyWell, en de rijen groeien mee. Los van de systeeminstelling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaluje wszystkie napisy w CopyWell, a wiersze rosną razem z nimi. Niezależnie od ustawienia systemowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redimensiona todos os textos do CopyWell, e as linhas acompanham. Independente do ajuste do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняет размер всех надписей в CopyWell, строки растут вместе с ними. Не зависит от системной настройки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skalar all text i CopyWell, och raderna växer med den. Oberoende av systemets inställning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell’deki tüm yazıları ölçekler, satırlar da onunla birlikte büyür. Sistem genelindeki ayardan bağımsızdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大 CopyWell 中的所有文字，行高也随之变化。与系统设置互不影响。"
          }
        }
      }
    },
