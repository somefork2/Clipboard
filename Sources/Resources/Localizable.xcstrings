    "The last 48 hours are kept. Favourites and pinboards are never removed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last 48 hours are kept. Favourites and pinboards are never removed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten 48 Stunden bleiben erhalten. Favoriten und Pinnwände werden nie entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservan las últimas 48 horas. Los favoritos y los tableros nunca se eliminan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 48 dernières heures sont conservées. Les favoris et les tableaux ne sont jamais supprimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono conservate le ultime 48 ore. I preferiti e le bacheche non vengono mai rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近48時間分を保持します。お気に入りとボードが削除されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 48시간이 보관됩니다. 즐겨찾기와 보드는 삭제되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De laatste 48 uur wordt bewaard. Favorieten en prikborden worden nooit verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowywane są ostatnie 48 godzin. Ulubione i tablice nigdy nie są usuwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As últimas 48 horas são mantidas. Favoritos e quadros nunca são removidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранятся последние 48 часов. Избранное и доски не удаляются никогда."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De senaste 48 timmarna sparas. Favoriter och anslagstavlor tas aldrig bort."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 48 saat saklanır. Favoriler ve panolar asla silinmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留最近 48 小时。收藏和板永远不会被删除。"
          }
        }
      }
    },
