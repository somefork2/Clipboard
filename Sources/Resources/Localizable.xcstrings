            "value": "จานลอยตรงตำแหน่งเคอร์เซอร์ เลือกรายการแล้วกด ⌘V"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmlecin yanında beliren palet: bir öğe seçin ve ⌘V’ye basın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плаваюча палітра біля курсора: виберіть запис і натисніть ⌘V"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảng nổi ngay tại con trỏ: chọn một mục rồi nhấn ⌘V"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光标处的浮动面板：选一个条目，然后按 ⌘V"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "游標處的浮動面板：選一個項目，然後按 ⌘V"
          }
        }
      }
    },
    "Follows your macOS appearance setting.": {
