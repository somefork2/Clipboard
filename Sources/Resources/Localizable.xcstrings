    "Organise clips into as many boards as you need.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Organise clips into as many boards as you need."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نظّم العناصر في أي عدد تحتاجه من اللوحات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uspořádejte položky na tolik nástěnek, kolik potřebujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiser emner på lige så mange opslagstavler, du har brug for."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordne Einträge auf so vielen Pinnwänden, wie du brauchst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza los elementos en tantos tableros como necesites."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestä kohteet niin monelle taululle kuin tarvitset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Classez vos éléments sur autant de tableaux que nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizza gli elementi su tutte le bacheche che ti servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なだけボードを作って項目を整理できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요한 만큼 보드를 만들어 항목을 정리하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Orden items op zoveel prikborden als je nodig hebt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiser objekter på så mange oppslagstavler du trenger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porządkuj wpisy na tylu tablicach, ile potrzebujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize os itens em quantos quadros precisar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раскладывайте записи по стольким доскам, сколько нужно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordna objekt på så många anslagstavlor du behöver."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğelerinizi ihtiyacınız kadar panoda düzenleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розкладайте записи на стількох дошках, скільки потрібно."
          }
        },
