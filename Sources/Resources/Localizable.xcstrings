    "Never record anything that looks like a password": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحفظ أبدًا ما يبدو كأنه كلمة سر"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No desis mai res que sembli una contrasenya"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikdy neukládat nic, co vypadá jako heslo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem aldrig noget, der ligner en adgangskode"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie speichern, was wie ein Passwort aussieht"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να μην καταγράφεται ποτέ ό,τι μοιάζει με συνθηματικό"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never record anything that looks like a password"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No guardar nunca nada que parezca una contraseña"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä koskaan tallenna mitään salasanalta näyttävää"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jamais enregistrer ce qui ressemble à un mot de passe"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לעולם לא לשמור דבר שנראה כמו סיסמה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्ड जैसी कोई चीज़ कभी न सहेजें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikad ne spremaj ono što izgleda kao lozinka"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Soha ne mentsen semmit, ami jelszónak tűnik"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan pernah menyimpan apa pun yang tampak seperti kata sandi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non registrare mai ciò che sembra una password"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードらしきものは記録しない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호로 보이는 항목은 절대 기록하지 않기"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan sekali-kali simpan apa-apa yang kelihatan seperti kata laluan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aldri lagre noe som ser ut som et passord"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar nooit iets dat op een wachtwoord lijkt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nigdy nie zapisuj niczego, co wygląda jak hasło"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca registrar nada que pareça uma senha"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca guardar nada que pareça uma palavra-passe"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu salva niciodată ceva ce seamănă cu o parolă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не сохранять то, что похоже на пароль"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikdy neukladať nič, čo vyzerá ako heslo"
          }
        },
        "sv": {
          "stringUnit": {
