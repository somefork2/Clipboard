        }
      }
    },
    "This permanently removes the clips and any images stored with them. It cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes the clips and any images stored with them. It cannot be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit werden die Einträge und alle dazu gespeicherten Bilder endgültig entfernt. Das lässt sich nicht widerrufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina de forma permanente los elementos y las imágenes guardadas con ellos. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement les éléments et les images conservées avec eux. C’est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove definitivamente gli elementi e le immagini conservate con essi. Non si può annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目と一緒に保存された画像を完全に削除します。取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목과 함께 저장된 이미지가 영구적으로 삭제됩니다. 되돌릴 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee verwijder je de items en de bewaarde afbeeldingen definitief. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwale usuwa wpisy i zapisane z nimi obrazy. Tego nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto remove permanentemente os itens e as imagens guardadas com eles. Não dá para desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи и сохранённые с ними изображения будут удалены безвозвратно. Отменить это нельзя."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här tar bort objekten och bilderna som sparats med dem permanent. Det går inte att ångra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, öğeleri ve onlarla saklanan görüntüleri kalıcı olarak siler. Geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会永久删除这些条目以及随之保存的图像，且无法撤销。"
          }
        }
      }
    },
