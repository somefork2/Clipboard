    "Keep clips you reuse, or queue several and paste them in order.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep clips you reuse, or queue several and paste them in order."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre Einträge auf, die du wieder brauchst, oder reihe mehrere auf und füge sie der Reihe nach ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda lo que reutilizas, o pon varios elementos en cola y pégalos en orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez ce que vous réutilisez, ou mettez plusieurs éléments en file et collez-les dans l’ordre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni gli elementi che riusi, oppure mettine diversi in coda e incollali in ordine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使う項目を取っておいたり、複数を並べて順にペーストしたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 쓰는 항목을 남겨 두거나, 여러 개를 모아 순서대로 붙여넣으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar items die je opnieuw gebruikt, of zet er een paar op rij en plak ze op volgorde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowuj wpisy, z których korzystasz ponownie, albo ustaw kilka w kolejce i wklej po kolei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde o que você reutiliza, ou enfileire vários e cole na ordem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняйте записи, которыми пользуетесь снова, или соберите несколько и вставьте по очереди."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara objekt du återanvänder, eller ställ flera i kö och klistra in dem i tur och ordning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar kullandığınız öğeleri saklayın ya da birkaçını sıraya dizip sırayla yapıştırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留下常用的条目，或把几项排好队，按顺序粘贴。"
          }
        }
      }
    },
