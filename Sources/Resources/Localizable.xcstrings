    "Pick a look, and decide whether CopyWell makes a sound.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a look, and decide whether CopyWell makes a sound."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Aussehen und entscheide, ob CopyWell einen Ton gibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un aspecto y decide si CopyWell suena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une allure, et décidez si CopyWell émet un son."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un aspetto e decidi se CopyWell deve emettere un suono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見た目を選び、CopyWellが音を鳴らすかどうかを決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모양을 고르고, CopyWell이 소리를 낼지 정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een uiterlijk en bepaal of CopyWell geluid maakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz wygląd i zdecyduj, czy CopyWell ma wydawać dźwięk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma aparência e decida se o CopyWell vai emitir som."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите внешний вид и решите, издавать ли CopyWell звук."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett utseende och bestäm om CopyWell ska låta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir görünüm seçin ve CopyWell’in ses çıkarıp çıkarmayacağına karar verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
