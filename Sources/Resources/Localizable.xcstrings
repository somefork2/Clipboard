    "Warm off-white, easier on the eyes in daylight.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm off-white, easier on the eyes in daylight."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبيض مائل للدفء، أريح للعين في ضوء النهار."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teplá lomená bílá, za denního světla šetrnější k očím."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Varm råhvid, nemmere for øjnene i dagslys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warmes Gebrochenweiß, bei Tageslicht angenehmer für die Augen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanco roto cálido, más agradable a la vista con luz de día."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämmin luonnonvalkoinen, helpompi silmille päivänvalossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc cassé chaud, plus reposant en plein jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bianco sporco caldo, più riposante alla luce del giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温かみのあるオフホワイト。日中に目が楽です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따뜻한 아이보리. 낮에 눈이 덜 피로합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm gebroken wit, bij daglicht prettiger voor de ogen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Varm knekt hvit, lettere for øynene i dagslys."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciepła złamana biel, przyjemniejsza dla oczu przy świetle dziennym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Branco quebrado e quente, mais confortável à luz do dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тёплый молочно-белый, при дневном свете глазам легче."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varm brutet vit, skonsammare för ögonen i dagsljus."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıcak kırık beyaz; gün ışığında göze daha kolay gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Теплий молочно-білий, при денному світлі очам легше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温暖的米白色，白天看更护眼。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫暖的米白色，白天看更護眼。"
          }
        }
      }
    },
