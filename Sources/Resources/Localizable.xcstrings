    "Clips and their stored images are removed permanently.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips and their stored images are removed permanently."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحذف العناصر والصور المحفوظة معها نهائيًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky i obrázky uložené spolu s nimi budou trvale smazány."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Emnerne og de billeder, der er gemt sammen med dem, slettes permanent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einträge und die dazu gespeicherten Bilder werden endgültig entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos y las imágenes guardadas con ellos se eliminan de forma permanente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohteet ja niiden mukana tallennetut kuvat poistetaan pysyvästi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments et les images conservées avec eux sont supprimés définitivement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi e le immagini conservate con essi vengono rimossi definitivamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目と一緒に保存された画像は完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목과 함께 저장된 이미지가 영구적으로 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Items en de bewaarde afbeeldingen worden definitief verwijderd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Objektene og bildene som er lagret sammen med dem, slettes for godt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisy i zapisane z nimi obrazy zostaną usunięte trwale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens e as imagens guardadas com eles são removidos permanentemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи и сохранённые с ними изображения удаляются безвозвратно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekten och de bilder som sparats med dem tas bort permanent."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğeler ve onlarla saklanan görüntüler kalıcı olarak silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи та збережені з ними зображення вилучаються назавжди."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条目以及随之保存的图像将被永久删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "項目以及隨之儲存的影像會被永久刪除。"
          }
        }
      }
    },
    "Clips older than a day are removed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
