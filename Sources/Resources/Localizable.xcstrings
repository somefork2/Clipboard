    "Clips and their stored images are removed permanently.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips and their stored images are removed permanently."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einträge und die dazu gespeicherten Bilder werden endgültig entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos y las imágenes guardadas con ellos se eliminan de forma permanente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments et les images conservées avec eux sont supprimés définitivement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi e le immagini conservate con essi vengono rimossi definitivamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目と一緒に保存された画像は完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목과 함께 저장된 이미지가 영구적으로 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Items en de bewaarde afbeeldingen worden definitief verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisy i zapisane z nimi obrazy zostaną usunięte trwale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens e as imagens guardadas com eles são removidos permanentemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи и сохранённые с ними изображения удаляются безвозвратно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekten och de bilder som sparats med dem tas bort permanent."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğeler ve onlarla saklanan görüntüler kalıcı olarak silinir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条目以及随之保存的图像将被永久删除。"
          }
        }
      }
    },
