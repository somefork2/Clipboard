    "The saved history could not be opened. This session is being kept in memory only.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved history could not be opened. This session is being kept in memory only."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح السجل المحفوظ. تُحفظ هذه الجلسة في الذاكرة فقط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloženou historii se nepodařilo otevřít. Toto sezení je uchováno pouze v paměti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den arkiverede historik kunne ikke åbnes. Denne omgang gemmes kun i hukommelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gesicherte Verlauf konnte nicht geöffnet werden. Diese Sitzung wird nur im Arbeitsspeicher gehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir el historial guardado. Esta sesión se mantiene solo en memoria."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettua historiaa ei voitu avata. Tämä istunto säilytetään vain muistissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique enregistré n’a pas pu être ouvert. Cette session est conservée en mémoire seulement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile aprire la cronologia salvata. Questa sessione resta solo in memoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された履歴を開けませんでした。このセッションはメモリ上にのみ保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 기록을 열 수 없습니다. 이번 사용 기록은 메모리에만 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bewaarde geschiedenis kon niet worden geopend. Deze sessie wordt alleen in het geheugen bewaard."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Den arkiverte historikken kunne ikke åpnes. Denne økten beholdes bare i minnet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć zapisanej historii. Ta sesja jest przechowywana tylko w pamięci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o histórico salvo. Esta sessão está sendo mantida só na memória."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть сохранённую историю. Этот сеанс хранится только в памяти."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den sparade historiken kunde inte öppnas. Den här omgången hålls bara i minnet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı geçmiş açılamadı. Bu oturum yalnızca bellekte tutuluyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити збережену історію. Цей сеанс зберігається лише в пам’яті."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开已存储的历史记录。本次使用仅保存在内存中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法打開已儲存的記錄。本次使用僅保存在記憶體中。"
          }
        }
      }
    },
    "The stored file for this clip could not be read.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stored file for this clip could not be read."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة الملف المحفوظ لهذا العنصر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor uložený pro tuto položku se nepodařilo načíst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkivet, der er gemt til dette emne, kunne ikke læses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherte Datei dieses Eintrags konnte nicht gelesen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer el archivo guardado de este elemento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tälle kohteelle tallennettua tiedostoa ei voitu lukea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier conservé pour cet élément n’a pas pu être lu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere il file conservato per questo elemento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目のために保存されたファイルを読み込めませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목을 위해 저장된 파일을 읽을 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bewaarde bestand voor dit item kon niet worden gelezen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen som er lagret for dette objektet, kunne ikke leses."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać pliku zapisanego dla tego wpisu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o arquivo guardado para este item."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать файл, сохранённый для этой записи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen som sparats för det här objektet kunde inte läsas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğe için saklanan dosya okunamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати файл, збережений для цього запису."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此条目所存储的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取此項目所儲存的檔案。"
          }
        }
      }
    },
